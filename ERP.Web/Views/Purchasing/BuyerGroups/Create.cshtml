@model ERP.Web.ViewModels.Purchasing.PurchasingBuyerGroupEditViewModel

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Create Buyer Group"]</h1>

        <form asp-action="CreateBuyerGroup" asp-controller="Purchasing" method="post" novalidate>
            @Html.AntiForgeryToken()
            <partial name="~/Views/Purchasing/BuyerGroups/_Form.cshtml" model="Model" />

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a asp-action="BuyerGroups" asp-controller="Purchasing" class="btn btn-outline-secondary">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
