@model ERP.Web.ViewModels.Purchasing.PurchasingBuyerGroupEditViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-4">
        <label asp-for="Code" class="form-label">@T["Code"]</label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Name" class="form-label">@T["Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="BuyerEmployeeId" class="form-label">@T["Buyer"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.BuyerEmployeeId),
            Id = Html.IdFor(x => x.BuyerEmployeeId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select Employee"],
            SelectedValue = Model.BuyerEmployeeId > 0
                ? Model.BuyerEmployeeId.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.BuyerOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Name
            }).ToList()
        })
        <span asp-validation-for="BuyerEmployeeId" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ItemCategoryIds" class="form-label">@T["Categories"]</label>
        <select asp-for="ItemCategoryIds" class="form-select" multiple size="7">
            @foreach (var option in Model.ItemCategoryOptions)
            {
                <option value="@option.Id">@option.Label</option>
            }
        </select>
        <div class="form-text">@T["Hold Ctrl or Cmd to select multiple categories"]</div>
        <span asp-validation-for="ItemCategoryIds" class="text-danger small"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Description" class="form-label">@T["Description"]</label>
        <textarea asp-for="Description" rows="3" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsActive),
            Id = Html.IdFor(x => x.IsActive).ToString(),
            Label = T["Active"],
            Checked = Model.IsActive
        })
    </div>
</div>
