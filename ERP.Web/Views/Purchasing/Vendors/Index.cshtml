@model ERP.Web.ViewModels.Purchasing.PurchasingVendorsIndexViewModel
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Vendors"]</h1>

        @{
            var selectedVendorCategory = Model.VendorCategoryIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedBuyerGroup = Model.BuyerGroupIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedApproved = Model.IsApprovedVendorFilter.HasValue ? (Model.IsApprovedVendorFilter.Value ? "true" : "false") : null;
            var selectedIsActive = Model.IsActiveFilter.HasValue ? (Model.IsActiveFilter.Value ? "true" : "false") : null;

            string BuildApprovedBadge(bool isApproved)
            {
                return isApproved
                    ? $"<span class=\"badge text-bg-success\">{T["Approved"]}</span>"
                    : $"<span class=\"badge text-bg-warning text-dark\">{T["Pending"]}</span>";
            }

            string BuildStatusBadge(bool isActive)
            {
                return isActive
                    ? $"<span class=\"badge text-bg-success\">{T["Active"]}</span>"
                    : $"<span class=\"badge text-bg-secondary\">{T["Inactive"]}</span>";
            }

            var vendorCategoryOptions = Model.VendorCategoryOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var buyerGroupOptions = Model.BuyerGroupOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var yesNoOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Yes"] },
                new() { Value = "false", Label = T["No"] }
            };

            var statusOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Active"] },
                new() { Value = "false", Label = T["Inactive"] }
            };

            var rows = new List<PagedGridRowViewModel>();
            foreach (var item in Model.Items.Items)
            {
                var paymentTermsHtml = await Component.InvokeAsync("TextNumber", new { value = (decimal)item.PaymentTermsDays, decimals = 0, cssClass = "sinara-text-number-theme" });
                var performanceHtml = item.PerformanceScore.HasValue
                    ? await Component.InvokeAsync("TextNumber", new { value = item.PerformanceScore.Value, decimals = 2, cssClass = "sinara-text-number-theme" })
                    : await Component.InvokeAsync("TextNumber", new { text = "-", cssClass = "sinara-text-number-null" });

                rows.Add(new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = item.Code },
                        new PagedGridCellViewModel { Text = item.Name },
                        new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.VendorCategoryName) ? "-" : item.VendorCategoryName },
                        new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.BuyerGroupName) ? "-" : item.BuyerGroupName },
                        new PagedGridCellViewModel { Html = paymentTermsHtml, CellClass = "text-end" },
                        new PagedGridCellViewModel { Html = performanceHtml, CellClass = "text-end" },
                        new PagedGridCellViewModel { Html = new HtmlString(BuildApprovedBadge(item.IsApprovedVendor)) },
                        new PagedGridCellViewModel { Html = new HtmlString(BuildStatusBadge(item.IsActive)) }
                    ],
                    Actions = new PagedGridRowActionViewModel
                    {
                        DetailUrl = Url.Action("VendorDetail", "Purchasing", new { id = item.Id }),
                        ApproveUrl = item.IsApprovedVendor ? null : Url.Action("ApproveVendor", "Purchasing", new { id = item.Id }),
                        RejectUrl = item.IsApprovedVendor ? Url.Action("RejectVendor", "Purchasing", new { id = item.Id }) : null,
                        ApproveConfirmMessage = T["Approve this data?"],
                        RejectConfirmMessage = T["Reject this data?"]
                    }
                });
            }

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "code",
                        Title = T["Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "code",
                            Value = Model.CodeFilter,
                            Placeholder = T["Filter code"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "name",
                        Title = T["Name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "name",
                            Value = Model.NameFilter,
                            Placeholder = T["Filter name"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "vendorcategoryname",
                        Title = T["Vendor Category"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "vendorCategoryId",
                            Value = selectedVendorCategory,
                            EmptyOptionLabel = T["All Category"],
                            Options = vendorCategoryOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "buyergroupname",
                        Title = T["Buyer Group"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "buyerGroupId",
                            Value = selectedBuyerGroup,
                            EmptyOptionLabel = T["All"],
                            Options = buyerGroupOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "paymenttermsdays",
                        Title = T["Payment Terms (Days)"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "paymentTermsFrom",
                            QueryKeyTo = "paymentTermsTo",
                            Value = Model.PaymentTermsFromFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.PaymentTermsToFilter?.ToString(CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "performancescore",
                        Title = T["Performance Score"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "performanceScoreFrom",
                            QueryKeyTo = "performanceScoreTo",
                            Value = Model.PerformanceScoreFromFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.PerformanceScoreToFilter?.ToString(CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isapprovedvendor",
                        Title = T["Approved"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isApprovedVendor",
                            Value = selectedApproved,
                            EmptyOptionLabel = T["All"],
                            Options = yesNoOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isactive",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isActive",
                            Value = selectedIsActive,
                            EmptyOptionLabel = T["All Status"],
                            Options = statusOptions
                        }
                    }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Vendors"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    DetailButtonText = T["Detail"],
                    ApproveButtonText = T["Approve"],
                    RejectButtonText = T["Reject"],
                    ApproveConfirmMessage = T["Approve this data?"],
                    RejectConfirmMessage = T["Reject this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
