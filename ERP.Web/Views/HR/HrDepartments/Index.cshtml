@model ERP.Web.ViewModels.HR.HrDepartmentsIndexViewModel
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Departments"]</h1>

        @{
            var selectedManagerId = Model.ManagerIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedParentId = Model.ParentDepartmentIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedIsActive = Model.IsActiveFilter.HasValue
                ? (Model.IsActiveFilter.Value ? "true" : "false")
                : null;

            var managerOptions = Model.Managers
                .OrderBy(x => x.Name)
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Name
                })
                .ToList();

            var parentOptions = Model.DepartmentOptions
                .OrderBy(x => x.Name)
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = $"{x.Code} - {x.Name}"
                })
                .ToList();

            var statusOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Active"] },
                new() { Value = "false", Label = T["Inactive"] }
            };

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "code",
                        Title = T["Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "code",
                            Value = Model.CodeFilter,
                            Placeholder = T["Filter code"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "name",
                        Title = T["Name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "name",
                            Value = Model.NameFilter,
                            Placeholder = T["Filter name"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "managerName",
                        Title = T["Manager"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "managerId",
                            Value = selectedManagerId,
                            EmptyOptionLabel = T["All Manager"],
                            Options = managerOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "parentDepartmentName",
                        Title = T["Parent Department"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "parentDepartmentId",
                            Value = selectedParentId,
                            EmptyOptionLabel = T["All Parent"],
                            Options = parentOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isActive",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isActive",
                            Value = selectedIsActive,
                            EmptyOptionLabel = T["All Status"],
                            Options = statusOptions
                        }
                    }
                ],
                Rows = Model.Departments.Items.Select(item => new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = item.Code },
                        new PagedGridCellViewModel { Text = item.Name },
                        new PagedGridCellViewModel { Text = item.ManagerName ?? "-" },
                        new PagedGridCellViewModel { Text = item.ParentDepartmentName ?? "-" },
                        new PagedGridCellViewModel
                        {
                            Html = new HtmlString(item.IsActive
                                ? "<span class=\"badge text-bg-success\">Active</span>"
                                : "<span class=\"badge text-bg-secondary\">Inactive</span>")
                        }
                    ],
                    Actions = new PagedGridRowActionViewModel
                    {
                        DetailUrl = Model.CanView ? Url.Action("Details", "HrDepartments", new { id = item.Id }) : null,
                        EditUrl = Model.CanEdit ? Url.Action("Edit", "HrDepartments", new { id = item.Id }) : null,
                        DeleteUrl = Model.CanDelete ? Url.Action("Delete", "HrDepartments", new { id = item.Id }) : null,
                        DeleteConfirmMessage = T["Delete this department?"]
                    }
                }).ToList(),
                EmptyMessage = T["msg.no_data"],
                Page = Model.Departments.Page,
                TotalPages = Model.Departments.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = $"{T["common.search"]} departments",
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Model.CanCreate ? Url.Action("Create", "HrDepartments") : null,
                    AddButtonText = T["common.add_new"],
                    DetailButtonText = T["Detail"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this department?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
