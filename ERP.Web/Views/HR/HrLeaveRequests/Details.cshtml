@model ERP.Application.DTOs.HR.LeaveRequestDto
@using ERP.Domain.Enums

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-3">
            <h1 class="h5 mb-0">Leave Request Details</h1>
            <span class="badge @(Model.Status switch { LeaveStatus.Approved => "text-bg-success", LeaveStatus.Rejected => "text-bg-danger", _ => "text-bg-warning" })">
                @Model.Status
            </span>
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3">Employee</dt>
            <dd class="col-sm-9">@Model.EmployeeCode - @Model.EmployeeName</dd>

            <dt class="col-sm-3">Leave Type</dt>
            <dd class="col-sm-9">@Model.LeaveTypeCode - @Model.LeaveTypeName</dd>

            <dt class="col-sm-3">Period</dt>
            <dd class="col-sm-9">@Model.StartDate.ToString("yyyy-MM-dd") s/d @Model.EndDate.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-3">Total Days</dt>
            <dd class="col-sm-9">@Model.TotalDays</dd>

            <dt class="col-sm-3">Reason</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Reason) ? "-" : Model.Reason)</dd>

            <dt class="col-sm-3">Requested At</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>

            <dt class="col-sm-3">Approved By</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.ApprovedByName) ? "-" : Model.ApprovedByName)</dd>

            <dt class="col-sm-3">Approved At</dt>
            <dd class="col-sm-9">@(Model.ApprovedAt.HasValue ? Model.ApprovedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "-")</dd>
        </dl>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>

            @if (Model.Status == LeaveStatus.Pending)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">@T["common.edit"]</a>

                <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-success" onclick="return confirm('Approve request ini?')">
                        <i class="bi bi-check2-circle me-1" aria-hidden="true"></i>
                        <span>Approve</span>
                    </button>
                </form>

                <form asp-action="Reject" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Reject request ini?')">
                        <i class="bi bi-x-circle me-1" aria-hidden="true"></i>
                        <span>Reject</span>
                    </button>
                </form>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Delete leave request ini?')">
                        <i class="bi bi-trash me-1" aria-hidden="true"></i>
                        <span>@T["common.delete"]</span>
                    </button>
                </form>
            }
        </div>
    </div>
</div>
