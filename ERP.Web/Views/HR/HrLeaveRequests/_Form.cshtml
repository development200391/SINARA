@model ERP.Web.ViewModels.HR.HrLeaveRequestEditViewModel
@using ERP.Web.ViewModels.Shared
@using ERP.Web.ViewModels.Document
@using System.Globalization

@{
    var isEdit = Model.Id > 0;
    var config = Model.AttachmentConfig;
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@(isEdit ? T["Edit Leave Request"] : T["Create Leave Request"])</h1>

        <form method="post" enctype="multipart/form-data" class="row g-3">
            @Html.AntiForgeryToken()
            @if (isEdit)
            {
                <input asp-for="Id" type="hidden" />
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-md-6">
                <label asp-for="EmployeeId" class="form-label">@T["Employee"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.EmployeeId),
                    Id = Html.IdFor(x => x.EmployeeId).ToString(),
                    CssClass = "form-select",
                    SearchPlaceholder = T["Search employee..."],
                    EmptyOptionLabel = T["Select Employee"],
                    SelectedValue = Model.EmployeeId > 0
                        ? Model.EmployeeId.ToString(CultureInfo.InvariantCulture)
                        : null,
                    IsRequired = true,
                    Options = Model.Employees.Select(employee => new SearchableSelectOptionViewModel
                    {
                        Value = employee.Id.ToString(CultureInfo.InvariantCulture),
                        Label = employee.Name
                    }).ToList()
                })
                <span asp-validation-for="EmployeeId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="LeaveTypeId" class="form-label">@T["Leave Type"]</label>
                <select asp-for="LeaveTypeId" class="form-select">
                    <option value="">@T["Select Leave Type"]</option>
                    @foreach (var leaveType in Model.LeaveTypes)
                    {
                        <option value="@leaveType.Id">@leaveType.Name</option>
                    }
                </select>
                <span asp-validation-for="LeaveTypeId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                @await Component.InvokeAsync("FormDate", new FormDateViewModel
                {
                    Name = nameof(Model.StartDate),
                    Id = Html.IdFor(x => x.StartDate).ToString(),
                    Label = T["Start Date"],
                    Value = Model.StartDate,
                    IsRequired = true
                })
            </div>

            <div class="col-md-6">
                @await Component.InvokeAsync("FormDate", new FormDateViewModel
                {
                    Name = nameof(Model.EndDate),
                    Id = Html.IdFor(x => x.EndDate).ToString(),
                    Label = T["End Date"],
                    Value = Model.EndDate,
                    IsRequired = true
                })
            </div>

            <div class="col-12">
                <label asp-for="Reason" class="form-label">@T["Reason"]</label>
                <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
            </div>

            @if (config is not null && config.Details.Count > 0)
            {
                @await Component.InvokeAsync("GeneralDocumentUpload", new GeneralDocumentUploadViewModel
                {
                    FileFieldName = nameof(Model.AttachmentFiles),
                    NoteFieldName = nameof(Model.AttachmentNote),
                    NoteValue = Model.AttachmentNote,
                    HasExistingDocuments = Model.Documents.Count > 0,
                    Slots = config.Details
                        .Where(d => d.IsActive)
                        .Select(d => new GeneralDocumentUploadSlotViewModel
                        {
                            Name = d.Name,
                            IsRequired = d.IsRequired,
                            MaxFileSizeBytes = d.MaxFileSizeBytes ?? 5 * 1024 * 1024,
                            AllowedExtensions = (d.AllowedExtensions ?? ".pdf,.jpg,.jpeg,.png,.docx").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        })
                        .ToList()
                })
            }

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>

@if (isEdit)
{
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-body">
            <h2 class="h6 mb-3">@T["Uploaded Attachments"]</h2>
            @await Component.InvokeAsync("GeneralDocumentList", new GeneralDocumentListViewModel
            {
                Documents = Model.Documents,
                DownloadUrl = id => Url.Action("DownloadDocument", "HrLeaveRequests", new { id })!,
                DeleteUrl = id => Url.Action("DeleteDocument", "HrLeaveRequests", new { leaveRequestId = Model.Id, id })!,
                DeleteConfirmMessage = "Delete this document?"
            })
        </div>
    </div>
}
