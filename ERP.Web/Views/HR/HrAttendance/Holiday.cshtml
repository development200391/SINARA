@model ERP.Web.ViewModels.HR.HrHolidayIndexViewModel
@using ERP.Domain.Enums
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html
@using System.Globalization
@using System.Linq

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Holiday Master"]</h1>

        @{
            var selectedHolidayType = Model.HolidayTypeFilter.HasValue
                ? ((int)Model.HolidayTypeFilter.Value).ToString(CultureInfo.InvariantCulture)
                : null;
            var selectedIsActive = Model.IsActiveFilter.HasValue
                ? (Model.IsActiveFilter.Value ? "true" : "false")
                : null;

            var holidayTypeOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = ((int)HolidayType.National).ToString(CultureInfo.InvariantCulture), Label = T["National"] },
                new() { Value = ((int)HolidayType.Company).ToString(CultureInfo.InvariantCulture), Label = T["Company"] },
                new() { Value = ((int)HolidayType.JointLeave).ToString(CultureInfo.InvariantCulture), Label = T["Joint Leave"] }
            };

            var appliesToOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "all", Label = T["All"] },
                new() { Value = "division_id", Label = T["Division"] },
                new() { Value = "location_id", Label = T["Location"] }
            };

            var statusOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Active"] },
                new() { Value = "false", Label = T["Inactive"] }
            };

            var selectedYear = Model.YearFromFilter.HasValue
                && Model.YearToFilter.HasValue
                && Model.YearFromFilter.Value == Model.YearToFilter.Value
                ? Model.YearFromFilter.Value
                : (short?)null;
            var selectedYearText = selectedYear?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;

            var currentYear = (short)DateTime.Today.Year;
            var yearCandidates = new HashSet<short>(Model.Holidays.Items.Select(x => x.Year))
            {
                currentYear,
                (short)(currentYear - 1),
                (short)(currentYear + 1)
            };

            if (selectedYear.HasValue)
            {
                yearCandidates.Add(selectedYear.Value);
            }

            var yearOptions = yearCandidates
                .Where(x => x >= 2000 && x <= 9999)
                .OrderByDescending(x => x)
                .ToList();

            var totalHolidayCount = Model.Holidays.TotalCount;
            var nationalHolidayCount = Model.Holidays.Items.Count(x => x.HolidayType == HolidayType.National);
            var companyHolidayCount = Model.Holidays.Items.Count(x => x.HolidayType is HolidayType.Company or HolidayType.JointLeave);
            var periodText = selectedYear.HasValue
                ? $"Tahun {selectedYear.Value.ToString(CultureInfo.InvariantCulture)}"
                : "Semua Tahun";

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "name",
                        Title = T["Name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "name",
                            Value = Model.NameFilter,
                            Placeholder = T["Filter name"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "holidayDate",
                        Title = T["Holiday Date"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.DateRange,
                            QueryKey = "holidayDateFrom",
                            QueryKeyTo = "holidayDateTo",
                            Value = Model.HolidayDateFromFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            ValueTo = Model.HolidayDateToFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "holidayType",
                        Title = T["Holiday Type"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "holidayType",
                            Value = selectedHolidayType,
                            EmptyOptionLabel = T["All Type"],
                            Options = holidayTypeOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "description",
                        Title = T["Description"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "description",
                            Value = Model.DescriptionFilter,
                            Placeholder = T["Filter description"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "appliesTo",
                        Title = T["Applies To"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "appliesTo",
                            Value = Model.AppliesToFilter,
                            EmptyOptionLabel = T["All Scope"],
                            Options = appliesToOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "year",
                        Title = T["Year"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "yearFrom",
                            QueryKeyTo = "yearTo",
                            Value = Model.YearFromFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.YearToFilter?.ToString(CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isActive",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isActive",
                            Value = selectedIsActive,
                            EmptyOptionLabel = T["All Status"],
                            Options = statusOptions
                        }
                    }
                ],
                Rows = Model.Holidays.Items.Select(item => new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = item.Name },
                        new PagedGridCellViewModel { Text = item.HolidayDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) },
                        new PagedGridCellViewModel
                        {
                            Html = new HtmlString(item.HolidayType switch
                            {
                                HolidayType.National => "<span class=\"badge text-bg-primary\">National</span>",
                                HolidayType.Company => "<span class=\"badge text-bg-info\">Company</span>",
                                HolidayType.JointLeave => "<span class=\"badge text-bg-warning\">Joint Leave</span>",
                                _ => "<span class=\"badge text-bg-secondary\">Unknown</span>"
                            })
                        },
                        new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description },
                        new PagedGridCellViewModel { Text = item.AppliesTo },
                        new PagedGridCellViewModel { Text = item.Year.ToString(CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel
                        {
                            Html = new HtmlString(item.IsActive
                                ? "<span class=\"badge text-bg-success\">Active</span>"
                                : "<span class=\"badge text-bg-secondary\">Inactive</span>")
                        }
                    ],
                    Actions = new PagedGridRowActionViewModel
                    {
                        DetailUrl = Url.Action("HolidayDetails", "HrAttendance", new { id = item.Id }),
                        EditUrl = Url.Action("HolidayEdit", "HrAttendance", new { id = item.Id }),
                        DeleteUrl = Url.Action("HolidayDelete", "HrAttendance", new { id = item.Id }),
                        DeleteConfirmMessage = T["Delete this holiday?"]
                    }
                }).ToList(),
                EmptyMessage = T["msg.no_data"],
                Page = Model.Holidays.Page,
                TotalPages = Model.Holidays.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = false,
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("HolidayCreate", "HrAttendance"),
                    AddButtonText = T["common.add_new"],
                    DetailButtonText = T["Detail"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this holiday?"]
                }
            };
        }

        <div class="sinara-holiday-overview mb-3">
            <article class="sinara-holiday-stat-card">
                <div class="sinara-holiday-stat-title">@T["Total Holiday"]</div>
                <div class="sinara-holiday-stat-value">@totalHolidayCount</div>
                <div class="sinara-holiday-stat-note">@periodText</div>
            </article>
            <article class="sinara-holiday-stat-card">
                <div class="sinara-holiday-stat-title">@T["National Holiday"]</div>
                <div class="sinara-holiday-stat-value">@nationalHolidayCount</div>
                <div class="sinara-holiday-stat-note">@T["Government-declared holiday"]</div>
            </article>
            <article class="sinara-holiday-stat-card">
                <div class="sinara-holiday-stat-title">@T["Company Holiday"]</div>
                <div class="sinara-holiday-stat-value">@companyHolidayCount</div>
                <div class="sinara-holiday-stat-note">@T["Joint leave / special holiday"]</div>
            </article>
        </div>

        <form method="get"
              class="sinara-holiday-quick-filter mb-3"
              onsubmit="document.getElementById('holidayYearTo').value = document.getElementById('holidayYearFrom').value;">
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <input type="hidden" name="sortBy" value="@Model.SortBy" />
            <input type="hidden" name="sortDirection" value="@Model.SortDirection" />

            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <input type="hidden" name="search" value="@Model.Search" />
            }

            @if (Model.HolidayDateFromFilter.HasValue)
            {
                <input type="hidden" name="holidayDateFrom" value="@Model.HolidayDateFromFilter.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
            }

            @if (Model.HolidayDateToFilter.HasValue)
            {
                <input type="hidden" name="holidayDateTo" value="@Model.HolidayDateToFilter.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
            }

            @if (!string.IsNullOrWhiteSpace(Model.DescriptionFilter))
            {
                <input type="hidden" name="description" value="@Model.DescriptionFilter" />
            }

            @if (Model.IsActiveFilter.HasValue)
            {
                <input type="hidden" name="isActive" value="@(Model.IsActiveFilter.Value ? "true" : "false")" />
            }

            @if (!string.IsNullOrWhiteSpace(Model.AppliesToFilter))
            {
                <input type="hidden" name="appliesTo" value="@Model.AppliesToFilter" />
            }

            <label class="visually-hidden" for="holidayYearFrom">@T["Year"]</label>
            <select id="holidayYearFrom"
                    class="form-select sinara-holiday-filter-control"
                    name="yearFrom"
                    onchange="this.form.requestSubmit();">
                <option value="">@T["Semua tahun"]</option>
                @foreach (var yearOption in yearOptions)
                {
                    <option value="@yearOption" selected="@(yearOption.ToString(CultureInfo.InvariantCulture) == selectedYearText)">@yearOption</option>
                }
            </select>
            <input id="holidayYearTo" type="hidden" name="yearTo" value="@selectedYearText" />

            <label class="visually-hidden" for="holidayTypeFilter">@T["Holiday Type"]</label>
            <select id="holidayTypeFilter"
                    class="form-select sinara-holiday-filter-control"
                    name="holidayType"
                    onchange="this.form.requestSubmit();">
                <option value="">@T["Semua tipe"]</option>
                @foreach (var option in holidayTypeOptions)
                {
                    <option value="@option.Value" selected="@string.Equals(option.Value, selectedHolidayType, StringComparison.OrdinalIgnoreCase)">@option.Label</option>
                }
            </select>

            <label class="visually-hidden" for="holidayNameFilter">@T["Nama Holiday"]</label>
            <input id="holidayNameFilter"
                   type="text"
                   class="form-control sinara-holiday-filter-control"
                   name="name"
                   value="@Model.NameFilter"
                   placeholder="@T["Search holiday name..."]" />
        </form>

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
