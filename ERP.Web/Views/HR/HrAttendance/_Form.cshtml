@model ERP.Web.ViewModels.HR.HrAttendanceEditViewModel
@using ERP.Domain.Enums
@using ERP.Web.ViewModels.Shared
@using System.Globalization

@{
    var isEdit = Model.Id > 0;
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@(isEdit ? T["Edit Attendance"] : T["Create Attendance"])</h1>

        <form method="post" class="row g-3">
            @Html.AntiForgeryToken()
            @if (isEdit)
            {
                <input asp-for="Id" type="hidden" />
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-md-6">
                <label asp-for="EmployeeId" class="form-label">@T["Employee"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.EmployeeId),
                    Id = Html.IdFor(x => x.EmployeeId).ToString(),
                    CssClass = "form-select",
                    SearchPlaceholder = T["Search employee..."],
                    EmptyOptionLabel = T["Select Employee"],
                    SelectedValue = Model.EmployeeId > 0
                        ? Model.EmployeeId.ToString(CultureInfo.InvariantCulture)
                        : null,
                    IsRequired = true,
                    Options = Model.Employees.Select(employee => new SearchableSelectOptionViewModel
                    {
                        Value = employee.Id.ToString(CultureInfo.InvariantCulture),
                        Label = employee.Name
                    }).ToList()
                })
                <span asp-validation-for="EmployeeId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                @await Component.InvokeAsync("FormDate", new FormDateViewModel
                {
                    Name = nameof(Model.Date),
                    Id = Html.IdFor(x => x.Date).ToString(),
                    Label = T["Date"],
                    Value = Model.Date,
                    IsRequired = true
                })
            </div>

            <div class="col-md-6">
                <label asp-for="CheckInLocal" class="form-label"></label>
                <input asp-for="CheckInLocal" class="form-control" type="datetime-local" />
                <span asp-validation-for="CheckInLocal" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CheckOutLocal" class="form-label"></label>
                <input asp-for="CheckOutLocal" class="form-control" type="datetime-local" />
                <span asp-validation-for="CheckOutLocal" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Status" class="form-label">@T["Status"]</label>
                <select asp-for="Status" class="form-select">
                    @foreach (var status in Enum.GetValues<AttendanceStatus>())
                    {
                        <option value="@status" selected="@(Model.Status == status)">@status</option>
                    }
                </select>
            </div>

            <div class="col-md-8">
                <label asp-for="Notes" class="form-label">@T["Notes"]</label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>
