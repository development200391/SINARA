@model ERP.Web.ViewModels.HR.HrLeaveTypesIndexViewModel
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Leave Types"]</h1>

        @{
            var selectedIsCarryOver = Model.IsCarryOverFilter.HasValue
                ? (Model.IsCarryOverFilter.Value ? "true" : "false")
                : null;
            var selectedIsActive = Model.IsActiveFilter.HasValue
                ? (Model.IsActiveFilter.Value ? "true" : "false")
                : null;

            var yesNoOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Yes"] },
                new() { Value = "false", Label = T["No"] }
            };

            var statusOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Active"] },
                new() { Value = "false", Label = T["Inactive"] }
            };

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "name",
                        Title = T["Name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "name",
                            Value = Model.NameFilter,
                            Placeholder = T["Filter name"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "code",
                        Title = T["Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "code",
                            Value = Model.CodeFilter,
                            Placeholder = T["Filter code"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "maxDays",
                        Title = T["Max Days/Year"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "maxDaysPerYearFrom",
                            QueryKeyTo = "maxDaysPerYearTo",
                            Value = Model.MaxDaysPerYearFromFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.MaxDaysPerYearToFilter?.ToString(CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isCarryOver",
                        Title = T["Carry Over"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isCarryOver",
                            Value = selectedIsCarryOver,
                            EmptyOptionLabel = T["All"],
                            Options = yesNoOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isActive",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isActive",
                            Value = selectedIsActive,
                            EmptyOptionLabel = T["All"],
                            Options = statusOptions
                        }
                    }
                ],
                Rows = Model.LeaveTypes.Items.Select(item => new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = item.Name },
                        new PagedGridCellViewModel { Text = item.Code },
                        new PagedGridCellViewModel { Text = item.MaxDaysPerYear.ToString(CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel
                        {
                            Html = new HtmlString(item.IsCarryOver
                                ? "<span class=\"badge text-bg-info\">Yes</span>"
                                : "<span class=\"badge text-bg-secondary\">No</span>")
                        },
                        new PagedGridCellViewModel
                        {
                            Html = new HtmlString(item.IsActive
                                ? "<span class=\"badge text-bg-success\">Active</span>"
                                : "<span class=\"badge text-bg-secondary\">Inactive</span>")
                        }
                    ],
                    Actions = new PagedGridRowActionViewModel
                    {
                        EditUrl = Url.Action("Edit", "HrLeaveTypes", new { id = item.Id }),
                        DeleteUrl = Url.Action("Delete", "HrLeaveTypes", new { id = item.Id }),
                        DeleteConfirmMessage = T["Delete leave type ini?"]
                    }
                }).ToList(),
                EmptyMessage = T["msg.no_data"],
                Page = Model.LeaveTypes.Page,
                TotalPages = Model.LeaveTypes.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search leave types"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("Create", "HrLeaveTypes"),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete leave type ini?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
