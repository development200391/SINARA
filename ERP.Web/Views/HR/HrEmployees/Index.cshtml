@model ERP.Web.ViewModels.HR.HrEmployeesIndexViewModel
@using ERP.Domain.Enums
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Employees"]</h1>

        @{
            var selectedDepartmentId = Model.DepartmentIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedPositionId = Model.PositionIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedEmploymentStatus = Model.EmploymentStatusFilter.HasValue
                ? ((int)Model.EmploymentStatusFilter.Value).ToString(CultureInfo.InvariantCulture)
                : null;

            var departmentFilterOptions = Model.Departments
                .OrderBy(x => x.Name)
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = $"{x.Code} - {x.Name}"
                })
                .ToList();

            var positionFilterOptions = Model.Positions
                .OrderBy(x => x.DepartmentName)
                .ThenBy(x => x.Level)
                .ThenBy(x => x.Name)
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = $"{x.DepartmentName} - {x.Name} (L{x.Level})"
                })
                .ToList();

            var statusFilterOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = ((int)EmploymentStatus.Active).ToString(CultureInfo.InvariantCulture), Label = T["Active"] },
                new() { Value = ((int)EmploymentStatus.Inactive).ToString(CultureInfo.InvariantCulture), Label = T["Inactive"] },
                new() { Value = ((int)EmploymentStatus.OnLeave).ToString(CultureInfo.InvariantCulture), Label = T["On Leave"] }
            };

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "employeeCode",
                        Title = T["label.employee_code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "employeeCode",
                            Value = Model.EmployeeCodeFilter,
                            Placeholder = T["Filter code"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "fullName",
                        Title = T["label.full_name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "fullName",
                            Value = Model.FullNameFilter,
                            Placeholder = T["Filter name"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "email",
                        Title = T["Email"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "email",
                            Value = Model.EmailFilter,
                            Placeholder = T["Filter email"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "phone",
                        Title = T["Phone"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "phone",
                            Value = Model.PhoneFilter,
                            Placeholder = T["Filter phone"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "departmentName",
                        Title = T["label.department"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "departmentId",
                            Value = selectedDepartmentId,
                            EmptyOptionLabel = T["All Department"],
                            Options = departmentFilterOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "positionName",
                        Title = T["label.position"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "positionId",
                            Value = selectedPositionId,
                            EmptyOptionLabel = T["All Position"],
                            Options = positionFilterOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "hireDate",
                        Title = T["label.hire_date"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.DateRange,
                            QueryKey = "hireDateFrom",
                            QueryKeyTo = "hireDateTo",
                            Value = Model.HireDateFrom?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            ValueTo = Model.HireDateTo?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "terminationDate",
                        Title = T["Termination"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.DateRange,
                            QueryKey = "terminationDateFrom",
                            QueryKeyTo = "terminationDateTo",
                            Value = Model.TerminationDateFrom?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            ValueTo = Model.TerminationDateTo?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "employmentStatus",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "employmentStatus",
                            Value = selectedEmploymentStatus,
                            EmptyOptionLabel = T["All Status"],
                            Options = statusFilterOptions
                        }
                    }
                ],
                Rows = Model.Employees.Items.Select(employee => new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = employee.EmployeeCode },
                        new PagedGridCellViewModel { Text = employee.FullName },
                        new PagedGridCellViewModel { Text = employee.Email ?? "-" },
                        new PagedGridCellViewModel { Text = employee.Phone ?? "-" },
                        new PagedGridCellViewModel { Text = employee.DepartmentName },
                        new PagedGridCellViewModel { Text = employee.PositionName },
                        new PagedGridCellViewModel { Text = employee.HireDate.ToString("yyyy-MM-dd") },
                        new PagedGridCellViewModel { Text = employee.TerminationDate?.ToString("yyyy-MM-dd") ?? "-" },
                        new PagedGridCellViewModel
                        {
                            Html = new HtmlString(employee.EmploymentStatus switch
                            {
                                EmploymentStatus.Active => "<span class=\"badge text-bg-success\">Active</span>",
                                EmploymentStatus.Inactive => "<span class=\"badge text-bg-secondary\">Inactive</span>",
                                EmploymentStatus.OnLeave => "<span class=\"badge text-bg-warning\">On Leave</span>",
                                _ => "<span class=\"badge text-bg-secondary\">Unknown</span>"
                            })
                        }
                    ],
                    Actions = new PagedGridRowActionViewModel
                    {
                        DetailUrl = Url.Action("Details", "HrEmployees", new { id = employee.Id }),
                        EditUrl = Url.Action("Edit", "HrEmployees", new { id = employee.Id }),
                        DeleteUrl = Url.Action("Delete", "HrEmployees", new { id = employee.Id }),
                        DeleteConfirmMessage = T["Delete this employee?"]
                    }
                }).ToList(),
                EmptyMessage = T["msg.no_data"],
                Page = Model.Employees.Page,
                TotalPages = Model.Employees.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = $"{T["common.search"]} employees",
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("Create", "HrEmployees"),
                    AddButtonText = T["common.add_new"],
                    DetailButtonText = T["Detail"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this employee?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
