@model ERP.Web.ViewModels.HR.HrEmployeeEditViewModel
@using ERP.Domain.Enums
@using ERP.Web.ViewModels.Shared
@using System.Globalization

@{
    var isEdit = Model.Id > 0;
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@(isEdit ? T["Edit Employee"] : T["Create Employee"])</h1>

        <form method="post" enctype="multipart/form-data" class="row g-3">
            @Html.AntiForgeryToken()
            @if (isEdit)
            {
                <input asp-for="Id" type="hidden" />
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-lg-3 col-md-4">
                @await Component.InvokeAsync("EmployeePhoto", Model)
            </div>

            <div class="col-lg-3 col-md-4">
                    @await Component.InvokeAsync("TextInput", new TextInputViewModel
                    {
                        Name = nameof(Model.EmployeeCode),
                        Label = T["label.employee_code"],
                        Value = Model.EmployeeCode,
                        Placeholder = "Auto-generated",
                        IsReadOnly = isEdit,
                        HelpText = T["Generated automatically on save."]
                    })

            </div>

            <div class="col-lg-6 col-md-8">
                @await Component.InvokeAsync("TextInput", new TextInputViewModel
                {
                    Name = nameof(Model.FullName),
                    Id = Html.IdFor(x => x.FullName).ToString(),
                    Label = T["label.full_name"],
                    Value = Model.FullName,
                    IsRequired = true,
                    MaxLength = 200
                })
            </div>

            <div class="col-md-6">
                @await Component.InvokeAsync("FormEmail", new FormEmailViewModel
                {
                    Name = nameof(Model.Email),
                    Id = Html.IdFor(x => x.Email).ToString(),
                    Label = T["Email"],
                    Value = Model.Email
                })
            </div>

            <div class="col-md-6">
                @await Component.InvokeAsync("FormPhone", new FormPhoneViewModel
                {
                    Name = nameof(Model.Phone),
                    Id = Html.IdFor(x => x.Phone).ToString(),
                    Label = T["Phone"],
                    Value = Model.Phone
                })
            </div>

            <div class="col-md-4">
                <label asp-for="DepartmentId" class="form-label">@T["Department"]</label>
                <select asp-for="DepartmentId" class="form-select">
                    <option value="">@T["Select Department"]</option>
                    @foreach (var department in Model.Departments)
                    {
                        <option value="@department.Id" selected="@(Model.DepartmentId == department.Id)">@department.Code - @department.Name</option>
                    }
                </select>
                <span asp-validation-for="DepartmentId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="PositionId" class="form-label">@T["Position"]</label>
                <select asp-for="PositionId" class="form-select">
                    <option value="">@T["Select Position"]</option>
                    @foreach (var position in Model.Positions)
                    {
                        <option value="@position.Id" selected="@(Model.PositionId == position.Id)">@position.DepartmentName - @position.Name (L@position.Level)</option>
                    }
                </select>
                <span asp-validation-for="PositionId" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="EmploymentStatus" class="form-label">@T["Status"]</label>
                <select asp-for="EmploymentStatus" class="form-select">
                    @foreach (var status in Enum.GetValues<EmploymentStatus>())
                    {
                        <option value="@status" selected="@(Model.EmploymentStatus == status)">@status</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                @await Component.InvokeAsync("FormDate", new FormDateViewModel
                {
                    Name = nameof(Model.HireDate),
                    Id = Html.IdFor(x => x.HireDate).ToString(),
                    Label = T["Hire Date"],
                    Value = Model.HireDate,
                    IsRequired = true
                })
            </div>

            <div class="col-md-6">
                @await Component.InvokeAsync("FormDate", new FormDateViewModel
                {
                    Name = nameof(Model.TerminationDate),
                    Id = Html.IdFor(x => x.TerminationDate).ToString(),
                    Label = T["Termination Date"],
                    Value = Model.TerminationDate
                })
            </div>

            <div class="col-md-6">
                <label asp-for="UserId" class="form-label">@T["Linked User"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.UserId),
                    Id = Html.IdFor(x => x.UserId).ToString(),
                    CssClass = "form-select",
                    SearchPlaceholder = T["Search user..."],
                    EmptyOptionLabel = T["No linked user"],
                    SelectedValue = Model.UserId.HasValue
                        ? Model.UserId.Value.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.Users.Select(user => new SearchableSelectOptionViewModel
                    {
                        Value = user.Id.ToString(CultureInfo.InvariantCulture),
                        Label = user.Name
                    }).ToList()
                })
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>
