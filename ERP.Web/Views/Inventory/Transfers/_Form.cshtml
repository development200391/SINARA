@model ERP.Web.ViewModels.Inventory.InventoryTransferEditViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="TransferDate" class="form-label">@T["Transfer Date"]</label>
        <input asp-for="TransferDate" type="date" class="form-control" />
        <span asp-validation-for="TransferDate" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="FromWarehouseId" class="form-label">@T["From Warehouse"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.FromWarehouseId),
            Id = Html.IdFor(x => x.FromWarehouseId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select Warehouse"],
            SelectedValue = Model.FromWarehouseId > 0
                ? Model.FromWarehouseId.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.WarehouseOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="FromWarehouseId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ToWarehouseId" class="form-label">@T["To Warehouse"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.ToWarehouseId),
            Id = Html.IdFor(x => x.ToWarehouseId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select Warehouse"],
            SelectedValue = Model.ToWarehouseId > 0
                ? Model.ToWarehouseId.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.WarehouseOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="ToWarehouseId" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="FromLocationId" class="form-label">@T["From Location"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.FromLocationId),
            Id = Html.IdFor(x => x.FromLocationId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All"],
            SelectedValue = Model.FromLocationId.HasValue
                ? Model.FromLocationId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.FromLocationOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="FromLocationId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ToLocationId" class="form-label">@T["To Location"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.ToLocationId),
            Id = Html.IdFor(x => x.ToLocationId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All"],
            SelectedValue = Model.ToLocationId.HasValue
                ? Model.ToLocationId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.ToLocationOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="ToLocationId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ReferenceNo" class="form-label">@T["Reference No"]</label>
        <input asp-for="ReferenceNo" class="form-control" />
        <span asp-validation-for="ReferenceNo" class="text-danger small"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Description" class="form-label">@T["Description"]</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ItemId" class="form-label">@T["Item"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.ItemId),
            Id = Html.IdFor(x => x.ItemId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select Item"],
            SelectedValue = Model.ItemId > 0
                ? Model.ItemId.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.ItemOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="ItemId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="UomId" class="form-label">@T["UOM"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.UomId),
            Id = Html.IdFor(x => x.UomId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All"],
