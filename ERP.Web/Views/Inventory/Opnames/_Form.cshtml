@model ERP.Web.ViewModels.Inventory.InventoryOpnameEditViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="OpnameDate" class="form-label">@T["Opname Date"]</label>
        <input asp-for="OpnameDate" type="date" class="form-control" />
        <span asp-validation-for="OpnameDate" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="WarehouseId" class="form-label">@T["Warehouse"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.WarehouseId),
            Id = Html.IdFor(x => x.WarehouseId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select Warehouse"],
            SelectedValue = Model.WarehouseId > 0
                ? Model.WarehouseId.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.WarehouseOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="WarehouseId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="LocationId" class="form-label">@T["Location"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.LocationId),
            Id = Html.IdFor(x => x.LocationId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All"],
            SelectedValue = Model.LocationId.HasValue
                ? Model.LocationId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.LocationOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="LocationId" class="text-danger small"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Description" class="form-label">@T["Description"]</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>
