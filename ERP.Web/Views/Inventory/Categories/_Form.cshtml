@model ERP.Web.ViewModels.Inventory.InventoryCategoryEditViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="Code" class="form-label">@T["Code"]</label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>
    <div class="col-md-8">
        <label asp-for="Name" class="form-label">@T["Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ParentCategoryId" class="form-label">@T["Parent"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.ParentCategoryId),
            Id = Html.IdFor(x => x.ParentCategoryId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["No Parent"],
            SelectedValue = Model.ParentCategoryId.HasValue
                ? Model.ParentCategoryId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.ParentCategories.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="ParentCategoryId" class="text-danger small"></span>
    </div>
    <div class="col-md-12">
        <label asp-for="Description" class="form-label">@T["Description"]</label>
        <textarea asp-for="Description" rows="3" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsActive),
            Id = Html.IdFor(x => x.IsActive).ToString(),
            Label = T["Active"],
            Checked = Model.IsActive
        })
    </div>
</div>
