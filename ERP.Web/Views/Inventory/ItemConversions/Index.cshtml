@model ERP.Web.ViewModels.Inventory.InventoryItemConversionsIndexViewModel
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Item Conversions"]</h1>

        @{
            var selectedItem = Model.ItemIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedFromUom = Model.FromUomIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedToUom = Model.ToUomIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedIsActive = Model.IsActiveFilter.HasValue ? (Model.IsActiveFilter.Value ? "true" : "false") : null;

            string BuildStatusBadge(bool isActive)
            {
                return isActive
                    ? $"<span class=\"badge text-bg-success\">{T["Active"]}</span>"
                    : $"<span class=\"badge text-bg-secondary\">{T["Inactive"]}</span>";
            }

            var itemOptions = Model.ItemOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var uomOptions = Model.UomOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var statusOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Active"] },
                new() { Value = "false", Label = T["Inactive"] }
            };

            var rows = new List<PagedGridRowViewModel>();
            foreach (var item in Model.Items.Items)
            {
                var factorHtml = await Component.InvokeAsync("TextNumber", new { value = item.ConversionFactor, decimals = 6, cssClass = "sinara-text-number-theme" });

                rows.Add(new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = $"{item.ItemCode} - {item.ItemName}" },
                        new PagedGridCellViewModel { Text = item.FromUomCode },
                        new PagedGridCellViewModel { Text = item.ToUomCode },
                        new PagedGridCellViewModel { Html = factorHtml, CellClass = "text-end" },
                        new PagedGridCellViewModel { Html = new HtmlString(BuildStatusBadge(item.IsActive)) }
                    ],
                    Actions = new PagedGridRowActionViewModel
                    {
                        EditUrl = Url.Action("EditItemConversion", "Inventory", new { id = item.Id }),
                        DeleteUrl = Url.Action("DeleteItemConversion", "Inventory", new { id = item.Id }),
                        DeleteConfirmMessage = T["Delete this data?"]
                    }
                });
            }

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "itemcode",
                        Title = T["Item"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "itemId",
                            Value = selectedItem,
                            EmptyOptionLabel = T["All"],
                            Options = itemOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "fromuomcode",
                        Title = T["From UOM"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "fromUomId",
                            Value = selectedFromUom,
                            EmptyOptionLabel = T["All"],
                            Options = uomOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "touomcode",
                        Title = T["To UOM"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "toUomId",
                            Value = selectedToUom,
                            EmptyOptionLabel = T["All"],
                            Options = uomOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "conversionfactor",
                        Title = T["Conversion Factor"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "factorFrom",
                            QueryKeyTo = "factorTo",
                            Value = Model.FactorFromFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.FactorToFilter?.ToString(CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isactive",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isActive",
                            Value = selectedIsActive,
                            EmptyOptionLabel = T["All Status"],
                            Options = statusOptions
                        }
                    }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Item Conversions"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateItemConversion", "Inventory"),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
