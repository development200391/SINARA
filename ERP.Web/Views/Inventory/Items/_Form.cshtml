            Id = Html.IdFor(x => x.Type).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.Type.ToString(),
            Options = Enum.GetValues<ItemType>().Select(itemType => new SearchableSelectOptionViewModel
            {
                Value = itemType.ToString(),
                Label = LocalizeItemType(itemType)
            }).ToList()
        })
        <span asp-validation-for="Type" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="CategoryId" class="form-label">@T["Category"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.CategoryId),
            Id = Html.IdFor(x => x.CategoryId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select Category"],
            SelectedValue = Model.CategoryId > 0
                ? Model.CategoryId.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.CategoryOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
