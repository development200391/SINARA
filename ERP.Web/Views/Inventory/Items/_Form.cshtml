    <div class="col-md-4">
        <label asp-for="LeadTimeDays" class="form-label">@T["Lead Time (Days)"]</label>
        <input asp-for="LeadTimeDays" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="numeric" data-text-number-decimals="0" autocomplete="off" />
        <span asp-validation-for="LeadTimeDays" class="text-danger small"></span>
