@model ERP.Web.ViewModels.Inventory.InventoryWarehouseStockIndexViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h5 mb-0">@T["Warehouse Stock"] - @Model.WarehouseCode</h1>
            <div class="d-flex gap-2">
                <a asp-action="WarehouseLocations" asp-controller="Inventory" asp-route-warehouseId="@Model.WarehouseId" class="btn btn-sm btn-outline-primary">@T["Locations"]</a>
                <a asp-action="Warehouses" asp-controller="Inventory" class="btn btn-sm btn-outline-secondary">@T["Back"]</a>
            </div>
        </div>

        @{
            var selectedItem = Model.ItemIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedLocation = Model.LocationIdFilter?.ToString(CultureInfo.InvariantCulture);

            var itemOptions = Model.ItemOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var locationOptions = Model.LocationOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var rows = new List<PagedGridRowViewModel>();
            foreach (var item in Model.Items.Items)
            {
                var qtyOnHandHtml = await Component.InvokeAsync("TextNumber", new { value = item.QtyOnHand, decimals = 2, cssClass = "sinara-text-number-theme" });
                var qtyReservedHtml = await Component.InvokeAsync("TextNumber", new { value = item.QtyReserved, decimals = 2, cssClass = "sinara-text-number-theme" });
                var qtyAvailableHtml = await Component.InvokeAsync("TextNumber", new { value = item.QtyAvailable, decimals = 2, cssClass = "sinara-text-number-theme" });
                var avgCostHtml = await Component.InvokeAsync("TextNumber", new { value = item.AvgCost, decimals = 2, cssClass = "sinara-text-number-theme" });
                var totalValueHtml = await Component.InvokeAsync("TextNumber", new { value = item.TotalValue, decimals = 2, cssClass = "sinara-text-number-theme" });

                rows.Add(new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = $"{item.ItemCode} - {item.ItemName}" },
                        new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.LocationCode) ? "-" : item.LocationCode },
                        new PagedGridCellViewModel { Html = qtyOnHandHtml, CellClass = "text-end" },
                        new PagedGridCellViewModel { Html = qtyReservedHtml, CellClass = "text-end" },
                        new PagedGridCellViewModel { Html = qtyAvailableHtml, CellClass = "text-end" },
                        new PagedGridCellViewModel { Html = avgCostHtml, CellClass = "text-end" },
                        new PagedGridCellViewModel { Html = totalValueHtml, CellClass = "text-end" }
                    ]
                });
            }

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "itemcode",
                        Title = T["Item"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "itemId",
                            Value = selectedItem,
                            EmptyOptionLabel = T["All"],
                            Options = itemOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "locationcode",
                        Title = T["Location"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "locationId",
                            Value = selectedLocation,
                            EmptyOptionLabel = T["All"],
                            Options = locationOptions
                        }
                    },
                    new PagedGridColumnViewModel { Key = "qtyonhand", Title = T["Qty On Hand"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "qtyreserved", Title = T["Qty Reserved"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "qtyavailable", Title = T["Qty Available"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "avgcost", Title = T["Average Cost"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "totalvalue", Title = T["Total Value"], Sortable = true, CellClass = "text-end" }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Stock"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
