@model ERP.Web.ViewModels.Inventory.InventoryWarehouseLocationEditViewModel

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Create Warehouse Location"]</h1>

        <form asp-action="CreateWarehouseLocation" asp-controller="Inventory" asp-route-warehouseId="@Model.WarehouseId" method="post" novalidate>
            @Html.AntiForgeryToken()
            <partial name="~/Views/Inventory/Warehouses/_LocationForm.cshtml" model="Model" />

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a asp-action="WarehouseLocations" asp-controller="Inventory" asp-route-warehouseId="@Model.WarehouseId" class="btn btn-outline-secondary">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

