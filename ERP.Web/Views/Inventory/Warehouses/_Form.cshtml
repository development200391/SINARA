@model ERP.Web.ViewModels.Inventory.InventoryWarehouseEditViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row g-3">
    <div class="col-md-3">
        <label asp-for="Code" class="form-label">@T["Code"]</label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="Name" class="form-label">@T["Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Phone" class="form-label">@T["Phone"]</label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ManagerId" class="form-label">@T["Manager"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.ManagerId),
            Id = Html.IdFor(x => x.ManagerId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["No Manager"],
            SelectedValue = Model.ManagerId.HasValue
                ? Model.ManagerId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.ManagerOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="ManagerId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CostCenterId" class="form-label">@T["Cost Center"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.CostCenterId),
            Id = Html.IdFor(x => x.CostCenterId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["None"],
            SelectedValue = Model.CostCenterId.HasValue
                ? Model.CostCenterId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.CostCenterOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="CostCenterId" class="text-danger small"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Address" class="form-label">@T["Address"]</label>
        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Address" class="text-danger small"></span>
    </div>
    <div class="col-md-12">
        <label asp-for="Description" class="form-label">@T["Description"]</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsTransit),
            Id = Html.IdFor(x => x.IsTransit).ToString(),
            Label = T["Transit Warehouse"],
            Checked = Model.IsTransit
        })
    </div>
    <div class="col-md-4">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsActive),
            Id = Html.IdFor(x => x.IsActive).ToString(),
            Label = T["Active"],
            Checked = Model.IsActive
        })
    </div>
</div>
