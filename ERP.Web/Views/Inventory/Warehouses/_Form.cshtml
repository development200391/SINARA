@model ERP.Web.ViewModels.Inventory.InventoryWarehouseEditViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row g-3">
    <div class="col-md-3">
        <label asp-for="Code" class="form-label">@T["Code"]</label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="Name" class="form-label">@T["Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Phone" class="form-label">@T["Phone"]</label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ManagerId" class="form-label">@T["Manager"]</label>
        <select asp-for="ManagerId" class="form-select">
            <option value="">@T["No Manager"]</option>
            @foreach (var option in Model.ManagerOptions)
            {
                <option value="@option.Id">@option.Label</option>
            }
        </select>
        <span asp-validation-for="ManagerId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CostCenterId" class="form-label">@T["Cost Center"]</label>
        <select asp-for="CostCenterId" class="form-select">
            <option value="">@T["None"]</option>
            @foreach (var option in Model.CostCenterOptions)
            {
                <option value="@option.Id">@option.Label</option>
            }
        </select>
        <span asp-validation-for="CostCenterId" class="text-danger small"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Address" class="form-label">@T["Address"]</label>
        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Address" class="text-danger small"></span>
    </div>
    <div class="col-md-12">
        <label asp-for="Description" class="form-label">@T["Description"]</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <div class="form-check mt-2">
            <input asp-for="IsTransit" class="form-check-input" />
            <label asp-for="IsTransit" class="form-check-label">@T["Transit Warehouse"]</label>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-check mt-2">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">@T["Active"]</label>
        </div>
    </div>
</div>
