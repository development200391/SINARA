@model ERP.Web.ViewModels.Inventory.InventoryWarehousesIndexViewModel
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Warehouses"]</h1>

        @{
            var selectedManager = Model.ManagerIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedCostCenter = Model.CostCenterIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedTransit = Model.IsTransitFilter.HasValue ? (Model.IsTransitFilter.Value ? "true" : "false") : null;
            var selectedIsActive = Model.IsActiveFilter.HasValue ? (Model.IsActiveFilter.Value ? "true" : "false") : null;

            string BuildStatusBadge(bool isActive)
            {
                return isActive
                    ? $"<span class=\"badge text-bg-success\">{T["Active"]}</span>"
                    : $"<span class=\"badge text-bg-secondary\">{T["Inactive"]}</span>";
            }

            string BuildTransitBadge(bool isTransit)
            {
                return isTransit
                    ? $"<span class=\"badge text-bg-info\">{T["Yes"]}</span>"
                    : $"<span class=\"badge text-bg-light text-dark\">{T["No"]}</span>";
            }

            var managerOptions = Model.ManagerOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var costCenterOptions = Model.CostCenterOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var transitOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Yes"] },
                new() { Value = "false", Label = T["No"] }
            };

            var statusOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Active"] },
                new() { Value = "false", Label = T["Inactive"] }
            };

            var rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
            {
                Cells =
                [
                    new PagedGridCellViewModel { Text = item.Code },
                    new PagedGridCellViewModel { Text = item.Name },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.ManagerName) ? "-" : item.ManagerName },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.CostCenterCode) ? "-" : item.CostCenterCode },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.Phone) ? "-" : item.Phone },
                    new PagedGridCellViewModel { Html = new HtmlString(BuildTransitBadge(item.IsTransit)) },
                    new PagedGridCellViewModel
                    {
                        Html = new HtmlString($"<a class=\"btn btn-sm btn-outline-info\" href=\"{Url.Action("WarehouseStock", "Inventory", new { warehouseId = item.Id })}\">{T["Stock"]}</a>")
                    },
                    new PagedGridCellViewModel { Html = new HtmlString(BuildStatusBadge(item.IsActive)) }
                ],
                Actions = new PagedGridRowActionViewModel
                {
                    DetailUrl = Url.Action("WarehouseLocations", "Inventory", new { warehouseId = item.Id }),
                    EditUrl = Url.Action("EditWarehouse", "Inventory", new { id = item.Id }),
                    DeleteUrl = Url.Action("DeleteWarehouse", "Inventory", new { id = item.Id }),
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            }).ToList();

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "code",
                        Title = T["Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "code",
                            Value = Model.CodeFilter,
                            Placeholder = T["Filter code"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "name",
                        Title = T["Name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "name",
                            Value = Model.NameFilter,
                            Placeholder = T["Filter name"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "managername",
                        Title = T["Manager"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "managerId",
                            Value = selectedManager,
                            EmptyOptionLabel = T["All Manager"],
                            Options = managerOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "costcentercode",
                        Title = T["Cost Center"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "costCenterId",
                            Value = selectedCostCenter,
                            EmptyOptionLabel = T["All"],
                            Options = costCenterOptions
                        }
                    },
                    new PagedGridColumnViewModel { Key = "phone", Title = T["Phone"], Sortable = false },
                    new PagedGridColumnViewModel
                    {
                        Key = "istransit",
                        Title = T["Transit"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isTransit",
                            Value = selectedTransit,
                            EmptyOptionLabel = T["All"],
                            Options = transitOptions
                        }
                    },
                    new PagedGridColumnViewModel { Key = "stock", Title = T["Stock"], Sortable = false },
                    new PagedGridColumnViewModel
                    {
                        Key = "isactive",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isActive",
                            Value = selectedIsActive,
                            EmptyOptionLabel = T["All Status"],
                            Options = statusOptions
                        }
                    }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Warehouses"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateWarehouse", "Inventory"),
                    AddButtonText = T["common.add_new"],
                    DetailButtonText = T["Locations"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
