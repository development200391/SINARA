@model ERP.Web.ViewModels.Inventory.InventoryWarehouseLocationsIndexViewModel
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h5 mb-0">@T["Warehouse Locations"] - @Model.WarehouseCode</h1>
            <div class="d-flex gap-2">
                <a asp-action="WarehouseStock" asp-controller="Inventory" asp-route-warehouseId="@Model.WarehouseId" class="btn btn-sm btn-outline-info">@T["Stock"]</a>
                <a asp-action="Warehouses" asp-controller="Inventory" class="btn btn-sm btn-outline-secondary">@T["Back"]</a>
            </div>
        </div>

        @{
            var selectedIsDefault = Model.IsDefaultFilter.HasValue ? (Model.IsDefaultFilter.Value ? "true" : "false") : null;
            var selectedIsActive = Model.IsActiveFilter.HasValue ? (Model.IsActiveFilter.Value ? "true" : "false") : null;

            string BuildStatusBadge(bool isActive)
            {
                return isActive
                    ? $"<span class=\"badge text-bg-success\">{T["Active"]}</span>"
                    : $"<span class=\"badge text-bg-secondary\">{T["Inactive"]}</span>";
            }

            string BuildDefaultBadge(bool isDefault)
            {
                return isDefault
                    ? $"<span class=\"badge text-bg-primary\">{T["Default"]}</span>"
                    : "-";
            }

            var yesNoOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Yes"] },
                new() { Value = "false", Label = T["No"] }
            };

            var activeOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Active"] },
                new() { Value = "false", Label = T["Inactive"] }
            };

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "code",
                        Title = T["Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "code",
                            Value = Model.CodeFilter,
                            Placeholder = T["Filter code"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "name",
                        Title = T["Name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "name",
                            Value = Model.NameFilter,
                            Placeholder = T["Filter name"]
                        }
                    },
                    new PagedGridColumnViewModel { Key = "description", Title = T["Description"], Sortable = false },
                    new PagedGridColumnViewModel
                    {
                        Key = "isdefault",
                        Title = T["Default"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isDefault",
                            Value = selectedIsDefault,
                            EmptyOptionLabel = T["All"],
                            Options = yesNoOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isactive",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isActive",
                            Value = selectedIsActive,
                            EmptyOptionLabel = T["All Status"],
                            Options = activeOptions
                        }
                    }
                ],
                Rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = item.Code },
                        new PagedGridCellViewModel { Text = item.Name },
                        new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description },
                        new PagedGridCellViewModel { Html = new HtmlString(BuildDefaultBadge(item.IsDefault)) },
                        new PagedGridCellViewModel { Html = new HtmlString(BuildStatusBadge(item.IsActive)) }
                    ],
                    Actions = new PagedGridRowActionViewModel
                    {
                        EditUrl = Url.Action("EditWarehouseLocation", "Inventory", new { warehouseId = Model.WarehouseId, id = item.Id }),
                        DeleteUrl = Url.Action("DeleteWarehouseLocation", "Inventory", new { warehouseId = Model.WarehouseId, id = item.Id }),
                        DeleteConfirmMessage = T["Delete this data?"]
                    }
                }).ToList(),
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Locations"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateWarehouseLocation", "Inventory", new { warehouseId = Model.WarehouseId }),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
