@model ERP.Web.ViewModels.Inventory.InventoryAdjustmentEditViewModel

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Edit Adjustment"]</h1>

        <form asp-action="EditAdjustment" asp-controller="Inventory" asp-route-id="@Model.Id" method="post" novalidate>
            @Html.AntiForgeryToken()
            <partial name="~/Views/Inventory/Adjustments/_Form.cshtml" model="Model" />

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a asp-action="Adjustments" asp-controller="Inventory" class="btn btn-outline-secondary">@T["common.cancel"]</a>
            </div>
        </form>

        @if (Model.Id.HasValue)
        {
            <form asp-action="ApproveAdjustment" asp-controller="Inventory" asp-route-id="@Model.Id" method="post" class="mt-2 d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-success" onclick="return confirm('@T["Approve this data?"]')">@T["Approve"]</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

