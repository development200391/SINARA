@model ERP.Web.ViewModels.Inventory.InventoryGoodsIssueEditViewModel
@using ERP.Domain.Enums.Inventory
@using ERP.Web.ViewModels.Shared
@using System.Globalization

@{
    string LocalizeIssueType(GoodsIssueType value)
    {
        return value switch
        {
            GoodsIssueType.DepartmentalUse => T["Departmental Use"],
            GoodsIssueType.ProductionUse => T["Production Use"],
            GoodsIssueType.MaintenanceUse => T["Maintenance Use"],
            GoodsIssueType.Disposal => T["Disposal"],
            GoodsIssueType.ReturnToVendor => T["Return To Vendor"],
            _ => value.ToString()
        };
    }
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="IssueDate" class="form-label">@T["Issue Date"]</label>
        <input asp-for="IssueDate" type="date" class="form-control" />
        <span asp-validation-for="IssueDate" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="IssueType" class="form-label">@T["Issue Type"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.IssueType),
            Id = Html.IdFor(x => x.IssueType).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.IssueType.ToString(),
            Options = Enum.GetValues<GoodsIssueType>().Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.ToString(),
                Label = LocalizeIssueType(option)
            }).ToList()
        })
        <span asp-validation-for="IssueType" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="WarehouseId" class="form-label">@T["Warehouse"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.WarehouseId),
            Id = Html.IdFor(x => x.WarehouseId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select Warehouse"],
            SelectedValue = Model.WarehouseId > 0
                ? Model.WarehouseId.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.WarehouseOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="WarehouseId" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="LocationId" class="form-label">@T["Location"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.LocationId),
            Id = Html.IdFor(x => x.LocationId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All"],
            SelectedValue = Model.LocationId.HasValue
                ? Model.LocationId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.LocationOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="LocationId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DepartmentId" class="form-label">@T["Department"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.DepartmentId),
            Id = Html.IdFor(x => x.DepartmentId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All"],
            SelectedValue = Model.DepartmentId.HasValue
                ? Model.DepartmentId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.DepartmentOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="CostCenterId" class="form-label">@T["Cost Center"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.CostCenterId),
            Id = Html.IdFor(x => x.CostCenterId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All"],
            SelectedValue = Model.CostCenterId.HasValue
                ? Model.CostCenterId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.CostCenterOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="CostCenterId" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ReferenceNo" class="form-label">@T["Reference No"]</label>
        <input asp-for="ReferenceNo" class="form-control" />
        <span asp-validation-for="ReferenceNo" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Description" class="form-label">@T["Description"]</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
