@model ERP.Web.ViewModels.Inventory.InventoryGoodsIssueEditViewModel
@using ERP.Domain.Enums.Inventory

@{
    string LocalizeIssueType(GoodsIssueType value)
    {
        return value switch
        {
            GoodsIssueType.DepartmentalUse => T["Departmental Use"],
            GoodsIssueType.ProductionUse => T["Production Use"],
            GoodsIssueType.MaintenanceUse => T["Maintenance Use"],
            GoodsIssueType.Disposal => T["Disposal"],
            GoodsIssueType.ReturnToVendor => T["Return To Vendor"],
            _ => value.ToString()
        };
    }
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="row g-3">
    <div class="col-md-4">
        <label asp-for="IssueDate" class="form-label">@T["Issue Date"]</label>
        <input asp-for="IssueDate" type="date" class="form-control" />
        <span asp-validation-for="IssueDate" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="IssueType" class="form-label">@T["Issue Type"]</label>
        <select asp-for="IssueType" class="form-select">
            @foreach (var option in Enum.GetValues<GoodsIssueType>())
            {
                <option value="@option">@LocalizeIssueType(option)</option>
            }
        </select>
        <span asp-validation-for="IssueType" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="WarehouseId" class="form-label">@T["Warehouse"]</label>
        <select asp-for="WarehouseId" class="form-select">
            <option value="">@T["Select Warehouse"]</option>
            @foreach (var option in Model.WarehouseOptions)
            {
                <option value="@option.Id">@option.Label</option>
            }
        </select>
        <span asp-validation-for="WarehouseId" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="LocationId" class="form-label">@T["Location"]</label>
        <select asp-for="LocationId" class="form-select">
            <option value="">@T["All"]</option>
            @foreach (var option in Model.LocationOptions)
            {
                <option value="@option.Id">@option.Label</option>
            }
        </select>
        <span asp-validation-for="LocationId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DepartmentId" class="form-label">@T["Department"]</label>
        <select asp-for="DepartmentId" class="form-select">
            <option value="">@T["All"]</option>
            @foreach (var option in Model.DepartmentOptions)
            {
                <option value="@option.Id">@option.Label</option>
            }
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="CostCenterId" class="form-label">@T["Cost Center"]</label>
        <select asp-for="CostCenterId" class="form-select">
            <option value="">@T["All"]</option>
            @foreach (var option in Model.CostCenterOptions)
            {
                <option value="@option.Id">@option.Label</option>
            }
        </select>
        <span asp-validation-for="CostCenterId" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ReferenceNo" class="form-label">@T["Reference No"]</label>
        <input asp-for="ReferenceNo" class="form-control" />
        <span asp-validation-for="ReferenceNo" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Description" class="form-label">@T["Description"]</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ItemId" class="form-label">@T["Item"]</label>
        <select asp-for="ItemId" class="form-select">
            <option value="">@T["Select Item"]</option>
            @foreach (var option in Model.ItemOptions)
            {
                <option value="@option.Id">@option.Label</option>
            }
        </select>
        <span asp-validation-for="ItemId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="UomId" class="form-label">@T["UOM"]</label>
        <select asp-for="UomId" class="form-select">
            <option value="">@T["All"]</option>
            @foreach (var option in Model.UomOptions)
            {
                <option value="@option.Id">@option.Label</option>
            }
        </select>
        <span asp-validation-for="UomId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="QtyRequested" class="form-label">@T["Qty Requested"]</label>
        <input asp-for="QtyRequested" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="decimal" data-text-number-decimals="2" autocomplete="off" />
        <span asp-validation-for="QtyRequested" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="QtyIssued" class="form-label">@T["Qty Issued"]</label>
        <input asp-for="QtyIssued" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="decimal" data-text-number-decimals="2" autocomplete="off" />
        <span asp-validation-for="QtyIssued" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="QtyBase" class="form-label">@T["Qty Base"]</label>
        <input asp-for="QtyBase" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="decimal" data-text-number-decimals="2" autocomplete="off" />
        <span asp-validation-for="QtyBase" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="UnitCost" class="form-label">@T["Unit Cost"]</label>
        <input asp-for="UnitCost" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="decimal" data-text-number-decimals="2" autocomplete="off" />
        <span asp-validation-for="UnitCost" class="text-danger small"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="LineNotes" class="form-label">@T["Line Notes"]</label>
        <input asp-for="LineNotes" class="form-control" />
        <span asp-validation-for="LineNotes" class="text-danger small"></span>
    </div>
</div>
