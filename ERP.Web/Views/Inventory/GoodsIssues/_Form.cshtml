        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.UomId),
            Id = Html.IdFor(x => x.UomId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All"],
            SelectedValue = Model.UomId.HasValue
                ? Model.UomId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.UomOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="UomId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="QtyRequested" class="form-label">@T["Qty Requested"]</label>
        <input asp-for="QtyRequested" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="decimal" data-text-number-decimals="2" autocomplete="off" />
        <span asp-validation-for="QtyRequested" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="QtyIssued" class="form-label">@T["Qty Issued"]</label>
        <input asp-for="QtyIssued" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="decimal" data-text-number-decimals="2" autocomplete="off" />
        <span asp-validation-for="QtyIssued" class="text-danger small"></span>
