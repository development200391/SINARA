@model ERP.Web.ViewModels.Approval.ApprovalDelegationEditViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <label asp-for="DelegatorUserId" class="form-label">@T["Delegator"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.DelegatorUserId),
            Id = Html.IdFor(x => x.DelegatorUserId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select Employee"],
            SelectedValue = Model.DelegatorUserId > 0
                ? Model.DelegatorUserId.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.UserOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="DelegatorUserId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="DelegateUserId" class="form-label">@T["Delegate"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.DelegateUserId),
            Id = Html.IdFor(x => x.DelegateUserId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select Employee"],
            SelectedValue = Model.DelegateUserId > 0
                ? Model.DelegateUserId.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.UserOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="DelegateUserId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="TemplateId" class="form-label">@T["Template"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.TemplateId),
            Id = Html.IdFor(x => x.TemplateId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All"],
            SelectedValue = Model.TemplateId.HasValue
                ? Model.TemplateId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.TemplateOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="TemplateId" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="StartDate" class="form-label">@T["Start Date"]</label>
        <input asp-for="StartDate" class="form-control" type="date" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="EndDate" class="form-label">@T["End Date"]</label>
        <input asp-for="EndDate" class="form-control" type="date" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Reason" class="form-label">@T["Reason"]</label>
        <textarea asp-for="Reason" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>

    <div class="col-12 mt-1">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsActive),
            Id = Html.IdFor(x => x.IsActive).ToString(),
            Label = T["Active"],
            Checked = Model.IsActive
        })
    </div>
</div>
