@model ERP.Web.ViewModels.Approval.ApprovalTemplateReportIndexViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["By Template Report"]</h1>

        @{
            var selectedTemplate = Model.TemplateIdFilter?.ToString(CultureInfo.InvariantCulture);

            var templateOptions = Model.TemplateOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var rows = new List<PagedGridRowViewModel>();
            foreach (var item in Model.Items.Items)
            {
                var avgDurationHtml = await Component.InvokeAsync("TextNumber", new { value = item.AverageDurationHours, decimals = 2, cssClass = "sinara-text-number-theme" });

                rows.Add(new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = item.TemplateCode },
                        new PagedGridCellViewModel { Text = item.TemplateName },
                        new PagedGridCellViewModel { Text = item.Module },
                        new PagedGridCellViewModel { Text = item.TotalRequests.ToString(CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = item.ApprovedCount.ToString(CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = item.RejectedCount.ToString(CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = item.CancelledCount.ToString(CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = item.PendingCount.ToString(CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel { Html = avgDurationHtml, CellClass = "text-end" }
                    ]
                });
            }

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel { Key = "templatecode", Title = T["Template Code"], Sortable = true },
                    new PagedGridColumnViewModel
                    {
                        Key = "templatename",
                        Title = T["Template Name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "templateId",
                            Value = selectedTemplate,
                            EmptyOptionLabel = T["All"],
                            Options = templateOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "module",
                        Title = T["Module"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "module",
                            Value = Model.ModuleFilter,
                            Placeholder = T["Module"]
                        }
                    },
                    new PagedGridColumnViewModel { Key = "totalrequests", Title = T["Total Requests"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "approvedcount", Title = T["Approved"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "rejectedcount", Title = T["Rejected"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "cancelledcount", Title = T["Cancelled"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "pendingcount", Title = T["Pending"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "averagedurationhours", Title = T["Avg Duration Hours"], Sortable = true, CellClass = "text-end" }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["By Template Report"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
