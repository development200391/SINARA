@model ERP.Web.ViewModels.Approval.ApprovalLevelEditViewModel

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Create Approval Level"]</h1>

        <form asp-action="CreateLevel" asp-controller="Approval" asp-route-templateId="@Model.TemplateId" method="post" novalidate>
            @Html.AntiForgeryToken()
            <partial name="~/Views/Approval/Levels/_Form.cshtml" model="Model" />

            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a asp-action="TemplateLevels" asp-controller="Approval" asp-route-templateId="@Model.TemplateId" class="btn btn-outline-secondary">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>
