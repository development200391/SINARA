@model ERP.Web.ViewModels.Approval.ApprovalTemplateEditViewModel
@using ERP.Domain.Enums.Approval
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-3">
        <label asp-for="Code" class="form-label">@T["Template Code"]</label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>

    <div class="col-md-5">
        <label asp-for="Name" class="form-label">@T["Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Module" class="form-label">@T["Module"]</label>
        <input asp-for="Module" class="form-control" />
        <span asp-validation-for="Module" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ReferenceType" class="form-label">@T["Reference Type"]</label>
        <input asp-for="ReferenceType" class="form-control" />
        <span asp-validation-for="ReferenceType" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ApprovalType" class="form-label">@T["Approval Type"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.ApprovalType),
            Id = Html.IdFor(x => x.ApprovalType).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.ApprovalType.ToString(),
            Options = Enum.GetValues<ApprovalType>().Select(type => new SearchableSelectOptionViewModel
            {
                Value = type.ToString(),
                Label = type switch
                {
                    ApprovalType.Sequential => T["Sequential"],
                    ApprovalType.Parallel => T["Parallel"],
                    ApprovalType.AnyOne => T["Any One"],
                    _ => type.ToString()
                }
            }).ToList()
        })
        <span asp-validation-for="ApprovalType" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="SlaHours" class="form-label">@T["SLA Hours"]</label>
        <input asp-for="SlaHours" class="form-control text-end" type="number" min="1" />
        <span asp-validation-for="SlaHours" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="MinAmount" class="form-label">@T["Minimum Amount"]</label>
        <input asp-for="MinAmount" class="form-control text-end" type="number" step="0.01" inputmode="decimal" />
        <span asp-validation-for="MinAmount" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="MaxAmount" class="form-label">@T["Maximum Amount"]</label>
        <input asp-for="MaxAmount" class="form-control text-end" type="number" step="0.01" inputmode="decimal" />
        <span asp-validation-for="MaxAmount" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="AutoApproveBelow" class="form-label">@T["Auto Approve Below"]</label>
        <input asp-for="AutoApproveBelow" class="form-control text-end" type="number" step="0.01" inputmode="decimal" />
        <span asp-validation-for="AutoApproveBelow" class="text-danger"></span>
    </div>

    <div class="col-12 d-flex flex-wrap gap-3 mt-1">
        <div>
            @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
            {
                Name = nameof(Model.AllowDelegation),
                Id = Html.IdFor(x => x.AllowDelegation).ToString(),
                Label = T["Allow Delegation"],
                Checked = Model.AllowDelegation
            })
        </div>

        <div>
            @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
            {
                Name = nameof(Model.RequireCommentOnReject),
                Id = Html.IdFor(x => x.RequireCommentOnReject).ToString(),
                Label = T["Require Comment On Reject"],
                Checked = Model.RequireCommentOnReject
            })
        </div>

        <div>
            @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
            {
                Name = nameof(Model.IsActive),
                Id = Html.IdFor(x => x.IsActive).ToString(),
                Label = T["Active"],
                Checked = Model.IsActive
            })
        </div>
    </div>
</div>
