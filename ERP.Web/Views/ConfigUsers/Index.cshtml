@model ERP.Web.ViewModels.Config.ConfigUsersIndexViewModel

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h1 class="h5 mb-0">Users</h1>
            <a class="btn btn-primary btn-sm" asp-action="Create">@T["common.add_new"]</a>
        </div>

        <form method="get" class="row g-2 mb-3">
            <div class="col-md-4">
                <input type="text" class="form-control" name="search" value="@Model.Search" placeholder="@T["common.search"] users" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary">@T["common.search"]</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>@T["label.full_name"]</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Users.Items.Count == 0)
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">@T["msg.no_data"]</td></tr>
                }
                else
                {
                    foreach (var user in Model.Users.Items)
                    {
                        <tr>
                            <td>@user.Username</td>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@string.Join(", ", user.Roles)</td>
                            <td>
                                <span class="badge @(user.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(user.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@user.Id">@T["common.edit"]</a>
                                <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this user?')">@T["common.delete"]</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>

        @{
            ViewData["Page"] = Model.Users.Page;
            ViewData["TotalPages"] = Model.Users.TotalPages;
        }
        <partial name="~/Views/Shared/_Pagination.cshtml" />
    </div>
</div>
