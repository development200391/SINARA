@model ERP.Web.ViewModels.Shared.PagedGridViewModel
@using System.Globalization
@using System.Text.Encodings.Web

@{
    var safeTotalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    var safePage = Model.Page <= 0 ? 1 : Math.Min(Model.Page, safeTotalPages);
    var safePageSize = Model.PageSize <= 0 ? 20 : Model.PageSize;
    var currentSortBy = Model.SortBy?.Trim();
    var normalizedSortDirection = string.Equals(Model.SortDirection, "asc", StringComparison.OrdinalIgnoreCase) ? "asc" : "desc";
    var pageSizeOptions = Model.PageSizeOptions
        .Where(x => x > 0)
        .Distinct()
        .OrderBy(x => x)
        .ToList();

    if (!pageSizeOptions.Contains(safePageSize))
    {
        pageSizeOptions.Add(safePageSize);
        pageSizeOptions = pageSizeOptions.Distinct().OrderBy(x => x).ToList();
    }

    var pageSizeSelectId = $"page-size-{Guid.NewGuid():N}";
    var searchInputId = $"search-{Guid.NewGuid():N}";
    var searchPlaceholder = string.IsNullOrWhiteSpace(Model.SearchPlaceholder) ? "Search" : Model.SearchPlaceholder;

    var hasColumnFilters = Model.Columns.Any(x => x.Filter is not null && !string.IsNullOrWhiteSpace(x.Filter.QueryKey));
    var filterFormId = $"grid-filter-{Guid.NewGuid():N}";
    var filterSubmitScript = $"document.getElementById('{filterFormId}')?.requestSubmit();";

    bool IsFilterActive(ERP.Web.ViewModels.Shared.PagedGridFilterViewModel? filter)
    {
        if (filter is null || string.IsNullOrWhiteSpace(filter.QueryKey))
        {
            return false;
        }

        return filter.Type switch
        {
            ERP.Web.ViewModels.Shared.PagedGridFilterType.Text =>
                !string.IsNullOrWhiteSpace(filter.Value),

            ERP.Web.ViewModels.Shared.PagedGridFilterType.DatePicker =>
                !string.IsNullOrWhiteSpace(filter.Value),

            ERP.Web.ViewModels.Shared.PagedGridFilterType.DateRange =>
                !string.IsNullOrWhiteSpace(filter.Value) || !string.IsNullOrWhiteSpace(filter.ValueTo),

            ERP.Web.ViewModels.Shared.PagedGridFilterType.NumberRange =>
                !string.IsNullOrWhiteSpace(filter.Value) || !string.IsNullOrWhiteSpace(filter.ValueTo),

            ERP.Web.ViewModels.Shared.PagedGridFilterType.Select =>
                !string.IsNullOrWhiteSpace(filter.Value),

            ERP.Web.ViewModels.Shared.PagedGridFilterType.Checkbox =>
                filter.IsChecked,

            ERP.Web.ViewModels.Shared.PagedGridFilterType.MultiSelect =>
                filter.Values.Any(x => !string.IsNullOrWhiteSpace(x)),

            _ => false
        };
    }

    bool HasRowActions(ERP.Web.ViewModels.Shared.PagedGridRowActionViewModel? action)
    {
        if (action is null)
        {
            return false;
        }

        return !string.IsNullOrWhiteSpace(action.DetailUrl)
            || !string.IsNullOrWhiteSpace(action.EditUrl)
            || !string.IsNullOrWhiteSpace(action.DeleteUrl);
    }

    void AddFilterRouteValues(Dictionary<string, string?> values)
    {
        foreach (var column in Model.Columns)
        {
            var filter = column.Filter;
            if (filter is null || string.IsNullOrWhiteSpace(filter.QueryKey))
            {
                continue;
            }

            switch (filter.Type)
            {
                case ERP.Web.ViewModels.Shared.PagedGridFilterType.Text:
                    values[filter.QueryKey] = filter.Value;
                    break;

                case ERP.Web.ViewModels.Shared.PagedGridFilterType.DatePicker:
                    values[filter.QueryKey] = filter.Value;
                    break;

                case ERP.Web.ViewModels.Shared.PagedGridFilterType.DateRange:
                    values[filter.QueryKey] = filter.Value;

                    if (!string.IsNullOrWhiteSpace(filter.QueryKeyTo))
                    {
                        values[filter.QueryKeyTo] = filter.ValueTo;
                    }
                    break;

                case ERP.Web.ViewModels.Shared.PagedGridFilterType.NumberRange:
                    values[filter.QueryKey] = filter.Value;

                    if (!string.IsNullOrWhiteSpace(filter.QueryKeyTo))
                    {
                        values[filter.QueryKeyTo] = filter.ValueTo;
                    }
                    break;

                case ERP.Web.ViewModels.Shared.PagedGridFilterType.Select:
                    values[filter.QueryKey] = filter.Value;
                    break;

                case ERP.Web.ViewModels.Shared.PagedGridFilterType.Checkbox:
                    values[filter.QueryKey] = filter.IsChecked
                        ? (string.IsNullOrWhiteSpace(filter.CheckedValue) ? "true" : filter.CheckedValue)
                        : null;
                    break;

                case ERP.Web.ViewModels.Shared.PagedGridFilterType.MultiSelect:
                    var normalizedValues = filter.Values
                        .Where(x => !string.IsNullOrWhiteSpace(x))
                        .Select(x => x.Trim())
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .ToArray();

                    values[filter.QueryKey] = normalizedValues.Length > 0
                        ? string.Join(",", normalizedValues)
                        : null;
                    break;
            }
        }
    }

    HashSet<string> GetFilterQueryKeys()
    {
        var keys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var column in Model.Columns)
        {
            var filter = column.Filter;
            if (filter is null)
            {
                continue;
            }

            if (!string.IsNullOrWhiteSpace(filter.QueryKey))
            {
                keys.Add(filter.QueryKey);
            }

            if (!string.IsNullOrWhiteSpace(filter.QueryKeyTo))
            {
                keys.Add(filter.QueryKeyTo);
            }
        }

        return keys;
    }

    Dictionary<string, string?> BuildRouteValues(
        string? page = null,
        int? pageSize = null,
        string? sortBy = null,
        string? sortDirection = null,
        string? search = null)
    {
        var values = new Dictionary<string, string?>(StringComparer.OrdinalIgnoreCase);
        foreach (var route in Model.RouteValues)
        {
            values[route.Key] = route.Value;
        }

        if (Model.EnableSearch && !string.IsNullOrWhiteSpace(Model.SearchQueryKey))
        {
            values[Model.SearchQueryKey] = search ?? Model.SearchValue;
        }

        AddFilterRouteValues(values);

        values[Model.PageSizeQueryKey] = (pageSize ?? safePageSize).ToString(CultureInfo.InvariantCulture);
        values[Model.SortByQueryKey] = sortBy ?? currentSortBy;
        values[Model.SortDirectionQueryKey] = sortDirection ?? normalizedSortDirection;

        if (!string.IsNullOrWhiteSpace(page))
        {
            values[Model.PageQueryKey] = page;
        }

        return values;
    }

    var searchFormRouteValues = BuildRouteValues(page: "1");
    var pageSizeFormRouteValues = BuildRouteValues(page: "1");
    var filterFormRouteValues = BuildRouteValues(page: "1");
    var filterQueryKeys = GetFilterQueryKeys();
    var hasActiveFilters = Model.Columns.Any(x => IsFilterActive(x.Filter));
    var clearFilterRouteValues = BuildRouteValues(page: "1");
    var hasAddAction = !string.IsNullOrWhiteSpace(Model.Actions.AddUrl);
    var hasRowActions = Model.Rows.Any(x => HasRowActions(x.Actions));

    foreach (var key in filterQueryKeys)
    {
        clearFilterRouteValues.Remove(key);
    }
}

@if (Model.EnableSearch || !string.IsNullOrWhiteSpace(Model.ExportUrl) || hasColumnFilters || hasAddAction)
{
    <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
        @if (Model.EnableSearch)
        {
            <form method="get" class="d-flex align-items-center gap-2 flex-nowrap sinara-grid-toolbar">
                @foreach (var route in searchFormRouteValues)
                {
                    if (string.Equals(route.Key, Model.SearchQueryKey, StringComparison.OrdinalIgnoreCase))
                    {
                        continue;
                    }

                    <input type="hidden" name="@route.Key" value="@route.Value" />
                }

                <label class="visually-hidden" for="@searchInputId">Search</label>
                <input id="@searchInputId" type="text" class="form-control form-control-sm sinara-grid-search-input" name="@Model.SearchQueryKey" value="@Model.SearchValue" placeholder="@searchPlaceholder" />
                <button type="submit" class="btn btn-sm sinara-btn-theme-outline text-nowrap">@Model.SearchButtonText</button>
            </form>
        }

        @if (hasAddAction || hasColumnFilters || !string.IsNullOrWhiteSpace(Model.ExportUrl))
        {
            <div class="d-flex align-items-center gap-2 ms-auto">
                @if (hasAddAction)
                {
                    <a class="btn btn-sm sinara-btn-theme-outline text-nowrap" href="@Model.Actions.AddUrl">@Model.Actions.AddButtonText</a>
                }

                @if (hasColumnFilters)
                {
                    <a class="btn btn-sm text-nowrap @(hasActiveFilters ? "sinara-btn-theme-outline" : "btn-outline-secondary")" asp-all-route-data="clearFilterRouteValues">Clear Filter</a>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ExportUrl))
                {
                    <a class="btn btn-sm sinara-btn-theme-outline text-nowrap" href="@Model.ExportUrl">@Model.ExportButtonText</a>
                }
            </div>
        }
    </div>
}

@if (hasColumnFilters)
{
    <form id="@filterFormId" method="get">
        @foreach (var route in filterFormRouteValues)
        {
            if (filterQueryKeys.Contains(route.Key))
            {
                continue;
            }

            <input type="hidden" name="@route.Key" value="@route.Value" />
        }
    </form>
}

<div class="table-responsive">
    <table class="table table-sm align-middle sinara-paged-grid">
        <thead class="sinara-paged-grid-header">
            <tr>
                @foreach (var column in Model.Columns)
                {
                    var filter = column.Filter;
                    var hasFilter = filter is not null && !string.IsNullOrWhiteSpace(filter.QueryKey);
                    var isFilterActive = IsFilterActive(filter);
                    var headerClass = string.Join(" ", new[]
                    {
                        column.HeaderClass,
                        isFilterActive ? "sinara-grid-col-filtered" : string.Empty
                    }.Where(x => !string.IsNullOrWhiteSpace(x)));

                    <th class="@headerClass">
                        <div class="d-flex align-items-center justify-content-between gap-1">
                            @if (column.Sortable)
                            {
                                var isCurrentSort = string.Equals(currentSortBy, column.Key, StringComparison.OrdinalIgnoreCase);
                                var nextSortDirection = isCurrentSort && normalizedSortDirection == "asc" ? "desc" : "asc";
                                var sortRouteValues = BuildRouteValues(
                                    page: "1",
                                    sortBy: column.Key,
                                    sortDirection: nextSortDirection);

                                <a class="sinara-grid-sort-link text-decoration-none d-inline-flex align-items-center gap-1" asp-all-route-data="sortRouteValues">
                                    <span>@column.Title</span>
                                    @if (isCurrentSort)
                                    {
                                        <small aria-hidden="true">@(normalizedSortDirection == "asc" ? "^" : "v")</small>
                                    }
                                </a>
                            }
                            else
                            {
                                <span class="fw-semibold">@column.Title</span>
                            }

                            @if (hasFilter)
                            {
                                <div class="dropdown sinara-grid-filter-dropdown" data-bs-auto-close="outside">
                                    <button type="button"
                                            class="btn btn-sm sinara-grid-filter-toggle @(isFilterActive ? "active" : string.Empty)"
                                            data-bs-toggle="dropdown"
                                            aria-expanded="false"
                                            aria-label="Filter @column.Title">
                                        ...
                                    </button>

                                    <div class="dropdown-menu dropdown-menu-end p-2 sinara-grid-filter-menu">
                                        @if (filter!.Type == ERP.Web.ViewModels.Shared.PagedGridFilterType.DateRange)
                                        {
                                            var dateFromId = $"filter-{column.Key}-from-{Guid.NewGuid():N}";
                                            var dateToId = $"filter-{column.Key}-to-{Guid.NewGuid():N}";
                                            var placeholderFrom = string.IsNullOrWhiteSpace(filter.Placeholder) ? "From" : filter.Placeholder;
                                            var placeholderTo = string.IsNullOrWhiteSpace(filter.PlaceholderTo) ? "To" : filter.PlaceholderTo;

                                            <div class="d-flex flex-column gap-2">
                                                <label class="small text-muted" for="@dateFromId">@placeholderFrom</label>
                                                <input id="@dateFromId"
                                                       type="date"
                                                       class="form-control form-control-sm sinara-grid-filter-control"
                                                       name="@filter.QueryKey"
                                                       value="@filter.Value"
                                                       form="@filterFormId"
                                                       onchange="@filterSubmitScript" />

                                                @if (!string.IsNullOrWhiteSpace(filter.QueryKeyTo))
                                                {
                                                    <label class="small text-muted" for="@dateToId">@placeholderTo</label>
                                                    <input id="@dateToId"
                                                           type="date"
                                                           class="form-control form-control-sm sinara-grid-filter-control"
                                                           name="@filter.QueryKeyTo"
                                                           value="@filter.ValueTo"
                                                           form="@filterFormId"
                                                           onchange="@filterSubmitScript" />
                                                }
                                            </div>
                                        }
                                        else if (filter.Type == ERP.Web.ViewModels.Shared.PagedGridFilterType.DatePicker)
                                        {
                                            var datePickerId = $"filter-{column.Key}-date-{Guid.NewGuid():N}";
                                            var placeholder = string.IsNullOrWhiteSpace(filter.Placeholder) ? column.Title : filter.Placeholder;

                                            <label class="small text-muted" for="@datePickerId">@placeholder</label>
                                            <input id="@datePickerId"
                                                   type="date"
                                                   class="form-control form-control-sm sinara-grid-filter-control"
                                                   name="@filter.QueryKey"
                                                   value="@filter.Value"
                                                   form="@filterFormId"
                                                   onchange="@filterSubmitScript" />
                                        }
                                        else if (filter.Type == ERP.Web.ViewModels.Shared.PagedGridFilterType.NumberRange)
                                        {
                                            var numberFromId = $"filter-{column.Key}-number-from-{Guid.NewGuid():N}";
                                            var numberToId = $"filter-{column.Key}-number-to-{Guid.NewGuid():N}";
                                            var placeholderFrom = string.IsNullOrWhiteSpace(filter.Placeholder) ? "From" : filter.Placeholder;
                                            var placeholderTo = string.IsNullOrWhiteSpace(filter.PlaceholderTo) ? "To" : filter.PlaceholderTo;

                                            <div class="d-flex flex-column gap-2">
                                                <label class="small text-muted" for="@numberFromId">@placeholderFrom</label>
                                                <input id="@numberFromId"
                                                       type="number"
                                                       class="form-control form-control-sm sinara-grid-filter-control"
                                                       name="@filter.QueryKey"
                                                       value="@filter.Value"
                                                       form="@filterFormId"
                                                       onchange="@filterSubmitScript" />

                                                @if (!string.IsNullOrWhiteSpace(filter.QueryKeyTo))
                                                {
                                                    <label class="small text-muted" for="@numberToId">@placeholderTo</label>
                                                    <input id="@numberToId"
                                                           type="number"
                                                           class="form-control form-control-sm sinara-grid-filter-control"
                                                           name="@filter.QueryKeyTo"
                                                           value="@filter.ValueTo"
                                                           form="@filterFormId"
                                                           onchange="@filterSubmitScript" />
                                                }
                                            </div>
                                        }
                                        else if (filter.Type == ERP.Web.ViewModels.Shared.PagedGridFilterType.Text)
                                        {
                                            var textFilterId = $"filter-{column.Key}-text-{Guid.NewGuid():N}";
                                            var placeholder = string.IsNullOrWhiteSpace(filter.Placeholder) ? column.Title : filter.Placeholder;

                                            <label class="small text-muted" for="@textFilterId">@placeholder</label>
                                            <input id="@textFilterId"
                                                   type="text"
                                                   class="form-control form-control-sm sinara-grid-filter-control"
                                                   name="@filter.QueryKey"
                                                   value="@filter.Value"
                                                   placeholder="@placeholder"
                                                   form="@filterFormId"
                                                   onchange="@filterSubmitScript" />
                                        }
                                        else if (filter.Type == ERP.Web.ViewModels.Shared.PagedGridFilterType.Select)
                                        {
                                            var selectId = $"filter-{column.Key}-select-{Guid.NewGuid():N}";

                                            <label class="small text-muted" for="@selectId">@column.Title</label>
                                            <select id="@selectId"
                                                    class="form-select form-select-sm sinara-grid-filter-control"
                                                    name="@filter.QueryKey"
                                                    form="@filterFormId"
                                                    onchange="@filterSubmitScript">
                                                <option value="" selected="@string.IsNullOrWhiteSpace(filter.Value)">@filter.EmptyOptionLabel</option>
                                                @foreach (var option in filter.Options)
                                                {
                                                    <option value="@option.Value" selected="@string.Equals(option.Value, filter.Value, StringComparison.OrdinalIgnoreCase)">@option.Label</option>
                                                }
                                            </select>
                                        }
                                        else if (filter.Type == ERP.Web.ViewModels.Shared.PagedGridFilterType.Checkbox)
                                        {
                                            var checkboxId = $"filter-{column.Key}-checkbox-{Guid.NewGuid():N}";
                                            var checkedValue = string.IsNullOrWhiteSpace(filter.CheckedValue) ? "true" : filter.CheckedValue;

                                            <div class="form-check sinara-grid-filter-check mb-0">
                                                <input id="@checkboxId"
                                                       type="checkbox"
                                                       class="form-check-input"
                                                       name="@filter.QueryKey"
                                                       value="@checkedValue"
                                                       checked="@filter.IsChecked"
                                                       form="@filterFormId"
                                                       onchange="@filterSubmitScript" />
                                                <label class="form-check-label small" for="@checkboxId">@filter.Label</label>
                                            </div>
                                        }
                                        else if (filter.Type == ERP.Web.ViewModels.Shared.PagedGridFilterType.MultiSelect)
                                        {
                                            var multiSelectId = $"filter-{column.Key}-multi-{Guid.NewGuid():N}";
                                            var selectedValues = filter.Values
                                                .Where(x => !string.IsNullOrWhiteSpace(x))
                                                .Select(x => x.Trim())
                                                .Distinct(StringComparer.OrdinalIgnoreCase)
                                                .ToList();
                                            var selectedValueSet = new HashSet<string>(selectedValues, StringComparer.OrdinalIgnoreCase);
                                            var multiSelectSize = filter.Size < 2 ? 2 : filter.Size;

                                            <label class="small text-muted" for="@multiSelectId">@column.Title</label>
                                            <select id="@multiSelectId"
                                                    class="form-select form-select-sm sinara-grid-filter-control sinara-grid-filter-multi"
                                                    name="@filter.QueryKey"
                                                    multiple
                                                    size="@multiSelectSize"
                                                    form="@filterFormId"
                                                    onchange="@filterSubmitScript">
                                                @foreach (var option in filter.Options)
                                                {
                                                    <option value="@option.Value" selected="@selectedValueSet.Contains(option.Value)">@option.Label</option>
                                                }
                                            </select>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </th>
                }

                @if (hasRowActions)
                {
                    <th class="text-end">@Model.Actions.ActionColumnTitle</th>
                }
            </tr>
        </thead>
        <tbody>
        @if (Model.Rows.Count == 0)
        {
            <tr>
                <td colspan="@(Model.Columns.Count + (hasRowActions ? 1 : 0))" class="text-center text-muted py-4">@Model.EmptyMessage</td>
            </tr>
        }
        else
        {
            foreach (var row in Model.Rows)
            {
                var rowActions = row.Actions;

                <tr>
                @for (var index = 0; index < Model.Columns.Count; index++)
                {
                    var column = Model.Columns[index];
                    var cell = index < row.Cells.Count ? row.Cells[index] : null;
                    var cellClasses = string.Join(" ", new[] { column.CellClass, cell?.CellClass }.Where(x => !string.IsNullOrWhiteSpace(x)));

                    <td class="@cellClasses">
                        @if (cell?.Html is not null)
                        {
                            @cell.Html
                        }
                        else
                        {
                            @cell?.Text
                        }
                    </td>
                }

                @if (hasRowActions)
                {
                    var deleteConfirmMessage = rowActions?.DeleteConfirmMessage ?? Model.Actions.DeleteConfirmMessage;
                    var encodedDeleteConfirmMessage = JavaScriptEncoder.Default.Encode(deleteConfirmMessage);

                    <td class="text-end">
                        @if (HasRowActions(rowActions))
                        {
                            <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                @if (!string.IsNullOrWhiteSpace(rowActions?.DetailUrl))
                                {
                                    <a class="btn btn-sm btn-outline-secondary" href="@rowActions.DetailUrl">@Model.Actions.DetailButtonText</a>
                                }

                                @if (!string.IsNullOrWhiteSpace(rowActions?.EditUrl))
                                {
                                    <a class="btn btn-sm btn-outline-primary" href="@rowActions.EditUrl">@Model.Actions.EditButtonText</a>
                                }

                                @if (!string.IsNullOrWhiteSpace(rowActions?.DeleteUrl))
                                {
                                    <form method="post" action="@rowActions.DeleteUrl" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('@encodedDeleteConfirmMessage')">@Model.Actions.DeleteButtonText</button>
                                    </form>
                                }
                            </div>
                        }
                    </td>
                }
                </tr>
            }
        }
        </tbody>
    </table>
</div>

<div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mt-3">
    <form method="get" class="d-flex align-items-center gap-2">
        @foreach (var route in pageSizeFormRouteValues)
        {
            if (string.Equals(route.Key, Model.PageSizeQueryKey, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            <input type="hidden" name="@route.Key" value="@route.Value" />
        }

        <label class="form-label mb-0" for="@pageSizeSelectId">Page</label>
        <select id="@pageSizeSelectId" class="form-select form-select-sm w-auto" name="@Model.PageSizeQueryKey" onchange="this.form.submit()">
            @foreach (var size in pageSizeOptions)
            {
                <option value="@size" selected="@(safePageSize == size)">@size</option>
            }
        </select>
    </form>

    @if (safeTotalPages > 1)
    {
        var previousRouteValues = BuildRouteValues(page: Math.Max(safePage - 1, 1).ToString(CultureInfo.InvariantCulture));
        var nextRouteValues = BuildRouteValues(page: Math.Min(safePage + 1, safeTotalPages).ToString(CultureInfo.InvariantCulture));

        <nav aria-label="Page navigation">
            <ul class="pagination mb-0">
                <li class="page-item @(safePage <= 1 ? "disabled" : string.Empty)">
                    <a class="page-link" asp-all-route-data="previousRouteValues">Previous</a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link">Page @safePage of @safeTotalPages</span>
                </li>
                <li class="page-item @(safePage >= safeTotalPages ? "disabled" : string.Empty)">
                    <a class="page-link" asp-all-route-data="nextRouteValues">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>



