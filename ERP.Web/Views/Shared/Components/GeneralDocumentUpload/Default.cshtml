@model ERP.Web.ViewModels.Document.GeneralDocumentUploadViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var accept = string.Join(",", Model.AllowedExtensions);
    var maxSizeMb = Model.MaxFileSizeBytes / (1024 * 1024);
    var isFieldRequired = Model.IsRequired && !Model.HasExistingDocuments;
    var fieldLabel = Model.AllowMultiple ? T["Files"] : T["File"];

    var modelState = ViewData.ModelState.ContainsKey(Model.FileFieldName) ? ViewData.ModelState[Model.FileFieldName] : null;
    var modelStateError = modelState != null && modelState.Errors.Count > 0 ? modelState.Errors[0].ErrorMessage : null;
    var hasError = !string.IsNullOrWhiteSpace(modelStateError);
    var requiredMessage = string.Format(T["{0} is required."], fieldLabel);

    var input = new TagBuilder("input");
    input.TagRenderMode = TagRenderMode.SelfClosing;
    input.Attributes["type"] = "file";
    input.Attributes["name"] = Model.FileFieldName;
    input.AddCssClass(hasError ? "form-control is-invalid" : "form-control");
    if (Model.AllowMultiple)
    {
        input.Attributes["multiple"] = "multiple";
    }
    input.Attributes["accept"] = accept;
    if (isFieldRequired)
    {
        input.Attributes["data-val"] = "true";
        input.Attributes["data-val-required"] = requiredMessage;
    }

    using var writer = new System.IO.StringWriter();
    input.WriteTo(writer, System.Text.Encodings.Web.HtmlEncoder.Default);
    var inputHtml = writer.ToString();
}

<div class="col-12">
    <hr />
    <h2 class="h6">@T["Attachment"]</h2>
</div>

<div class="col-md-7">
    <label class="form-label">
        @fieldLabel
        @if (isFieldRequired)
        {
            <span class="text-danger">*</span>
        }
    </label>
    @Html.Raw(inputHtml)
    <span class="@(hasError ? "text-danger field-validation-error" : "text-danger field-validation-valid")"
          data-valmsg-for="@Model.FileFieldName"
          data-valmsg-replace="true">@modelStateError</span>
    <div class="form-text">
        @T["Max"] @maxSizeMb MB
        @if (Model.AllowMultiple)
        {
            <text>&middot; @T["up to"] @Model.MaxFileCount @T["file(s)"]</text>
        }
        &middot; @accept
    </div>
</div>

<div class="col-md-5">
    <label class="form-label">@T["Note"]</label>
    <input type="text" name="@Model.NoteFieldName" class="form-control" value="@Model.NoteValue" maxlength="500" />
</div>
