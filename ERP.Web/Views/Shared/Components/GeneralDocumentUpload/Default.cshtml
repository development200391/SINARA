@model ERP.Web.ViewModels.Document.GeneralDocumentUploadViewModel

<div class="col-12">
    <hr />
    <h2 class="h6">@T["Attachment"]</h2>
</div>

@for (var i = 0; i < Model.Slots.Count; i++)
{
    var slot = Model.Slots[i];
    var isFieldRequired = slot.IsRequired && !Model.HasExistingDocuments;
    var accept = string.Join(",", slot.AllowedExtensions);
    var maxSizeMb = slot.MaxFileSizeBytes / (1024 * 1024);
    var inputId = $"{Model.FileFieldName}_{i}";
    var requiredMessage = string.Format(T["{0} is required."], slot.Name);

    <div class="col-md-7">
        <label class="form-label" for="@inputId">
            @slot.Name
            @if (isFieldRequired)
            {
                <span class="text-danger">*</span>
            }
        </label>
        @* IFormFile-collection binding (FormFileModelBinder) matches parts by the
           exact literal field name, not by indexed "Name[i]" like other collection
           types — every slot input must share this same name to actually bind into
           List<IFormFile> AttachmentFiles server-side. *@
        <input type="file"
               id="@inputId"
               name="@Model.FileFieldName"
               class="form-control"
               accept="@accept"
               data-val="@(isFieldRequired ? "true" : null)"
               data-val-required="@(isFieldRequired ? requiredMessage : null)" />
        <span class="text-danger field-validation-valid" data-valmsg-for="@Model.FileFieldName" data-valmsg-replace="true"></span>
        <div class="form-text">@T["Max"] @maxSizeMb MB &middot; @accept</div>
    </div>
}

<div class="col-md-5">
    <label class="form-label">@T["Note"]</label>
    <input type="text" name="@Model.NoteFieldName" class="form-control" value="@Model.NoteValue" maxlength="500" />
</div>
