@model ERP.Web.ViewModels.Shared.FormIconPickerViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var inputId = string.IsNullOrWhiteSpace(Model.Id) ? Model.Name : Model.Id;
    var previewId = $"{inputId}-icon-preview";
    var modalId = $"{inputId}-icon-modal";
    var modalLabelId = $"{modalId}-label";
    var modelState = ViewData.ModelState.ContainsKey(Model.Name) ? ViewData.ModelState[Model.Name] : null;
    var modelStateError = modelState != null && modelState.Errors.Count > 0 ? modelState.Errors[0].ErrorMessage : null;
    var errorMessage = !string.IsNullOrWhiteSpace(Model.Error) ? Model.Error : modelStateError;
    var hasError = !string.IsNullOrWhiteSpace(errorMessage);
    var requiredMessage = string.Format(T["{0} is required."], Model.Label);
    var currentValue = string.IsNullOrWhiteSpace(Model.Value) ? string.Empty : Model.Value.Trim();
    var previewClass = string.IsNullOrWhiteSpace(currentValue) ? "bi-question-square" : currentValue;

    var input = new TagBuilder("input");
    input.TagRenderMode = TagRenderMode.SelfClosing;
    input.Attributes["type"] = "text";
    input.Attributes["id"] = inputId;
    input.Attributes["name"] = Model.Name;
    input.Attributes["autocomplete"] = "off";
    input.Attributes["data-icon-picker-text-input"] = "true";
    input.Attributes["data-preview-for"] = $"#{previewId}";
    input.AddCssClass(hasError ? "form-control is-invalid" : "form-control");
    if (!string.IsNullOrEmpty(Model.Value))
    {
        input.Attributes["value"] = Model.Value;
    }
    if (!string.IsNullOrWhiteSpace(Model.Placeholder))
    {
        input.Attributes["placeholder"] = Model.Placeholder;
    }
    if (Model.IsRequired)
    {
        input.Attributes["required"] = "required";
        input.Attributes["data-val"] = "true";
        input.Attributes["data-val-required"] = requiredMessage;
    }
    input.Attributes["aria-label"] = Model.Label;
    input.Attributes["aria-invalid"] = hasError ? "true" : "false";
    if (hasError)
    {
        input.Attributes["aria-describedby"] = $"{inputId}-error";
    }
    if (Model.HtmlAttributes != null)
    {
        foreach (var attr in Model.HtmlAttributes)
        {
            input.Attributes[attr.Key] = attr.Value;
        }
    }

    using var writer = new System.IO.StringWriter();
    input.WriteTo(writer, System.Text.Encodings.Web.HtmlEncoder.Default);
    var inputHtml = writer.ToString();
}

<div class="sinara-form-field @(hasError ? "error" : "")">
    @if (!string.IsNullOrWhiteSpace(Model.Label))
    {
        <label for="@inputId" class="form-label">
            @Model.Label
            @if (Model.IsRequired)
            {
                <span class="text-danger">*</span>
            }
        </label>
    }

    <div class="input-group">
        <span class="input-group-text" id="@previewId">
            <i class="bi @previewClass" aria-hidden="true"></i>
        </span>
        @Html.Raw(inputHtml)
        <button type="button" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#@modalId">
            <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>
            <span>@T["Choose Icon"]</span>
        </button>
    </div>

    <span class="@(hasError ? "text-danger field-validation-error" : "text-danger field-validation-valid")"
          id="@(inputId)-error"
          data-valmsg-for="@Model.Name"
          data-valmsg-replace="true">@errorMessage</span>
</div>

<div class="modal fade sinara-icon-picker-modal" id="@modalId" tabindex="-1" aria-labelledby="@modalLabelId" aria-hidden="true"
     data-icon-picker-input="#@inputId" data-icon-picker-preview="#@previewId">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="@modalLabelId">@T["Choose Icon"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="search" class="form-control mb-3" placeholder="@T["Search icon..."]" autocomplete="off" data-icon-picker-search />
                <div class="d-flex flex-wrap gap-2 sinara-icon-picker-grid" data-icon-picker-grid></div>
                <div class="text-muted small mt-2 d-none" data-icon-picker-empty>@T["No matching icon."]</div>
            </div>
        </div>
    </div>
</div>

<script>
