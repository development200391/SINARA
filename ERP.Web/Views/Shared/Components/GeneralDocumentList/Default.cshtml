@model ERP.Web.ViewModels.Document.GeneralDocumentListViewModel

@if (Model.Documents.Count == 0)
{
    <p class="text-muted mb-0">@T[Model.EmptyMessage]</p>
}
else
{
    <ul class="list-group">
        @foreach (var doc in Model.Documents)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    @if (Model.DownloadUrl is not null)
                    {
                        <a href="@Model.DownloadUrl(doc.Id)">@doc.OriginalFileName</a>
                    }
                    else
                    {
                        <span>@doc.OriginalFileName</span>
                    }
                    <div class="small text-muted">
                        @((doc.FileSizeBytes / 1024.0).ToString("N0")) KB &middot;
                        @doc.UploadedByName, @doc.UploadedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        @if (!string.IsNullOrWhiteSpace(doc.Description))
                        {
                            <text> &middot; @doc.Description</text>
                        }
                    </div>
                </div>
                @if (Model.DeleteUrl is not null)
                {
                    <form action="@Model.DeleteUrl(doc.Id)" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('@T[Model.DeleteConfirmMessage]')">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        </button>
                    </form>
                }
            </li>
        }
    </ul>
}
