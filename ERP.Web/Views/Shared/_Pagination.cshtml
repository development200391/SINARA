@{
    var currentPage = ViewData["Page"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
}

@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination">
            <li class="page-item @(currentPage <= 1 ? "disabled" : string.Empty)">
                <a class="page-link" href="?page=@(currentPage - 1)">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @currentPage of @totalPages</span></li>
            <li class="page-item @(currentPage >= totalPages ? "disabled" : string.Empty)">
                <a class="page-link" href="?page=@(currentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
