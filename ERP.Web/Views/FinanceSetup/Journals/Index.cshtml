@model ERP.Web.ViewModels.Finance.FinanceJournalsIndexViewModel
@using ERP.Domain.Enums
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Journals"]</h1>

        @{
            var selectedSource = Model.SourceFilter.HasValue
                ? ((int)Model.SourceFilter.Value).ToString(CultureInfo.InvariantCulture)
                : null;

            var selectedStatus = Model.StatusFilter.HasValue
                ? ((int)Model.StatusFilter.Value).ToString(CultureInfo.InvariantCulture)
                : null;

            var selectedPeriod = Model.PeriodIdFilter?.ToString(CultureInfo.InvariantCulture);

            var sourceOptions = Enum.GetValues<FinanceJournalSource>()
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = ((int)x).ToString(CultureInfo.InvariantCulture),
                    Label = T[x.ToString()]
                })
                .ToList();

            var statusOptions = Enum.GetValues<FinanceJournalStatus>()
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = ((int)x).ToString(CultureInfo.InvariantCulture),
                    Label = T[x.ToString()]
                })
                .ToList();

            var periodOptions = Model.PeriodOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            string BuildStatusBadge(FinanceJournalStatus value)
            {
                return value switch
                {
                    FinanceJournalStatus.Posted => "<span class=\"badge text-bg-success\">Posted</span>",
                    FinanceJournalStatus.Reversed => "<span class=\"badge text-bg-secondary\">Reversed</span>",
                    _ => "<span class=\"badge text-bg-warning\">Draft</span>"
                };
            }

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "journalno",
                        Title = T["Journal No"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "journalNo",
                            Value = Model.JournalNoFilter,
                            Placeholder = T["Journal No"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "date",
                        Title = T["Date"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.DateRange,
                            QueryKey = "dateFrom",
                            QueryKeyTo = "dateTo",
                            Value = Model.DateFromFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            ValueTo = Model.DateToFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "description",
                        Title = T["Description"],
                        Sortable = false
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "periodname",
                        Title = T["Period"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "periodId",
                            Value = selectedPeriod,
                            EmptyOptionLabel = T["All"],
                            Options = periodOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "source",
                        Title = T["Source"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "source",
                            Value = selectedSource,
                            EmptyOptionLabel = T["All"],
                            Options = sourceOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "status",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "status",
                            Value = selectedStatus,
                            EmptyOptionLabel = T["All"],
                            Options = statusOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "currency",
                        Title = T["Currency"],
                        Sortable = false
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "debit",
                        Title = T["Debit"],
                        Sortable = false,
                        CellClass = "text-end"
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "credit",
                        Title = T["Credit"],
                        Sortable = false,
                        CellClass = "text-end"
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "postedat",
                        Title = T["Posted At"],
                        Sortable = true
                    }
                ],
                Rows = Model.Items.Items.Select(item =>
                {
                    var isDraft = item.Status == FinanceJournalStatus.Draft;
                    var isPosted = item.Status == FinanceJournalStatus.Posted;

                    return new PagedGridRowViewModel
                    {
                        Cells =
                        [
                            new PagedGridCellViewModel { Text = item.JournalNo },
                            new PagedGridCellViewModel { Text = item.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) },
                            new PagedGridCellViewModel { Text = item.Description },
                            new PagedGridCellViewModel { Text = item.PeriodName },
                            new PagedGridCellViewModel { Text = T[item.Source.ToString()] },
                            new PagedGridCellViewModel { Html = new HtmlString(BuildStatusBadge(item.Status)) },
                            new PagedGridCellViewModel { Text = item.CurrencyCode },
                            new PagedGridCellViewModel { Text = item.TotalDebitBase.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                            new PagedGridCellViewModel { Text = item.TotalCreditBase.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                            new PagedGridCellViewModel { Text = item.PostedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) ?? "-" }
                        ],
                        Actions = new PagedGridRowActionViewModel
                        {
                            EditUrl = isDraft ? Url.Action("EditJournal", "FinanceSetup", new { id = item.Id }) : null,
                            ApproveUrl = isDraft ? Url.Action("PostJournal", "FinanceSetup", new { id = item.Id }) : null,
                            RejectUrl = isPosted ? Url.Action("ReverseJournal", "FinanceSetup", new { id = item.Id }) : null,
                            ApproveConfirmMessage = T["Post this journal?"],
                            RejectConfirmMessage = T["Reverse this journal?"]
                        }
                    };
                }).ToList(),
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " journals",
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateJournal", "FinanceSetup"),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    ApproveButtonText = T["Post"],
                    RejectButtonText = T["Reverse"],
                    ApproveConfirmMessage = T["Post this journal?"],
                    RejectConfirmMessage = T["Reverse this journal?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
