@model ERP.Web.ViewModels.Finance.FinanceExchangeRateCreateViewModel
@using ERP.Web.ViewModels.Shared

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Create"] @T["Exchange Rates"]</h1>

        <form method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-md-4">
                <label asp-for="FromCurrencyCode" class="form-label">@T["From Currency"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.FromCurrencyCode),
                    Id = Html.IdFor(x => x.FromCurrencyCode).ToString(),
                    CssClass = "form-select",
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.FromCurrencyCode,
                    Options = Model.CurrencyOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Code,
                        Label = option.Label
                    }).ToList()
                })
                <span asp-validation-for="FromCurrencyCode" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="ToCurrencyCode" class="form-label">@T["To Currency"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.ToCurrencyCode),
                    Id = Html.IdFor(x => x.ToCurrencyCode).ToString(),
                    CssClass = "form-select",
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.ToCurrencyCode,
                    Options = Model.CurrencyOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Code,
                        Label = option.Label
                    }).ToList()
                })
                <span asp-validation-for="ToCurrencyCode" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Rate" class="form-label"></label>
                <input asp-for="Rate" class="form-control" type="number" min="0" step="0.000001" />
                <span asp-validation-for="Rate" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="EffectiveDate" class="form-label">@T["Effective Date"]</label>
                <input asp-for="EffectiveDate" class="form-control" type="date" />
                <span asp-validation-for="EffectiveDate" class="text-danger"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="Source" class="form-label"></label>
                <input asp-for="Source" class="form-control" />
                <span asp-validation-for="Source" class="text-danger"></span>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a asp-action="ExchangeRates" class="btn btn-outline-secondary">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
