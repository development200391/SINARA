@model ERP.Web.ViewModels.Finance.FinanceCostCenterEditViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<form method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-4">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="DepartmentId" class="form-label">@T["Department"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.DepartmentId),
            Id = Html.IdFor(x => x.DepartmentId).ToString(),
            CssClass = "form-select",
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All"],
            SelectedValue = Model.DepartmentId.HasValue
                ? Model.DepartmentId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.DepartmentOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ManagerId" class="form-label">@T["Manager"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.ManagerId),
            Id = Html.IdFor(x => x.ManagerId).ToString(),
            CssClass = "form-select",
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All"],
            SelectedValue = Model.ManagerId.HasValue
                ? Model.ManagerId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.ManagerOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="ManagerId" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="BudgetAccountId" class="form-label">@T["Budget Account"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.BudgetAccountId),
            Id = Html.IdFor(x => x.BudgetAccountId).ToString(),
            CssClass = "form-select",
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All"],
            SelectedValue = Model.BudgetAccountId.HasValue
                ? Model.BudgetAccountId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.BudgetAccountOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="BudgetAccountId" class="text-danger"></span>
    </div>

    <div class="col-12">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsActive),
            Id = Html.IdFor(x => x.IsActive).ToString(),
            Label = T["Active"],
            Checked = Model.IsActive
        })
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@T["common.save"]</button>
        <a asp-action="CostCenters" class="btn btn-outline-secondary">@T["common.cancel"]</a>
    </div>
</form>
