@model ERP.Web.ViewModels.Finance.FinanceApAgingIndexViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["AP Aging"]</h1>

        @{
            var selectedVendorId = Model.VendorIdFilter?.ToString(CultureInfo.InvariantCulture);

            var vendorOptions = Model.VendorOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "asofdate",
                        Title = T["As Of Date"],
                        Sortable = false,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.DatePicker,
                            QueryKey = "asOfDate",
                            Value = Model.AsOfDateFilter.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            Placeholder = T["As Of Date"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "vendorcode",
                        Title = T["Vendor Code"],
                        Sortable = true
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "vendorname",
                        Title = T["Vendor"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "vendorId",
                            Value = selectedVendorId,
                            EmptyOptionLabel = T["All"],
                            Options = vendorOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "currentamount",
                        Title = T["Current"],
                        Sortable = true,
                        CellClass = "text-end"
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "bucket1to30",
                        Title = T["1-30 Days"],
                        Sortable = true,
                        CellClass = "text-end"
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "bucket31to60",
                        Title = T["31-60 Days"],
                        Sortable = true,
                        CellClass = "text-end"
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "bucket61to90",
                        Title = T["61-90 Days"],
                        Sortable = true,
                        CellClass = "text-end"
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "bucketover90",
                        Title = T[">90 Days"],
                        Sortable = true,
                        CellClass = "text-end"
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "totaloutstanding",
                        Title = T["Total Outstanding"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "outstandingMin",
                            QueryKeyTo = "outstandingMax",
                            Value = Model.OutstandingMinFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.OutstandingMaxFilter?.ToString(CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "oldest",
                        Title = T["Oldest Invoice Date"],
                        Sortable = false
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "latestdue",
                        Title = T["Latest Due Date"],
                        Sortable = false
                    }
                ],
                Rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = Model.AsOfDateFilter.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) },
                        new PagedGridCellViewModel { Text = item.VendorCode },
                        new PagedGridCellViewModel { Text = item.VendorName },
                        new PagedGridCellViewModel { Text = item.CurrentAmount.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = item.Bucket1To30.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = item.Bucket31To60.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = item.Bucket61To90.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = item.BucketOver90.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = item.TotalOutstanding.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = item.OldestInvoiceDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "-" },
                        new PagedGridCellViewModel { Text = item.LatestDueDate?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "-" }
                    ]
                }).ToList(),
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["AP Aging"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
