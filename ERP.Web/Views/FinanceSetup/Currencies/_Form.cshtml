@model ERP.Web.ViewModels.Finance.FinanceCurrencyEditViewModel

<form method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Symbol" class="form-label"></label>
        <input asp-for="Symbol" class="form-control" />
        <span asp-validation-for="Symbol" class="text-danger"></span>
    </div>

    <div class="col-md-3 form-check mt-2">
        <input asp-for="IsBaseCurrency" class="form-check-input" />
        <label asp-for="IsBaseCurrency" class="form-check-label"></label>
    </div>

    <div class="col-md-3 form-check mt-2">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@T["common.save"]</button>
        <a asp-action="Currencies" class="btn btn-outline-secondary">@T["common.cancel"]</a>
    </div>
</form>
