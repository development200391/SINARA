@model ERP.Web.ViewModels.Finance.FinanceApPaymentCreateViewModel
@using ERP.Domain.Enums
@using ERP.Web.ViewModels.Shared
@using System.Globalization

@{
    var initialApplications = Model.Applications.ToList();
    if (initialApplications.Count == 0)
    {
        initialApplications.Add(new ERP.Web.ViewModels.Finance.FinanceApPaymentApplicationEditViewModel());
    }

    const string vendorSelectId = "ap-payment-vendor";

    var invoiceOptions = Model.OutstandingInvoiceOptions.Select(option => new SearchableSelectOptionViewModel
    {
        Value = option.InvoiceId.ToString(CultureInfo.InvariantCulture),
        Label = option.Label,
        GroupValue = option.VendorId.ToString(CultureInfo.InvariantCulture)
    }).ToList();
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Create"] @T["AP Payment"]</h1>

        <form method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-md-4">
                <label asp-for="VendorId" class="form-label">@T["Vendor"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.VendorId),
                    Id = vendorSelectId,
                    CssClass = "form-select",
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.VendorId > 0
                        ? Model.VendorId.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.VendorOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Label
                    }).ToList()
                })
                <span asp-validation-for="VendorId" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="PaymentDate" class="form-label">@T["Payment Date"]</label>
                <input asp-for="PaymentDate" class="form-control" type="date" />
                <span asp-validation-for="PaymentDate" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="PaymentMethod" class="form-label">@T["Payment Method"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.PaymentMethod),
                    Id = Html.IdFor(x => x.PaymentMethod).ToString(),
                    CssClass = "form-select",
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.PaymentMethod.ToString(),
                    Options = Enum.GetValues<FinanceApPaymentMethod>().Select(method => new SearchableSelectOptionViewModel
                    {
                        Value = method.ToString(),
                        Label = T[method.ToString()]
                    }).ToList()
                })
                <span asp-validation-for="PaymentMethod" class="text-danger"></span>
            </div>

            <div class="col-md-2">
                <label asp-for="Amount" class="form-label">@T["Amount"]</label>
                <input asp-for="Amount" class="form-control text-end" type="number" min="0.0001" step="0.0001" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="BankAccountId" class="form-label">@T["Bank Account"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.BankAccountId),
                    Id = Html.IdFor(x => x.BankAccountId).ToString(),
                    CssClass = "form-select",
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.BankAccountId > 0
                        ? Model.BankAccountId.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.BankAccountOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Label
                    }).ToList()
                })
                <span asp-validation-for="BankAccountId" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="ReferenceNo" class="form-label">@T["Reference No"]</label>
                <input asp-for="ReferenceNo" class="form-control" />
                <span asp-validation-for="ReferenceNo" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Notes" class="form-label">@T["Notes"]</label>
                <input asp-for="Notes" class="form-control" />
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 mb-0">@T["Applications"]</h2>
                    <button type="button" id="add-ap-payment-app" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                        <i class="bi bi-plus-circle" aria-hidden="true"></i>
                        <span>@T["Add Line"]</span>
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width:48px;">#</th>
                                <th>@T["Invoice"]</th>
                                <th class="text-end" style="width:200px;">@T["Applied Amount"]</th>
                                <th class="text-end" style="width:72px;">@T["Action"]</th>
                            </tr>
                        </thead>
                        <tbody id="ap-payment-apps-body">
                            @for (var index = 0; index < initialApplications.Count; index++)
                            {
                                var application = initialApplications[index];

                                <tr class="ap-payment-app-row">
                                    <td class="line-no">@(index + 1)</td>
                                    <td>
                                        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                                        {
                                            Name = $"Applications[{index}].InvoiceId",
                                            Id = $"Applications_{index}__InvoiceId",
                                            CssClass = "form-select form-select-sm",
                                            SearchPlaceholder = T["Search"],
                                            EmptyOptionLabel = T["Select Invoice"],
                                            DependsOnElementId = vendorSelectId,
                                            SelectedValue = application.InvoiceId > 0
                                                ? application.InvoiceId.ToString(CultureInfo.InvariantCulture)
                                                : null,
                                            Options = invoiceOptions,
                                            HtmlAttributes = new Dictionary<string, string> { ["data-field"] = "InvoiceId" }
                                        })
                                    </td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm text-end ap-payment-applied" data-field="AppliedAmount" min="0.0001" step="0.0001" value="@application.AppliedAmount.ToString(CultureInfo.InvariantCulture)" />
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-ap-payment-app" title="@T["Delete"]">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="2" class="text-end">@T["Total Applied"]</th>
                                <th id="ap-payment-total-applied" class="text-end">0.00</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a asp-action="ApPayments" class="btn btn-outline-secondary">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>

<template id="ap-payment-app-template">
    <tr class="ap-payment-app-row">
        <td class="line-no"></td>
        <td>
            @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
            {
                Name = string.Empty,
                Id = "ap-payment-app-template-invoice",
                CssClass = "form-select form-select-sm",
                SearchPlaceholder = T["Search"],
                EmptyOptionLabel = T["Select Invoice"],
                DependsOnElementId = vendorSelectId,
                Options = invoiceOptions,
                HtmlAttributes = new Dictionary<string, string> { ["data-field"] = "InvoiceId" }
            })
        </td>
        <td>
            <input type="number" class="form-control form-control-sm text-end ap-payment-applied" data-field="AppliedAmount" min="0.0001" step="0.0001" value="0" />
        </td>
        <td class="text-end">
            <button type="button" class="btn btn-sm btn-outline-danger remove-ap-payment-app" title="@T["Delete"]">
                <i class="bi bi-trash" aria-hidden="true"></i>
            </button>
        </td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const vendorSelect = document.getElementById('@vendorSelectId');
            const body = document.getElementById('ap-payment-apps-body');
            const addButton = document.getElementById('add-ap-payment-app');
            const template = document.getElementById('ap-payment-app-template');
            const totalAppliedEl = document.getElementById('ap-payment-total-applied');

            if (!vendorSelect || !body || !template) {
                return;
            }

            const parseNumber = (value) => {
                const parsed = Number.parseFloat(value);
                return Number.isFinite(parsed) ? parsed : 0;
            };

            const formatNumber = (value) => value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            const recalc = () => {
                let totalApplied = 0;
                body.querySelectorAll('.ap-payment-applied').forEach((input) => {
                    totalApplied += parseNumber(input.value);
                });

                if (totalAppliedEl) {
                    totalAppliedEl.textContent = formatNumber(totalApplied);
                }
            };

            const renumber = () => {
                const rows = body.querySelectorAll('.ap-payment-app-row');
                rows.forEach((row, index) => {
                    const lineNo = row.querySelector('.line-no');
                    if (lineNo) {
                        lineNo.textContent = String(index + 1);
                    }

                    row.querySelectorAll('[data-field]').forEach((control) => {
                        const field = control.getAttribute('data-field');
                        if (!field) return;
                        control.setAttribute('name', `Applications[${index}].${field}`);
                        control.setAttribute('id', `Applications_${index}__${field}`);
                    });
                });

                recalc();
            };

            addButton?.addEventListener('click', () => {
                const row = template.content.firstElementChild?.cloneNode(true);
                if (!row) return;
                body.appendChild(row);
                renumber();

                // Re-apply the current vendor filter to the newly added invoice select.
                vendorSelect.dispatchEvent(new Event('change'));
            });

            body.addEventListener('click', (event) => {
                const target = event.target;
                if (!(target instanceof Element)) return;

                const removeButton = target.closest('.remove-ap-payment-app');
                if (!removeButton) return;

                const rows = body.querySelectorAll('.ap-payment-app-row');
                if (rows.length <= 1) {
                    return;
                }

                const row = removeButton.closest('.ap-payment-app-row');
                row?.remove();
                renumber();
            });

            body.addEventListener('input', (event) => {
                const target = event.target;
                if (!(target instanceof HTMLInputElement)) return;

                if (target.classList.contains('ap-payment-applied')) {
                    recalc();
                }
            });

            renumber();
        })();
    </script>
}
