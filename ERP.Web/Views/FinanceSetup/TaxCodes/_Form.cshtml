@model ERP.Web.ViewModels.Finance.FinanceTaxCodeEditViewModel
@using ERP.Domain.Enums
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<form method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>

    <div class="col-md-5">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Type" class="form-label"></label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.Type),
            Id = Html.IdFor(x => x.Type).ToString(),
            CssClass = "form-select",
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.Type.ToString(),
            Options = Html.GetEnumSelectList<FinanceTaxType>().Select(item => new SearchableSelectOptionViewModel
            {
                Value = item.Value,
                Label = item.Text
            }).ToList()
        })
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Rate" class="form-label"></label>
        <input asp-for="Rate" class="form-control" type="number" min="0" max="100" step="0.01" />
        <span asp-validation-for="Rate" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="AccountId" class="form-label">@T["Account"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.AccountId),
            Id = Html.IdFor(x => x.AccountId).ToString(),
            CssClass = "form-select",
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.AccountId > 0
                ? Model.AccountId.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.AccountOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="AccountId" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsInclusive),
            Id = Html.IdFor(x => x.IsInclusive).ToString(),
            Label = T["Inclusive"],
            Checked = Model.IsInclusive
        })
    </div>

    <div class="col-md-3">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsActive),
            Id = Html.IdFor(x => x.IsActive).ToString(),
            Label = T["Active"],
            Checked = Model.IsActive
        })
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@T["common.save"]</button>
        <a asp-action="TaxCodes" class="btn btn-outline-secondary">@T["common.cancel"]</a>
    </div>
</form>
