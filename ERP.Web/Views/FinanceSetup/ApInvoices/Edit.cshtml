@model ERP.Web.ViewModels.Finance.FinanceApInvoiceEditViewModel

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Edit"] @T["AP Invoice"]</h1>

        <form method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <partial name="ApInvoices/_Form" model="Model" />

            <div class="col-12 d-flex gap-2">
                @if (!Model.IsReadOnly)
                {
                    <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                }
                <a asp-action="ApInvoices" class="btn btn-outline-secondary">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
