@model ERP.Web.ViewModels.Finance.FinanceBudgetEditViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

@{
    var numberCulture = string.Equals(T.CurrentLanguage, "id", StringComparison.OrdinalIgnoreCase)
        ? CultureInfo.GetCultureInfo("id-ID")
        : CultureInfo.GetCultureInfo("en-US");

    SearchableSelectOptionViewModel ToOption(ERP.Web.ViewModels.Finance.FinanceIdOptionViewModel option) => new()
    {
        Value = option.Id.ToString(CultureInfo.InvariantCulture),
        Label = option.Label
    };
}

@if (Model.Id.HasValue)
{
    <input asp-for="Id" type="hidden" />
}

<div class="col-md-3">
    <label asp-for="BudgetNo" class="form-label">@T["Budget No"]</label>
    <input asp-for="BudgetNo" class="form-control" />
    <span asp-validation-for="BudgetNo" class="text-danger"></span>
</div>

<div class="col-md-5">
    <label asp-for="Name" class="form-label">@T["Name"]</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="col-md-2">
    <label asp-for="CurrencyCode" class="form-label">@T["Currency"]</label>
    @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
    {
        Name = nameof(Model.CurrencyCode),
        Id = Html.IdFor(x => x.CurrencyCode).ToString(),
        CssClass = "form-select",
        SearchPlaceholder = T["Search"],
        EmptyOptionLabel = T["Select"],
        SelectedValue = Model.CurrencyCode,
        Options = Model.CurrencyOptions.Select(option => new SearchableSelectOptionViewModel
        {
            Value = option.Code,
            Label = option.Label
        }).ToList()
    })
    <span asp-validation-for="CurrencyCode" class="text-danger"></span>
</div>

<div class="col-md-2">
    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
    {
        Name = nameof(Model.IsActive),
        Id = Html.IdFor(x => x.IsActive).ToString(),
        Label = T["Active"],
        Checked = Model.IsActive
    })
</div>

<div class="col-md-4">
    <label asp-for="FiscalYearId" class="form-label">@T["Fiscal Year"]</label>
    @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
    {
        Name = nameof(Model.FiscalYearId),
        Id = Html.IdFor(x => x.FiscalYearId).ToString(),
        CssClass = "form-select",
        SearchPlaceholder = T["Search"],
        EmptyOptionLabel = T["Select"],
        SelectedValue = Model.FiscalYearId > 0
            ? Model.FiscalYearId.ToString(CultureInfo.InvariantCulture)
            : null,
        Options = Model.FiscalYearOptions.Select(ToOption).ToList()
    })
    <span asp-validation-for="FiscalYearId" class="text-danger"></span>
</div>

<div class="col-md-4">
    <label asp-for="PeriodId" class="form-label">@T["Period"]</label>
    @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
    {
        Name = nameof(Model.PeriodId),
        Id = Html.IdFor(x => x.PeriodId).ToString(),
        CssClass = "form-select",
        SearchPlaceholder = T["Search"],
        EmptyOptionLabel = T["None"],
        SelectedValue = Model.PeriodId.HasValue
            ? Model.PeriodId.Value.ToString(CultureInfo.InvariantCulture)
            : null,
        Options = Model.PeriodOptions.Select(ToOption).ToList()
    })
    <span asp-validation-for="PeriodId" class="text-danger"></span>
</div>

<div class="col-md-4">
    <label asp-for="CostCenterId" class="form-label">@T["Cost Center"]</label>
    @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
    {
        Name = nameof(Model.CostCenterId),
        Id = Html.IdFor(x => x.CostCenterId).ToString(),
        CssClass = "form-select",
        SearchPlaceholder = T["Search"],
        EmptyOptionLabel = T["None"],
        SelectedValue = Model.CostCenterId.HasValue
            ? Model.CostCenterId.Value.ToString(CultureInfo.InvariantCulture)
            : null,
        Options = Model.CostCenterOptions.Select(ToOption).ToList()
    })
    <span asp-validation-for="CostCenterId" class="text-danger"></span>
</div>

<div class="col-md-6">
    <label asp-for="AccountId" class="form-label">@T["Account"]</label>
    @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
    {
        Name = nameof(Model.AccountId),
        Id = Html.IdFor(x => x.AccountId).ToString(),
        CssClass = "form-select",
        SearchPlaceholder = T["Search"],
        EmptyOptionLabel = T["None"],
        SelectedValue = Model.AccountId.HasValue
            ? Model.AccountId.Value.ToString(CultureInfo.InvariantCulture)
            : null,
        Options = Model.AccountOptions.Select(ToOption).ToList()
    })
    <span asp-validation-for="AccountId" class="text-danger"></span>
</div>

<div class="col-md-6">
    <label asp-for="Notes" class="form-label">@T["Notes"]</label>
    <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
    <span asp-validation-for="Notes" class="text-danger"></span>
</div>

<div class="col-12">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="h6 mb-0">@T["Budget Lines"]</h2>
        <button type="button" id="add-budget-line" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
            <i class="bi bi-plus-circle" aria-hidden="true"></i>
            <span>@T["Add Line"]</span>
        </button>
    </div>

    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th style="width:48px;">#</th>
                    <th style="width:180px;">@T["Period"]</th>
                    <th style="width:220px;">@T["Account"]</th>
                    <th style="width:200px;">@T["Cost Center"]</th>
                    <th>@T["Description"]</th>
                    <th style="width:170px;" class="text-end">@T["Amount"]</th>
                    <th style="width:64px;" class="text-end">@T["Action"]</th>
                </tr>
            </thead>
            <tbody id="budget-lines-body">
                @for (var index = 0; index < Model.Lines.Count; index++)
                {
                    var line = Model.Lines[index];

                    <tr class="budget-line-row">
                        <td class="line-no">@(index + 1)</td>
                        <td>
                            <input type="hidden" data-field="Id" value="@line.Id" />
                            @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                            {
                                Name = $"Lines[{index}].PeriodId",
                                Id = $"Lines_{index}__PeriodId",
                                CssClass = "form-select form-select-sm",
                                SearchPlaceholder = T["Search"],
                                EmptyOptionLabel = T["Select Period"],
                                SelectedValue = line.PeriodId > 0
                                    ? line.PeriodId.ToString(CultureInfo.InvariantCulture)
                                    : null,
                                Options = Model.PeriodOptions.Select(ToOption).ToList(),
                                HtmlAttributes = new Dictionary<string, string> { ["data-field"] = "PeriodId" }
                            })
                        </td>
                        <td>
                            @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                            {
                                Name = $"Lines[{index}].AccountId",
                                Id = $"Lines_{index}__AccountId",
                                CssClass = "form-select form-select-sm",
                                SearchPlaceholder = T["Search"],
                                EmptyOptionLabel = T["Select Account"],
                                SelectedValue = line.AccountId > 0
                                    ? line.AccountId.ToString(CultureInfo.InvariantCulture)
                                    : null,
                                Options = Model.AccountOptions.Select(ToOption).ToList(),
                                HtmlAttributes = new Dictionary<string, string> { ["data-field"] = "AccountId" }
                            })
                        </td>
                        <td>
                            @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                            {
                                Name = $"Lines[{index}].CostCenterId",
                                Id = $"Lines_{index}__CostCenterId",
                                CssClass = "form-select form-select-sm",
                                SearchPlaceholder = T["Search"],
                                EmptyOptionLabel = T["None"],
                                SelectedValue = line.CostCenterId.HasValue
                                    ? line.CostCenterId.Value.ToString(CultureInfo.InvariantCulture)
                                    : null,
                                Options = Model.CostCenterOptions.Select(ToOption).ToList(),
                                HtmlAttributes = new Dictionary<string, string> { ["data-field"] = "CostCenterId" }
                            })
                        </td>
                        <td>
                            <input type="text" class="form-control form-control-sm" data-field="Description" value="@line.Description" />
                        </td>
                        <td>
                            <input type="text" inputmode="decimal" class="form-control form-control-sm text-end sinara-text-number sinara-text-number-theme sinara-text-number-input budget-line-amount" data-field="Amount" data-text-number-decimals="2" value="@line.Amount.ToString("N2", numberCulture)" />
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-budget-line" title="@T["Delete"]">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="5" class="text-end">@T["Total"]</th>
                    <th id="budget-total-amount" class="text-end sinara-text-number sinara-text-number-theme">0.00</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<template id="budget-line-template">
    <tr class="budget-line-row">
        <td class="line-no"></td>
        <td>
            <input type="hidden" data-field="Id" value="" />
            @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
            {
                Name = string.Empty,
                Id = "budget-line-template-period",
                CssClass = "form-select form-select-sm",
                SearchPlaceholder = T["Search"],
                EmptyOptionLabel = T["Select Period"],
                Options = Model.PeriodOptions.Select(ToOption).ToList(),
                HtmlAttributes = new Dictionary<string, string> { ["data-field"] = "PeriodId" }
            })
        </td>
        <td>
            @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
            {
                Name = string.Empty,
                Id = "budget-line-template-account",
                CssClass = "form-select form-select-sm",
                SearchPlaceholder = T["Search"],
                EmptyOptionLabel = T["Select Account"],
                Options = Model.AccountOptions.Select(ToOption).ToList(),
                HtmlAttributes = new Dictionary<string, string> { ["data-field"] = "AccountId" }
            })
        </td>
        <td>
            @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
            {
                Name = string.Empty,
                Id = "budget-line-template-costcenter",
                CssClass = "form-select form-select-sm",
                SearchPlaceholder = T["Search"],
                EmptyOptionLabel = T["None"],
                Options = Model.CostCenterOptions.Select(ToOption).ToList(),
                HtmlAttributes = new Dictionary<string, string> { ["data-field"] = "CostCenterId" }
            })
        </td>
        <td>
            <input type="text" class="form-control form-control-sm" data-field="Description" />
        </td>
        <td>
            <input type="text" inputmode="decimal" class="form-control form-control-sm text-end sinara-text-number sinara-text-number-theme sinara-text-number-input budget-line-amount" data-field="Amount" data-text-number-decimals="2" value="@((0m).ToString("N2", numberCulture))" />
        </td>
        <td class="text-end">
            <button type="button" class="btn btn-sm btn-outline-danger remove-budget-line" title="@T["Delete"]">
                <i class="bi bi-trash" aria-hidden="true"></i>
            </button>
        </td>
    </tr>
</template>

<script>
    (() => {
        const body = document.getElementById('budget-lines-body');
        if (!body) return;

        const addBtn = document.getElementById('add-budget-line');
        const template = document.getElementById('budget-line-template');
        const totalEl = document.getElementById('budget-total-amount');
        const numberLocale = '@(string.Equals(T.CurrentLanguage, "id", StringComparison.OrdinalIgnoreCase) ? "id-ID" : "en-US")';

        const parseAmount = (value) => {
            const normalizer = window.SinaraTextNumber && typeof window.SinaraTextNumber.normalizeFreeNumber === 'function'
                ? window.SinaraTextNumber.normalizeFreeNumber
                : (raw) => String(raw ?? '').replace(/[^0-9.-]/g, '');

            const normalized = normalizer(value);
            const parsed = Number.parseFloat(normalized);
            return Number.isFinite(parsed) ? parsed : 0;
        };

        const formatAmount = (value) => value.toLocaleString(numberLocale, {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });

        const recalc = () => {
            let total = 0;
            body.querySelectorAll('.budget-line-amount').forEach((input) => {
                if (input instanceof HTMLInputElement) {
                    total += parseAmount(input.value);
                }
            });

            if (totalEl) {
                totalEl.textContent = formatAmount(total);
            }
        };

        const renumber = () => {
            const rows = body.querySelectorAll('.budget-line-row');
            rows.forEach((row, index) => {
                const lineNo = row.querySelector('.line-no');
                if (lineNo) {
                    lineNo.textContent = String(index + 1);
                }

                row.querySelectorAll('[data-field]').forEach((control) => {
                    const field = control.getAttribute('data-field');
                    if (!field) return;
                    control.setAttribute('name', `Lines[${index}].${field}`);
                    control.setAttribute('id', `Lines_${index}__${field}`);
                });
            });

            if (window.SinaraTextNumber && typeof window.SinaraTextNumber.bindAll === 'function') {
                window.SinaraTextNumber.bindAll();
            }

            recalc();
        };

        if (addBtn && template) {
            addBtn.addEventListener('click', () => {
                const row = template.content.firstElementChild?.cloneNode(true);
                if (!row) return;
                body.appendChild(row);
                renumber();
            });
        }

        body.addEventListener('click', (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;

            const removeButton = target.closest('.remove-budget-line');
            if (!removeButton) return;

            const rows = body.querySelectorAll('.budget-line-row');
            if (rows.length <= 1) {
                return;
            }

            const row = removeButton.closest('.budget-line-row');
            row?.remove();
            renumber();
        });

        body.addEventListener('input', (event) => {
            const target = event.target;
            if (!(target instanceof HTMLInputElement)) return;

            if (target.classList.contains('budget-line-amount')) {
                recalc();
            }
        });

        renumber();
    })();
</script>
