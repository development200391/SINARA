@model ERP.Web.ViewModels.Finance.FinanceLedgerIndexViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["General Ledger"]</h1>

        @{
            var selectedAccountId = Model.AccountIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedPeriodId = Model.PeriodIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedCostCenterId = Model.CostCenterIdFilter?.ToString(CultureInfo.InvariantCulture);

            var accountOptions = Model.AccountOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var periodOptions = Model.PeriodOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var costCenterOptions = Model.CostCenterOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "accountcode",
                        Title = T["Account Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "accountId",
                            Value = selectedAccountId,
                            EmptyOptionLabel = T["All"],
                            Options = accountOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "accountname",
                        Title = T["Account Name"],
                        Sortable = true
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "date",
                        Title = T["Date"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.DateRange,
                            QueryKey = "dateFrom",
                            QueryKeyTo = "dateTo",
                            Value = Model.DateFromFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            ValueTo = Model.DateToFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "journalno",
                        Title = T["Journal No"],
                        Sortable = true
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "description",
                        Title = T["Description"],
                        Sortable = false
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "periodname",
                        Title = T["Period"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "periodId",
                            Value = selectedPeriodId,
                            EmptyOptionLabel = T["All"],
                            Options = periodOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "costcenter",
                        Title = T["Cost Center"],
                        Sortable = false,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "costCenterId",
                            Value = selectedCostCenterId,
                            EmptyOptionLabel = T["All"],
                            Options = costCenterOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "debit",
                        Title = T["Debit"],
                        Sortable = true,
                        CellClass = "text-end"
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "credit",
                        Title = T["Credit"],
                        Sortable = true,
                        CellClass = "text-end"
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "balance",
                        Title = T["Balance"],
                        Sortable = true,
                        CellClass = "text-end"
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "source",
                        Title = T["Source"],
                        Sortable = false
                    }
                ],
                Rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = item.AccountCode },
                        new PagedGridCellViewModel { Text = item.AccountName },
                        new PagedGridCellViewModel { Text = item.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) },
                        new PagedGridCellViewModel { Text = item.JournalNo },
                        new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.LineDescription) ? item.JournalDescription : item.LineDescription },
                        new PagedGridCellViewModel { Text = item.PeriodName },
                        new PagedGridCellViewModel { Text = item.CostCenterCode is null ? "-" : $"{item.CostCenterCode} - {item.CostCenterName}" },
                        new PagedGridCellViewModel { Text = item.Debit.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = item.Credit.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = item.Balance.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = T[item.Source.ToString()] }
                    ]
                }).ToList(),
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " ledger",
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
