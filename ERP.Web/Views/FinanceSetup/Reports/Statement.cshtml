@model ERP.Web.ViewModels.Finance.FinanceStatementIndexViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T[Model.ReportTitle]</h1>

        @{
            var selectedPeriodId = Model.PeriodIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedCostCenterId = Model.CostCenterIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedAccountType = Model.AccountTypeFilter.HasValue ? ((int)Model.AccountTypeFilter.Value).ToString(CultureInfo.InvariantCulture) : null;

            var periodOptions = Model.PeriodOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var costCenterOptions = Model.CostCenterOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var sectionOptions = Model.SectionOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x,
                    Label = T[x]
                })
                .ToList();

            var accountTypeOptions = Model.AccountTypeOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = ((int)x).ToString(CultureInfo.InvariantCulture),
                    Label = T[x.ToString()]
                })
                .ToList();

            var selectedPeriodLabel = Model.PeriodOptions.FirstOrDefault(x => x.Id == Model.PeriodIdFilter)?.Label ?? T["All"];
            var selectedCostCenterLabel = Model.CostCenterOptions.FirstOrDefault(x => x.Id == Model.CostCenterIdFilter)?.Label ?? T["All"];
            var dateRangeText = (Model.DateFromFilter.HasValue || Model.DateToFilter.HasValue)
                ? $"{(Model.DateFromFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "-")} - {(Model.DateToFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "-")}"
                : T["All"];

            var rows = new List<PagedGridRowViewModel>();
            foreach (var item in Model.Items.Items)
            {
                var amountHtml = await Component.InvokeAsync("TextNumber", new
                {
                    text = item.Amount.ToString(CultureInfo.InvariantCulture),
                    decimals = 2,
                    cssClass = "sinara-text-number-theme"
                });

                rows.Add(new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = selectedPeriodLabel },
                        new PagedGridCellViewModel { Text = dateRangeText },
                        new PagedGridCellViewModel { Text = selectedCostCenterLabel },
                        new PagedGridCellViewModel { Text = T[item.Section] },
                        new PagedGridCellViewModel { Text = item.AccountCode },
                        new PagedGridCellViewModel { Text = item.AccountName },
                        new PagedGridCellViewModel { Text = T[item.AccountType.ToString()] },
                        new PagedGridCellViewModel { Html = amountHtml, CellClass = "text-end" }
                    ]
                });
            }

            var exportUrl = Url.Action(Model.ExportActionName, "FinanceSetup", new
            {
                search = Model.Search,
                sortBy = Model.SortBy,
                sortDirection = Model.SortDirection,
                periodId = Model.PeriodIdFilter,
                dateFrom = Model.DateFromFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                dateTo = Model.DateToFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                costCenterId = Model.CostCenterIdFilter,
                accountType = Model.AccountTypeFilter,
                section = Model.SectionFilter
            });

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "period",
                        Title = T["Period"],
                        Sortable = false,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "periodId",
                            Value = selectedPeriodId,
                            EmptyOptionLabel = T["All"],
                            Options = periodOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "daterange",
                        Title = T["Date Range"],
                        Sortable = false,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.DateRange,
                            QueryKey = "dateFrom",
                            QueryKeyTo = "dateTo",
                            Value = Model.DateFromFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            ValueTo = Model.DateToFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "costcenter",
                        Title = T["Cost Center"],
                        Sortable = false,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "costCenterId",
                            Value = selectedCostCenterId,
                            EmptyOptionLabel = T["All"],
                            Options = costCenterOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "section",
                        Title = T["Section"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "section",
                            Value = Model.SectionFilter,
                            EmptyOptionLabel = T["All"],
                            Options = sectionOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "accountcode",
                        Title = T["Account Code"],
                        Sortable = true
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "accountname",
                        Title = T["Account Name"],
                        Sortable = true
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "type",
                        Title = T["Type"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "accountType",
                            Value = selectedAccountType,
                            EmptyOptionLabel = T["All"],
                            Options = accountTypeOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "amount",
                        Title = T["Amount"],
                        Sortable = true,
                        CellClass = "text-end"
                    }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T[Model.ReportTitle],
                SearchButtonText = T["common.search"],
                ExportUrl = exportUrl,
                ExportButtonText = T["Export CSV"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>

