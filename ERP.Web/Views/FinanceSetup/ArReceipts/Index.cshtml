@model ERP.Web.ViewModels.Finance.FinanceArReceiptsIndexViewModel
@using ERP.Domain.Enums
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["AR Receipts"]</h1>

        @{
            var selectedCustomerId = Model.CustomerIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedPaymentMethod = Model.PaymentMethodFilter.HasValue ? ((int)Model.PaymentMethodFilter.Value).ToString(CultureInfo.InvariantCulture) : null;

            var customerOptions = Model.CustomerOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var methodOptions = Enum.GetValues<FinanceArReceiptMethod>()
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = ((int)x).ToString(CultureInfo.InvariantCulture),
                    Label = T[x.ToString()]
                })
                .ToList();

            var rows = new List<PagedGridRowViewModel>();
            foreach (var item in Model.Items.Items)
            {
                var amountHtml = await Component.InvokeAsync("TextNumber", new
                {
                    text = item.Amount.ToString(CultureInfo.InvariantCulture),
                    decimals = 2,
                    cssClass = "sinara-text-number-theme"
                });

                rows.Add(new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = item.ReceiptNo },
                        new PagedGridCellViewModel { Text = $"{item.CustomerCode} - {item.CustomerName}" },
                        new PagedGridCellViewModel { Text = item.ReceiptDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) },
                        new PagedGridCellViewModel { Text = T[item.PaymentMethod.ToString()] },
                        new PagedGridCellViewModel { Html = amountHtml, CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = $"{item.BankAccountCode} - {item.BankAccountName}" },
                        new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.ReferenceNo) ? "-" : item.ReferenceNo }
                    ]
                });
            }

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "receiptno",
                        Title = T["Receipt No"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "receiptNo",
                            Value = Model.ReceiptNoFilter,
                            Placeholder = T["Receipt No"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "customername",
                        Title = T["Customer"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "customerId",
                            Value = selectedCustomerId,
                            EmptyOptionLabel = T["All"],
                            Options = customerOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "receiptdate",
                        Title = T["Receipt Date"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.DateRange,
                            QueryKey = "receiptDateFrom",
                            QueryKeyTo = "receiptDateTo",
                            Value = Model.ReceiptDateFromFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            ValueTo = Model.ReceiptDateToFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "paymentmethod",
                        Title = T["Payment Method"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "paymentMethod",
                            Value = selectedPaymentMethod,
                            EmptyOptionLabel = T["All"],
                            Options = methodOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "amount",
                        Title = T["Amount"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "amountFrom",
                            QueryKeyTo = "amountTo",
                            Value = Model.AmountFromFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.AmountToFilter?.ToString(CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "bankaccount",
                        Title = T["Bank Account"],
                        Sortable = false
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "referenceno",
                        Title = T["Reference No"],
                        Sortable = false
                    }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["AR Receipts"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateArReceipt", "FinanceSetup"),
                    AddButtonText = T["common.add_new"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
