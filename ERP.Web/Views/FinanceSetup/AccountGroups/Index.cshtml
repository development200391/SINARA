@model ERP.Web.ViewModels.Finance.FinanceAccountGroupsIndexViewModel
@using ERP.Domain.Enums
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Account Groups"]</h1>

        @{
            var selectedType = Model.TypeFilter.HasValue ? ((int)Model.TypeFilter.Value).ToString(CultureInfo.InvariantCulture) : null;
            var selectedNormalBalance = Model.NormalBalanceFilter.HasValue ? ((int)Model.NormalBalanceFilter.Value).ToString(CultureInfo.InvariantCulture) : null;
            var selectedParentGroupId = Model.ParentGroupIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedIsActive = Model.IsActiveFilter.HasValue ? (Model.IsActiveFilter.Value ? "true" : "false") : null;

            var typeOptions = Enum.GetValues<FinanceAccountType>()
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = ((int)x).ToString(CultureInfo.InvariantCulture),
                    Label = x.ToString()
                })
                .ToList();

            var normalBalanceOptions = Enum.GetValues<FinanceNormalBalance>()
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = ((int)x).ToString(CultureInfo.InvariantCulture),
                    Label = x.ToString()
                })
                .ToList();

            var parentOptions = Model.ParentGroupOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var statusOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Active"] },
                new() { Value = "false", Label = T["Inactive"] }
            };

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "code",
                        Title = T["Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "code",
                            Value = Model.CodeFilter,
                            Placeholder = T["Filter code"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "name",
                        Title = T["Name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "name",
                            Value = Model.NameFilter,
                            Placeholder = T["Filter name"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "type",
                        Title = T["Type"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "type",
                            Value = selectedType,
                            EmptyOptionLabel = T["All"],
                            Options = typeOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "normalbalance",
                        Title = T["Normal Balance"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "normalBalance",
                            Value = selectedNormalBalance,
                            EmptyOptionLabel = T["All"],
                            Options = normalBalanceOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "parent",
                        Title = T["Parent"],
                        Sortable = false,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "parentGroupId",
                            Value = selectedParentGroupId,
                            EmptyOptionLabel = T["All"],
                            Options = parentOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "sortorder",
                        Title = T["Sort Order"],
                        Sortable = true,
                        CellClass = "text-end"
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isactive",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isActive",
                            Value = selectedIsActive,
                            EmptyOptionLabel = T["All"],
                            Options = statusOptions
                        }
                    }
                ],
                Rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = item.Code },
                        new PagedGridCellViewModel { Text = item.Name },
                        new PagedGridCellViewModel { Text = item.Type.ToString() },
                        new PagedGridCellViewModel { Text = item.NormalBalance.ToString() },
                        new PagedGridCellViewModel { Text = item.ParentGroupName ?? "-" },
                        new PagedGridCellViewModel { Text = item.SortOrder.ToString(CultureInfo.InvariantCulture), CellClass = "text-end" },
                        new PagedGridCellViewModel
                        {
                            Html = new HtmlString(item.IsActive
                                ? "<span class=\"badge text-bg-success\">Active</span>"
                                : "<span class=\"badge text-bg-secondary\">Inactive</span>")
                        }
                    ],
                    Actions = new PagedGridRowActionViewModel
                    {
                        EditUrl = Url.Action("EditCoaGroup", "FinanceSetup", new { id = item.Id }),
                        DeleteUrl = Url.Action("DeleteCoaGroup", "FinanceSetup", new { id = item.Id }),
                        DeleteConfirmMessage = T["Delete this data?"]
                    }
                }).ToList(),
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " account groups",
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateCoaGroup", "FinanceSetup"),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
