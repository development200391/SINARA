@model ERP.Web.ViewModels.Finance.FinanceAccountGroupEditViewModel
@using ERP.Domain.Enums
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<form method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-4">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Type" class="form-label"></label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.Type),
            Id = Html.IdFor(x => x.Type).ToString(),
            CssClass = "form-select",
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.Type.ToString(),
            Options = Html.GetEnumSelectList<FinanceAccountType>().Select(item => new SearchableSelectOptionViewModel
            {
                Value = item.Value,
                Label = item.Text
            }).ToList()
        })
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="NormalBalance" class="form-label"></label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.NormalBalance),
            Id = Html.IdFor(x => x.NormalBalance).ToString(),
            CssClass = "form-select",
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.NormalBalance.ToString(),
            Options = Html.GetEnumSelectList<FinanceNormalBalance>().Select(item => new SearchableSelectOptionViewModel
            {
                Value = item.Value,
                Label = item.Text
            }).ToList()
        })
        <span asp-validation-for="NormalBalance" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="SortOrder" class="form-label"></label>
        <input asp-for="SortOrder" class="form-control" type="number" min="1" />
        <span asp-validation-for="SortOrder" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ParentGroupId" class="form-label">@T["Parent"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.ParentGroupId),
            Id = Html.IdFor(x => x.ParentGroupId).ToString(),
            CssClass = "form-select",
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["No Parent"],
            SelectedValue = Model.ParentGroupId.HasValue
                ? Model.ParentGroupId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.ParentGroupOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="ParentGroupId" class="text-danger"></span>
    </div>

    <div class="col-12">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsActive),
            Id = Html.IdFor(x => x.IsActive).ToString(),
            Label = T["Active"],
            Checked = Model.IsActive
        })
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@T["common.save"]</button>
        <a asp-action="CoaGroups" class="btn btn-outline-secondary">@T["common.cancel"]</a>
    </div>
</form>
