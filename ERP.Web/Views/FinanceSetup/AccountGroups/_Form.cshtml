@model ERP.Web.ViewModels.Finance.FinanceAccountGroupEditViewModel
@using ERP.Domain.Enums

<form method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-4">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<FinanceAccountType>()"></select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="NormalBalance" class="form-label"></label>
        <select asp-for="NormalBalance" class="form-select" asp-items="Html.GetEnumSelectList<FinanceNormalBalance>()"></select>
        <span asp-validation-for="NormalBalance" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="SortOrder" class="form-label"></label>
        <input asp-for="SortOrder" class="form-control" type="number" min="1" />
        <span asp-validation-for="SortOrder" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ParentGroupId" class="form-label">@T["Parent"]</label>
        <select asp-for="ParentGroupId" class="form-select">
            <option value="">@T["No Parent"]</option>
            @foreach (var option in Model.ParentGroupOptions)
            {
                <option value="@option.Id" selected="@(Model.ParentGroupId == option.Id)">@option.Label</option>
            }
        </select>
        <span asp-validation-for="ParentGroupId" class="text-danger"></span>
    </div>

    <div class="col-12 form-check mt-2">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@T["common.save"]</button>
        <a asp-action="CoaGroups" class="btn btn-outline-secondary">@T["common.cancel"]</a>
    </div>
</form>
