@model ERP.Web.ViewModels.Finance.FinanceVendorEditViewModel

<form method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-3">
        <label asp-for="Code" class="form-label">@T["Code"]</label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Name" class="form-label">@T["Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="TaxId" class="form-label">@T["Tax ID"]</label>
        <input asp-for="TaxId" class="form-control" />
        <span asp-validation-for="TaxId" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ContactPerson" class="form-label">@T["Contact Person"]</label>
        <input asp-for="ContactPerson" class="form-control" />
        <span asp-validation-for="ContactPerson" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Email" class="form-label">@T["Email"]</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Phone" class="form-label">@T["Phone"]</label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="PaymentTermsDays" class="form-label">@T["Payment Terms (Days)"]</label>
        <input asp-for="PaymentTermsDays" class="form-control" type="number" min="0" />
        <span asp-validation-for="PaymentTermsDays" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="DefaultAccountId" class="form-label">@T["Default Account"]</label>
        <select asp-for="DefaultAccountId" class="form-select">
            <option value="">@T["None"]</option>
            @foreach (var option in Model.AccountOptions)
            {
                <option value="@option.Id" selected="@(Model.DefaultAccountId == option.Id)">@option.Label</option>
            }
        </select>
        <span asp-validation-for="DefaultAccountId" class="text-danger"></span>
    </div>

    <div class="col-md-5">
        <label asp-for="DefaultTaxCodeId" class="form-label">@T["Default Tax Code"]</label>
        <select asp-for="DefaultTaxCodeId" class="form-select">
            <option value="">@T["None"]</option>
            @foreach (var option in Model.TaxCodeOptions)
            {
                <option value="@option.Id" selected="@(Model.DefaultTaxCodeId == option.Id)">@option.Label</option>
            }
        </select>
        <span asp-validation-for="DefaultTaxCodeId" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="BankName" class="form-label">@T["Bank Name"]</label>
        <input asp-for="BankName" class="form-control" />
        <span asp-validation-for="BankName" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="BankAccountNo" class="form-label">@T["Bank Account No"]</label>
        <input asp-for="BankAccountNo" class="form-control" />
        <span asp-validation-for="BankAccountNo" class="text-danger"></span>
    </div>

    <div class="col-md-12">
        <label asp-for="Address" class="form-label">@T["Address"]</label>
        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="col-12 form-check mt-2">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">@T["Active"]</label>
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@T["common.save"]</button>
        <a asp-action="Vendors" class="btn btn-outline-secondary">@T["common.cancel"]</a>
    </div>
</form>
