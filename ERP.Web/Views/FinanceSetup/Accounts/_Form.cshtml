@model ERP.Web.ViewModels.Finance.FinanceAccountEditViewModel
@using ERP.Domain.Enums
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<form method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-4">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="GroupId" class="form-label">@T["Group"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.GroupId),
            Id = Html.IdFor(x => x.GroupId).ToString(),
            CssClass = "form-select",
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.GroupId > 0
                ? Model.GroupId.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.GroupOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="GroupId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ParentAccountId" class="form-label">@T["Parent"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.ParentAccountId),
            Id = Html.IdFor(x => x.ParentAccountId).ToString(),
            CssClass = "form-select",
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["No Parent"],
            SelectedValue = Model.ParentAccountId.HasValue
                ? Model.ParentAccountId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.ParentAccountOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="ParentAccountId" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="Type" class="form-label"></label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.Type),
            Id = Html.IdFor(x => x.Type).ToString(),
            CssClass = "form-select",
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.Type.ToString(),
            Options = Html.GetEnumSelectList<FinanceAccountType>().Select(item => new SearchableSelectOptionViewModel
            {
                Value = item.Value,
                Label = item.Text
            }).ToList()
        })
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="NormalBalance" class="form-label"></label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.NormalBalance),
            Id = Html.IdFor(x => x.NormalBalance).ToString(),
            CssClass = "form-select",
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.NormalBalance.ToString(),
            Options = Html.GetEnumSelectList<FinanceNormalBalance>().Select(item => new SearchableSelectOptionViewModel
            {
                Value = item.Value,
                Label = item.Text
            }).ToList()
        })
        <span asp-validation-for="NormalBalance" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="CurrencyCode" class="form-label">@T["Currency"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.CurrencyCode),
            Id = Html.IdFor(x => x.CurrencyCode).ToString(),
            CssClass = "form-select",
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.CurrencyCode,
            Options = Model.CurrencyOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Code,
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="CurrencyCode" class="text-danger"></span>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsHeader),
            Id = Html.IdFor(x => x.IsHeader).ToString(),
            Label = T["Header Account"],
            Checked = Model.IsHeader
        })
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsBankAccount),
            Id = "isBankAccountToggle",
            Label = T["Bank Account"],
            Checked = Model.IsBankAccount
        })
    </div>

    <div class="col-md-4 bank-account-fields">
        <label asp-for="BankName" class="form-label"></label>
        <input asp-for="BankName" class="form-control" />
        <span asp-validation-for="BankName" class="text-danger"></span>
    </div>

    <div class="col-md-5 bank-account-fields">
        <label asp-for="BankAccountNo" class="form-label"></label>
        <input asp-for="BankAccountNo" class="form-control" />
        <span asp-validation-for="BankAccountNo" class="text-danger"></span>
    </div>

    <div class="col-12">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsActive),
            Id = Html.IdFor(x => x.IsActive).ToString(),
            Label = T["Active"],
            Checked = Model.IsActive
        })
    </div>

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">@T["common.save"]</button>
        <a asp-action="Coa" class="btn btn-outline-secondary">@T["common.cancel"]</a>
    </div>
</form>
