@model ERP.Web.ViewModels.Finance.FinanceAccountsIndexViewModel
@using ERP.Domain.Enums
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Chart of Accounts"]</h1>

        @{
            var selectedGroupId = Model.GroupIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedType = Model.TypeFilter.HasValue ? ((int)Model.TypeFilter.Value).ToString(CultureInfo.InvariantCulture) : null;
            var selectedNormalBalance = Model.NormalBalanceFilter.HasValue ? ((int)Model.NormalBalanceFilter.Value).ToString(CultureInfo.InvariantCulture) : null;
            var selectedIsHeader = Model.IsHeaderFilter.HasValue ? (Model.IsHeaderFilter.Value ? "true" : "false") : null;
            var selectedParentAccountId = Model.ParentAccountIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedCurrencyCode = Model.CurrencyCodeFilter;
            var selectedIsBankAccount = Model.IsBankAccountFilter.HasValue ? (Model.IsBankAccountFilter.Value ? "true" : "false") : null;
            var selectedIsActive = Model.IsActiveFilter.HasValue ? (Model.IsActiveFilter.Value ? "true" : "false") : null;

            var groupOptions = Model.GroupOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var parentAccountOptions = Model.ParentAccountOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var typeOptions = Enum.GetValues<FinanceAccountType>()
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = ((int)x).ToString(CultureInfo.InvariantCulture),
                    Label = x.ToString()
                })
                .ToList();

            var normalBalanceOptions = Enum.GetValues<FinanceNormalBalance>()
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = ((int)x).ToString(CultureInfo.InvariantCulture),
                    Label = x.ToString()
                })
                .ToList();

            var yesNoOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Yes"] },
                new() { Value = "false", Label = T["No"] }
            };

            var currencyOptions = Model.CurrencyOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Code,
                    Label = x.Label
                })
                .ToList();

            var statusOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Active"] },
                new() { Value = "false", Label = T["Inactive"] }
            };

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "code",
                        Title = T["Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "code",
                            Value = Model.CodeFilter,
                            Placeholder = T["Filter code"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "name",
                        Title = T["Name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "name",
                            Value = Model.NameFilter,
                            Placeholder = T["Filter name"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "groupname",
                        Title = T["Group"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "groupId",
                            Value = selectedGroupId,
                            EmptyOptionLabel = T["All"],
                            Options = groupOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "parentaccountid",
                        Title = T["Parent"],
                        Sortable = false,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "parentAccountId",
                            Value = selectedParentAccountId,
                            EmptyOptionLabel = T["All"],
                            Options = parentAccountOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "type",
                        Title = T["Type"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "type",
                            Value = selectedType,
                            EmptyOptionLabel = T["All"],
                            Options = typeOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "normalbalance",
                        Title = T["Normal Balance"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "normalBalance",
                            Value = selectedNormalBalance,
                            EmptyOptionLabel = T["All"],
                            Options = normalBalanceOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isheader",
                        Title = T["Header"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isHeader",
                            Value = selectedIsHeader,
                            EmptyOptionLabel = T["All"],
                            Options = yesNoOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "currencycode",
                        Title = T["Currency"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "currencyCode",
                            Value = selectedCurrencyCode,
                            EmptyOptionLabel = T["All"],
                            Options = currencyOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isbankaccount",
                        Title = T["Bank"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isBankAccount",
                            Value = selectedIsBankAccount,
                            EmptyOptionLabel = T["All"],
                            Options = yesNoOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isactive",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isActive",
                            Value = selectedIsActive,
                            EmptyOptionLabel = T["All"],
                            Options = statusOptions
                        }
                    }
                ],
                Rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = item.Code },
                        new PagedGridCellViewModel { Text = item.Name },
                        new PagedGridCellViewModel { Text = item.GroupName },
                        new PagedGridCellViewModel { Text = item.ParentAccountName ?? "-" },
                        new PagedGridCellViewModel { Text = item.Type.ToString() },
                        new PagedGridCellViewModel { Text = item.NormalBalance.ToString() },
                        new PagedGridCellViewModel
                        {
                            Html = new HtmlString(item.IsHeader
                                ? "<span class=\"badge text-bg-info\">Yes</span>"
                                : "<span class=\"badge text-bg-secondary\">No</span>")
                        },
                        new PagedGridCellViewModel { Text = item.CurrencyCode },
                        new PagedGridCellViewModel
                        {
                            Html = new HtmlString(item.IsBankAccount
                                ? "<span class=\"badge text-bg-primary\">Yes</span>"
                                : "<span class=\"badge text-bg-secondary\">No</span>")
                        },
                        new PagedGridCellViewModel
                        {
                            Html = new HtmlString(item.IsActive
                                ? "<span class=\"badge text-bg-success\">Active</span>"
                                : "<span class=\"badge text-bg-secondary\">Inactive</span>")
                        }
                    ],
                    Actions = new PagedGridRowActionViewModel
                    {
                        EditUrl = Url.Action("EditCoa", "FinanceSetup", new { id = item.Id }),
                        DeleteUrl = Url.Action("DeleteCoa", "FinanceSetup", new { id = item.Id }),
                        DeleteConfirmMessage = T["Delete this data?"]
                    }
                }).ToList(),
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " COA",
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateCoa", "FinanceSetup"),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
