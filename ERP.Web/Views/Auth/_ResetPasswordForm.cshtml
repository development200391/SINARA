@model ERP.Web.ViewModels.Auth.ResetPasswordViewModel

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<form asp-controller="Auth" asp-action="ResetPassword" method="post" novalidate>
    @Html.AntiForgeryToken()

    <input asp-for="Email" type="hidden" />
    <input asp-for="Token" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label">@T["auth.new_password"]</label>
        <div class="input-group">
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" id="resetNewPasswordInput" />
            <button class="btn btn-outline-secondary" type="button" data-password-toggle="resetNewPasswordInput" aria-label="Toggle new password visibility">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="NewPassword" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label">@T["auth.confirm_password"]</label>
        <div class="input-group">
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" id="resetConfirmPasswordInput" />
            <button class="btn btn-outline-secondary" type="button" data-password-toggle="resetConfirmPasswordInput" aria-label="Toggle confirm password visibility">
                <i class="bi bi-eye"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary w-100">@T["auth.reset_password_submit"]</button>

    <div class="text-center mt-3">
        <a asp-controller="Auth" asp-action="Login" class="small">@T["auth.back_to_login"]</a>
    </div>
</form>

