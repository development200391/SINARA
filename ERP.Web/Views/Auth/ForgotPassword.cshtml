@model ERP.Web.ViewModels.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = T["auth.forgot_password"];
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SINARA ERP</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="container py-5">
        <div class="row justify-content-center">
            @await Component.InvokeAsync("AuthFormCard", new ERP.Web.ViewModels.Shared.AuthFormCardViewModel
            {
                Title = T["auth.forgot_password"],
                Subtitle = T["auth.forgot_password_description"],
                BodyPartialViewName = "/Views/Auth/_ForgotPasswordForm.cshtml",
                BodyModel = Model
            })
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>

