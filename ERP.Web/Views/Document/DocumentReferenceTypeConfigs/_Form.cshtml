@model ERP.Web.ViewModels.Document.DocumentReferenceTypeConfigEditViewModel
@using ERP.Web.ViewModels.Shared

@{
    var isEdit = Model.Id > 0;
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@(isEdit ? T["Edit Document Setting"] : T["Create Document Setting"])</h1>

        <form method="post" class="row g-3">
            @Html.AntiForgeryToken()
            @if (isEdit)
            {
                <input asp-for="Id" type="hidden" />
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-md-4">
                <label asp-for="ReferenceType" class="form-label"></label>
                <input asp-for="ReferenceType" class="form-control" placeholder="hr_leave_requests" />
                <span asp-validation-for="ReferenceType" class="text-danger"></span>
                <div class="form-text">@T["Table/entity name used by the owning module, e.g. hr_leave_requests."]</div>
            </div>

            <div class="col-md-4">
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-control" placeholder="Leave Request" />
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                {
                    Name = nameof(Model.IsMultiple),
                    Id = Html.IdFor(x => x.IsMultiple).ToString(),
                    Label = T["Multiple"],
                    Checked = Model.IsMultiple
                })
            </div>

            <div class="col-md-2">
                <label asp-for="MaxFileCount" class="form-label"></label>
                <input asp-for="MaxFileCount" type="number" min="1" max="100" class="form-control" id="config-max-file-count" />
                <span asp-validation-for="MaxFileCount" class="text-danger"></span>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                {
                    Name = nameof(Model.IsActive),
                    Id = Html.IdFor(x => x.IsActive).ToString(),
                    Label = T["Active"],
                    Checked = Model.IsActive
                })
            </div>

            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 mb-0">@T["Document Setting Detail"]</h2>
                </div>
                <p class="small text-muted">@T["One row per attachment slot. Uncheck \"Multiple\" for a single slot, or check it and set Max Files to generate that many rows."]</p>

                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th style="width:40px;">#</th>
                                <th>@T["Name"]</th>
                                <th style="width:140px;">@T["Max Size"]</th>
                                <th style="width:90px;">@T["Required"]</th>
                                <th style="width:80px;">@T["Active"]</th>
                                <th>@T["Allowed Extensions"]</th>
                            </tr>
                        </thead>
                        <tbody id="config-details-body">
                            @for (var index = 0; index < Model.Details.Count; index++)
                            {
                                var detail = Model.Details[index];
                                <tr class="config-detail-row">
                                    <td class="line-no">@(index + 1)</td>
                                    <td><input type="text" class="form-control form-control-sm" data-field="Name" value="@detail.Name" /></td>
                                    <td><input type="number" class="form-control form-control-sm" data-field="MaxFileSizeBytes" min="1" value="@detail.MaxFileSizeBytes" /></td>
                                    <td>
                                        <input type="checkbox" class="form-check-input" data-field="IsRequired" value="true" checked="@(detail.IsRequired ? "checked" : null)" />
                                        <input type="hidden" data-field-hidden="IsRequired" value="false" />
                                    </td>
                                    <td>
                                        <input type="checkbox" class="form-check-input" data-field="IsActive" value="true" checked="@(detail.IsActive ? "checked" : null)" />
                                        <input type="hidden" data-field-hidden="IsActive" value="false" />
                                    </td>
                                    <td><input type="text" class="form-control form-control-sm" data-field="AllowedExtensions" value="@detail.AllowedExtensions" placeholder=".pdf,.jpg,.jpeg,.png,.docx" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>

<template id="config-detail-template">
    <tr class="config-detail-row">
        <td class="line-no"></td>
        <td><input type="text" class="form-control form-control-sm" data-field="Name" /></td>
        <td><input type="number" class="form-control form-control-sm" data-field="MaxFileSizeBytes" min="1" /></td>
        <td>
            <input type="checkbox" class="form-check-input" data-field="IsRequired" value="true" />
            <input type="hidden" data-field-hidden="IsRequired" value="false" />
        </td>
        <td>
            <input type="checkbox" class="form-check-input" data-field="IsActive" value="true" checked />
            <input type="hidden" data-field-hidden="IsActive" value="false" />
        </td>
        <td><input type="text" class="form-control form-control-sm" data-field="AllowedExtensions" placeholder=".pdf,.jpg,.jpeg,.png,.docx" /></td>
    </tr>
</template>

<script>
    (() => {
        const body = document.getElementById('config-details-body');
        const template = document.getElementById('config-detail-template');
        const isMultipleInput = document.getElementById('@Html.IdFor(x => x.IsMultiple)');
        const maxFileCountInput = document.getElementById('config-max-file-count');
        if (!body || !template || !isMultipleInput || !maxFileCountInput) return;

        const rowCount = () => body.querySelectorAll('.config-detail-row').length;

        const renumber = () => {
            const rows = body.querySelectorAll('.config-detail-row');
            rows.forEach((row, index) => {
                const lineNo = row.querySelector('.line-no');
                if (lineNo) lineNo.textContent = String(index + 1);

                row.querySelectorAll('[data-field]').forEach((control) => {
                    const field = control.getAttribute('data-field');
                    if (!field) return;
                    control.setAttribute('name', `Details[${index}].${field}`);
                    control.setAttribute('id', `Details_${index}__${field}`);
                });

                row.querySelectorAll('[data-field-hidden]').forEach((control) => {
                    const field = control.getAttribute('data-field-hidden');
                    if (!field) return;
                    control.setAttribute('name', `Details[${index}].${field}`);
                });
            });
        };

        const addRow = () => {
            const row = template.content.firstElementChild?.cloneNode(true);
            if (!row) return;
            body.appendChild(row);
        };

        const removeLastRow = () => {
            const rows = body.querySelectorAll('.config-detail-row');
            if (rows.length > 0) {
                rows[rows.length - 1].remove();
            }
        };

        const syncRowCount = (targetCount) => {
            const clamped = Math.max(1, Math.min(100, Number.isFinite(targetCount) ? targetCount : 1));
            while (rowCount() < clamped) addRow();
            while (rowCount() > clamped) removeLastRow();
            renumber();
        };

        const applyIsMultipleState = () => {
            if (isMultipleInput.checked) {
                maxFileCountInput.removeAttribute('readonly');
                syncRowCount(parseInt(maxFileCountInput.value, 10));
            } else {
                maxFileCountInput.value = '1';
                maxFileCountInput.setAttribute('readonly', 'readonly');
                syncRowCount(1);
            }
        };

        maxFileCountInput.addEventListener('input', () => {
            if (isMultipleInput.checked) {
                syncRowCount(parseInt(maxFileCountInput.value, 10));
            }
        });

        isMultipleInput.addEventListener('change', applyIsMultipleState);

        applyIsMultipleState();
        renumber();
    })();
</script>
