@model ERP.Web.ViewModels.Document.DocumentReferenceTypeConfigEditViewModel
@using ERP.Web.ViewModels.Shared

@{
    var isEdit = Model.Id > 0;
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@(isEdit ? T["Edit Document Setting"] : T["Create Document Setting"])</h1>

        <form method="post" class="row g-3">
            @Html.AntiForgeryToken()
            @if (isEdit)
            {
                <input asp-for="Id" type="hidden" />
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-md-4">
                <label asp-for="ReferenceType" class="form-label"></label>
                <input asp-for="ReferenceType" class="form-control" placeholder="hr_leave_requests" />
                <span asp-validation-for="ReferenceType" class="text-danger"></span>
                <div class="form-text">@T["Table/entity name used by the owning module, e.g. hr_leave_requests."]</div>
            </div>

            <div class="col-md-4">
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-control" placeholder="Leave Request" />
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>

            <div class="col-md-4 d-flex align-items-end">
                @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                {
                    Name = nameof(Model.IsRequired),
                    Id = Html.IdFor(x => x.IsRequired).ToString(),
                    Label = T["Attachment Required"],
                    Checked = Model.IsRequired
                })
            </div>

            <div class="col-md-4">
                <label asp-for="MaxFileSizeBytes" class="form-label"></label>
                <input asp-for="MaxFileSizeBytes" type="number" min="1" class="form-control" />
                <span asp-validation-for="MaxFileSizeBytes" class="text-danger"></span>
                <div class="form-text">@T["Leave empty to use the global default."]</div>
            </div>

            <div class="col-md-4">
                <label asp-for="MaxFileCount" class="form-label"></label>
                <input asp-for="MaxFileCount" type="number" min="1" max="100" class="form-control" />
                <span asp-validation-for="MaxFileCount" class="text-danger"></span>
            </div>

            <div class="col-md-4 d-flex align-items-end">
                @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                {
                    Name = nameof(Model.IsActive),
                    Id = Html.IdFor(x => x.IsActive).ToString(),
                    Label = T["Active"],
                    Checked = Model.IsActive
                })
            </div>

            <div class="col-12">
                <label asp-for="AllowedExtensions" class="form-label"></label>
                <input asp-for="AllowedExtensions" class="form-control" placeholder=".pdf,.jpg,.jpeg,.png,.docx" />
                <span asp-validation-for="AllowedExtensions" class="text-danger"></span>
                <div class="form-text">@T["Comma-separated, including the leading dot. Leave empty to use the global default."]</div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>
