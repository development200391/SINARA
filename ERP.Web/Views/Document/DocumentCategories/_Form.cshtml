@model ERP.Web.ViewModels.Document.DocumentCategoryEditViewModel
@using ERP.Web.ViewModels.Shared

@{
    var isEdit = Model.Id > 0;
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@(isEdit ? T["Edit Document Category"] : T["Create Document Category"])</h1>

        <form method="post" class="row g-3">
            @Html.AntiForgeryToken()
            @if (isEdit)
            {
                <input asp-for="Id" type="hidden" />
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-md-4">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <div class="col-md-5">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Module" class="form-label"></label>
                <input asp-for="Module" class="form-control" placeholder="HR" />
                <span asp-validation-for="Module" class="text-danger"></span>
            </div>

            <div class="col-md-4 d-flex align-items-end">
                @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                {
                    Name = nameof(Model.IsActive),
                    Id = Html.IdFor(x => x.IsActive).ToString(),
                    Label = T["Active"],
                    Checked = Model.IsActive
                })
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>
