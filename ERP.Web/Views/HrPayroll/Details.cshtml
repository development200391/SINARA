@model ERP.Web.ViewModels.HR.HrPayrollDetailsViewModel

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h5 mb-0">Payroll Details - Run #@Model.RunId</h1>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back</a>
        </div>

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Department</th>
                        <th>Position</th>
                        <th>Basic</th>
                        <th>Allowance</th>
                        <th>Deductions</th>
                        <th>Tax</th>
                        <th>Net</th>
                        <th class="text-end">Payslip</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Details.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">@T["msg.no_data"]</td></tr>
                }
                else
                {
                    foreach (var item in Model.Details)
                    {
                        <tr>
                            <td>@item.EmployeeCode - @item.EmployeeName</td>
                            <td>@item.DepartmentName</td>
                            <td>@item.PositionName</td>
                            <td>@item.BasicSalary.ToString("N2")</td>
                            <td>@item.Allowances.ToString("N2")</td>
                            <td>@item.Deductions.ToString("N2")</td>
                            <td>@item.TaxAmount.ToString("N2")</td>
                            <td class="fw-semibold">@item.NetSalary.ToString("N2")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Payslip" asp-route-runId="@Model.RunId" asp-route-employeeId="@item.EmployeeId">View</a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
