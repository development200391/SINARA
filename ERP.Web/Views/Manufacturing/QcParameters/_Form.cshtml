@model ERP.Web.ViewModels.Manufacturing.ManufacturingQcParameterEditViewModel
@using ERP.Domain.Enums.Manufacturing
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ItemId" class="form-label">@T["Item"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.ItemId),
                    Id = Html.IdFor(x => x.ItemId).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.ItemId.HasValue
                        ? Model.ItemId.Value.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.ItemOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Label
                    }).ToList()
                })
                <span asp-validation-for="ItemId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ParameterType" class="form-label">@T["Parameter Type"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.ParameterType),
                    Id = Html.IdFor(x => x.ParameterType).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.ParameterType.ToString(),
                    Options = Enum.GetValues<QcParameterType>().Select(type => new SearchableSelectOptionViewModel
                    {
                        Value = type.ToString(),
                        Label = T[type.ToString()]
                    }).ToList()
                })
            </div>
            <div class="col-md-3">
                <label asp-for="MinValue" class="form-label">@T["Min Value"]</label>
                <input asp-for="MinValue" class="form-control" type="number" step="0.0001" />
                <span asp-validation-for="MinValue" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="MaxValue" class="form-label">@T["Max Value"]</label>
                <input asp-for="MaxValue" class="form-control" type="number" step="0.0001" />
                <span asp-validation-for="MaxValue" class="text-danger"></span>
            </div>
            <div class="col-md-3 d-flex align-items-center gap-4">
                <div class="mt-4">
                    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                    {
                        Name = nameof(Model.IsCritical),
                        Id = Html.IdFor(x => x.IsCritical).ToString(),
                        Label = T["Critical"],
                        Checked = Model.IsCritical
                    })
                </div>
                <div class="mt-4">
                    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                    {
                        Name = nameof(Model.IsActive),
                        Id = Html.IdFor(x => x.IsActive).ToString(),
                        Label = T["Active"],
                        Checked = Model.IsActive
                    })
                </div>
            </div>
            <div class="col-md-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@T["common.save"]</button>
            <a asp-action="QcParameters" class="btn btn-outline-secondary">@T["common.back"]</a>
        </div>
    </div>
</div>
