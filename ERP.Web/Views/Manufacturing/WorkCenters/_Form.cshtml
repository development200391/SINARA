@model ERP.Web.ViewModels.Manufacturing.ManufacturingWorkCenterEditViewModel
@using ERP.Web.ViewModels.Shared

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="WipAccountId" class="form-label">@T["WIP Account Id"]</label>
                <input asp-for="WipAccountId" class="form-control" type="number" min="1" />
                <span asp-validation-for="WipAccountId" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="CapacityHoursPerDay" class="form-label">@T["Capacity Hours/Day"]</label>
                <input asp-for="CapacityHoursPerDay" class="form-control" type="number" min="0.01" step="0.01" />
                <span asp-validation-for="CapacityHoursPerDay" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="LaborCostPerHour" class="form-label">@T["Labor Cost/Hour"]</label>
                <input asp-for="LaborCostPerHour" class="form-control" type="number" min="0" step="0.01" />
                <span asp-validation-for="LaborCostPerHour" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="OverheadCostPerHour" class="form-label">@T["Overhead Cost/Hour"]</label>
                <input asp-for="OverheadCostPerHour" class="form-control" type="number" min="0" step="0.01" />
                <span asp-validation-for="OverheadCostPerHour" class="text-danger"></span>
            </div>
            <div class="col-md-9">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-md-3 d-flex align-items-center">
                <div class="mt-4">
                    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                    {
                        Name = nameof(Model.IsActive),
                        Id = Html.IdFor(x => x.IsActive).ToString(),
                        Label = T["Active"],
                        Checked = Model.IsActive
                    })
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@T["common.save"]</button>
            <a asp-action="WorkCenters" class="btn btn-outline-secondary">@T["common.back"]</a>
        </div>
    </div>
</div>
