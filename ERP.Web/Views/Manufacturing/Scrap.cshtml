@model ERP.Web.ViewModels.Manufacturing.ManufacturingScrapRecordsIndexViewModel
@using ERP.Application.DTOs.Manufacturing
@using ERP.Domain.Enums.Manufacturing
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Scrap"]</h1>

        @{
            var selectedReason = Model.ReasonFilter.HasValue ? ((int)Model.ReasonFilter.Value).ToString(CultureInfo.InvariantCulture) : null;
            var reasonOptions = Enum.GetValues<ScrapReason>()
                .Select(x => new PagedGridFilterOptionViewModel { Value = ((int)x).ToString(CultureInfo.InvariantCulture), Label = x.ToString() })
                .ToList();

            PagedGridRowActionViewModel ResolveActions(ManufacturingScrapRecordDto item)
            {
                return new PagedGridRowActionViewModel
                {
                    EditUrl = Url.Action("EditScrap", "Manufacturing", new { id = item.Id }),
                    DeleteUrl = Url.Action("DeleteScrap", "Manufacturing", new { id = item.Id }),
                    DeleteConfirmMessage = T["Delete this data?"]
                };
            }

            var rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
            {
                Cells =
                [
                    new PagedGridCellViewModel { Text = item.Code },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.WorkOrderCode) ? "-" : item.WorkOrderCode },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.ItemCode) ? "-" : item.ItemCode },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.WorkCenterName) ? "-" : item.WorkCenterName },
                    new PagedGridCellViewModel { Text = item.Reason.ToString() },
                    new PagedGridCellViewModel { Text = item.QtyScrap.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.TotalScrapCost.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.RecordedAt.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) }
                ],
                Actions = ResolveActions(item)
            }).ToList();

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "code",
                        Title = T["Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "code",
                            Value = Model.CodeFilter,
                            Placeholder = T["Filter code"]
                        }
                    },
                    new PagedGridColumnViewModel { Key = "workorder", Title = T["Work Order"], Sortable = false },
                    new PagedGridColumnViewModel { Key = "item", Title = T["Item"], Sortable = false },
                    new PagedGridColumnViewModel { Key = "workcenter", Title = T["Work Center"], Sortable = false },
                    new PagedGridColumnViewModel
                    {
                        Key = "reason",
                        Title = T["Reason"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "reason",
                            Value = selectedReason,
                            EmptyOptionLabel = T["All"],
                            Options = reasonOptions
                        }
                    },
                    new PagedGridColumnViewModel { Key = "qtyscrap", Title = T["Qty Scrap"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "totalscrapcost", Title = T["Total Cost"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel
                    {
                        Key = "recordedat",
                        Title = T["Recorded At"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.DateRange,
                            QueryKey = "recordedFrom",
                            QueryKeyTo = "recordedTo",
                            Value = Model.RecordedFromFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            ValueTo = Model.RecordedToFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                        }
                    }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Scrap"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateScrap", "Manufacturing"),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
