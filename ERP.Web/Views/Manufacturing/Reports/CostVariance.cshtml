@model ERP.Web.ViewModels.Manufacturing.ManufacturingCostVarianceReportViewModel
@using ERP.Domain.Enums.Manufacturing
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Cost Variance"]</h1>

        @{
            var selectedStatus = Model.StatusFilter.HasValue ? ((int)Model.StatusFilter.Value).ToString(CultureInfo.InvariantCulture) : null;
            var statusOptions = Enum.GetValues<WorkOrderStatus>()
                .Select(x => new PagedGridFilterOptionViewModel { Value = ((int)x).ToString(CultureInfo.InvariantCulture), Label = x.ToString() })
                .ToList();

            var rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
            {
                Cells =
                [
                    new PagedGridCellViewModel { Text = item.WorkOrderCode },
                    new PagedGridCellViewModel { Text = item.StandardCostTotal.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.ActualCostTotal.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.VarianceAmount.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.VariancePct.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" }
                ]
            }).ToList();

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "workordercode",
                        Title = T["Work Order"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "status",
                            Value = selectedStatus,
                            EmptyOptionLabel = T["All Status"],
                            Options = statusOptions
                        }
                    },
                    new PagedGridColumnViewModel { Key = "standardcosttotal", Title = T["Standard Cost"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "actualcosttotal", Title = T["Actual Cost"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "varianceamount", Title = T["Variance Amount"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "variancepct", Title = T["Variance (%)"], Sortable = true, CellClass = "text-end" }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Cost Variance"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel { ActionColumnTitle = T["Action"] }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
