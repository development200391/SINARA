@model ERP.Web.ViewModels.Manufacturing.ManufacturingOeeReportViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["OEE Report"]</h1>

        @{
            var rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
            {
                Cells =
                [
                    new PagedGridCellViewModel { Text = item.WorkCenterCode },
                    new PagedGridCellViewModel { Text = item.WorkCenterName },
                    new PagedGridCellViewModel { Text = item.SnapshotDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) },
                    new PagedGridCellViewModel { Text = item.AvailabilityPct.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.PerformancePct.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.QualityPct.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.OeePct.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" }
                ]
            }).ToList();

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel { Key = "workcentercode", Title = T["Work Center Code"], Sortable = true },
                    new PagedGridColumnViewModel { Key = "workcentername", Title = T["Work Center Name"], Sortable = false },
                    new PagedGridColumnViewModel
                    {
                        Key = "snapshotdate",
                        Title = T["Snapshot Date"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.DateRange,
                            QueryKey = "snapshotDateFrom",
                            QueryKeyTo = "snapshotDateTo",
                            Value = Model.SnapshotDateFromFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            ValueTo = Model.SnapshotDateToFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                        }
                    },
                    new PagedGridColumnViewModel { Key = "availabilitypct", Title = T["Availability (%)"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "performancepct", Title = T["Performance (%)"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "qualitypct", Title = T["Quality (%)"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "oeepct", Title = T["OEE (%)"], Sortable = true, CellClass = "text-end" }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["OEE Report"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel { ActionColumnTitle = T["Action"] }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
