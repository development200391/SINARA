@model ERP.Web.ViewModels.Manufacturing.ManufacturingCapacityReportViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Capacity"]</h1>

        @{
            var rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
            {
                Cells =
                [
                    new PagedGridCellViewModel { Text = item.WorkCenterCode },
                    new PagedGridCellViewModel { Text = item.WorkCenterName },
                    new PagedGridCellViewModel { Text = item.CapacityHoursPerDay.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.PlannedQtyTotal.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.GoodQtyTotal.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.UtilizationPct.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" }
                ]
            }).ToList();

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel { Key = "workcentercode", Title = T["Work Center Code"], Sortable = true },
                    new PagedGridColumnViewModel { Key = "workcentername", Title = T["Work Center Name"], Sortable = false },
                    new PagedGridColumnViewModel { Key = "capacityhoursperday", Title = T["Capacity Hours/Day"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "plannedqtytotal", Title = T["Planned Qty Total"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "goodqtytotal", Title = T["Good Qty Total"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel
                    {
                        Key = "utilizationpct",
                        Title = T["Utilization (%)"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.DateRange,
                            QueryKey = "plannedStartFrom",
                            QueryKeyTo = "plannedStartTo",
                            Value = Model.PlannedStartFromFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            ValueTo = Model.PlannedStartToFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                        }
                    }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Capacity"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel { ActionColumnTitle = T["Action"] }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
