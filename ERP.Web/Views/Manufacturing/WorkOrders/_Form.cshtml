@model ERP.Web.ViewModels.Manufacturing.ManufacturingWorkOrderEditViewModel
@using ERP.Domain.Enums.Manufacturing
@using ERP.Web.ViewModels.Shared
@using System.Globalization

@{
    var itemSelectId = Html.IdFor(x => x.ItemId).ToString();
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ItemId" class="form-label">@T["Item"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.ItemId),
                    Id = itemSelectId,
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.ItemId > 0
                        ? Model.ItemId.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.ItemOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Label
                    }).ToList()
                })
                <span asp-validation-for="ItemId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="BomId" class="form-label">@T["BOM"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.BomId),
                    Id = Html.IdFor(x => x.BomId).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    DependsOnElementId = itemSelectId,
                    SelectedValue = Model.BomId > 0
                        ? Model.BomId.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.BomItemMappings.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Label,
                        GroupValue = option.ItemId?.ToString(CultureInfo.InvariantCulture)
                    }).ToList()
                })
                <span asp-validation-for="BomId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="MrpRunId" class="form-label">@T["MRP Run"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.MrpRunId),
                    Id = Html.IdFor(x => x.MrpRunId).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.MrpRunId.HasValue
                        ? Model.MrpRunId.Value.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.MrpRunOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Label
                    }).ToList()
                })
                <span asp-validation-for="MrpRunId" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="RoutingId" class="form-label">@T["Routing"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.RoutingId),
                    Id = Html.IdFor(x => x.RoutingId).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    DependsOnElementId = itemSelectId,
                    SelectedValue = Model.RoutingId.HasValue
                        ? Model.RoutingId.Value.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.RoutingItemMappings.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Label,
                        GroupValue = option.ItemId?.ToString(CultureInfo.InvariantCulture)
                    }).ToList()
                })
                <span asp-validation-for="RoutingId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="WorkCenterId" class="form-label">@T["Work Center"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.WorkCenterId),
                    Id = Html.IdFor(x => x.WorkCenterId).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.WorkCenterId.HasValue
                        ? Model.WorkCenterId.Value.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.WorkCenterOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Label
                    }).ToList()
                })
                <span asp-validation-for="WorkCenterId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label"></label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.Status),
                    Id = Html.IdFor(x => x.Status).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.Status.ToString(),
                    Options = Enum.GetValues<WorkOrderStatus>().Select(status => new SearchableSelectOptionViewModel
                    {
                        Value = status.ToString(),
                        Label = T[status.ToString()]
                    }).ToList()
                })
            </div>
            <div class="col-md-3">
                <label asp-for="ProductionType" class="form-label">@T["Production Type"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.ProductionType),
                    Id = Html.IdFor(x => x.ProductionType).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.ProductionType.ToString(),
                    Options = Enum.GetValues<ProductionType>().Select(type => new SearchableSelectOptionViewModel
                    {
                        Value = type.ToString(),
                        Label = T[type.ToString()]
                    }).ToList()
                })
            </div>

            <div class="col-md-3">
                <label asp-for="QtyPlanned" class="form-label">@T["Planned Qty"]</label>
                <input asp-for="QtyPlanned" class="form-control" type="number" min="0.0001" step="0.0001" />
                <span asp-validation-for="QtyPlanned" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="QtyGood" class="form-label">@T["Good Qty"]</label>
                <input asp-for="QtyGood" class="form-control" type="number" min="0" step="0.0001" />
                <span asp-validation-for="QtyGood" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="QtyScrap" class="form-label">@T["Scrap Qty"]</label>
                <input asp-for="QtyScrap" class="form-control" type="number" min="0" step="0.0001" />
                <span asp-validation-for="QtyScrap" class="text-danger"></span>
            </div>
            <div class="col-md-3 d-flex align-items-center">
                <div class="mt-4">
                    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                    {
                        Name = nameof(Model.IsActive),
                        Id = Html.IdFor(x => x.IsActive).ToString(),
                        Label = T["Active"],
                        Checked = Model.IsActive
                    })
                </div>
            </div>

            <div class="col-md-3">
                <label asp-for="PlannedStartDate" class="form-label">@T["Planned Start Date"]</label>
                <input asp-for="PlannedStartDate" class="form-control" type="date" />
                <span asp-validation-for="PlannedStartDate" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="PlannedEndDate" class="form-label">@T["Planned End Date"]</label>
                <input asp-for="PlannedEndDate" class="form-control" type="date" />
                <span asp-validation-for="PlannedEndDate" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ActualStartAt" class="form-label">@T["Actual Start At"]</label>
                <input asp-for="ActualStartAt" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" type="datetime-local" />
                <span asp-validation-for="ActualStartAt" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ActualEndAt" class="form-label">@T["Actual End At"]</label>
                <input asp-for="ActualEndAt" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" type="datetime-local" />
                <span asp-validation-for="ActualEndAt" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="StandardCostTotal" class="form-label">@T["Standard Cost Total"]</label>
                <input asp-for="StandardCostTotal" class="form-control" type="number" min="0" step="0.0001" />
                <span asp-validation-for="StandardCostTotal" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ActualCostTotal" class="form-label">@T["Actual Cost Total"]</label>
                <input asp-for="ActualCostTotal" class="form-control" type="number" min="0" step="0.0001" />
                <span asp-validation-for="ActualCostTotal" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@T["common.save"]</button>
            <a asp-action="WorkOrders" class="btn btn-outline-secondary">@T["common.back"]</a>
        </div>
    </div>
</div>
