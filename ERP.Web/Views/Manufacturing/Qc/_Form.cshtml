@model ERP.Web.ViewModels.Manufacturing.ManufacturingQcInspectionEditViewModel
@using System.Text.Json

@{
    var itemOptionsJson = JsonSerializer.Serialize(Model.ItemOptions.Select(x => new
    {
        id = x.Id,
        label = x.Label
    }));

    var workOrderItemMappingsJson = JsonSerializer.Serialize(Model.WorkOrderItemMappings.Select(x => new
    {
        id = x.Id,
        itemId = x.ItemId
    }));
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="WorkOrderId" class="form-label">@T["Work Order"]</label>
                <select asp-for="WorkOrderId" class="form-select">
                    <option value="">-- Select --</option>
                    @foreach (var option in Model.WorkOrderOptions)
                    {
                        <option value="@option.Id">@option.Label</option>
                    }
                </select>
                <span asp-validation-for="WorkOrderId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ItemId" class="form-label">@T["Item"]</label>
                <select asp-for="ItemId" class="form-select">
                    <option value="">-- Select --</option>
                    @foreach (var option in Model.ItemOptions)
                    {
                        <option value="@option.Id">@option.Label</option>
                    }
                </select>
                <span asp-validation-for="ItemId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="InspectorEmployeeId" class="form-label">@T["Inspector"]</label>
                <select asp-for="InspectorEmployeeId" class="form-select">
                    <option value="">-- Select --</option>
                    @foreach (var option in Model.InspectorEmployeeOptions)
                    {
                        <option value="@option.Id">@option.Name</option>
                    }
                </select>
                <span asp-validation-for="InspectorEmployeeId" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="InspectedAt" class="form-label">@T["Inspected At"]</label>
                <input asp-for="InspectedAt" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" type="datetime-local" />
                <span asp-validation-for="InspectedAt" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<ERP.Domain.Enums.Manufacturing.QcStatus>()" class="form-select"></select>
            </div>
            <div class="col-md-3">
                <label asp-for="Result" class="form-label"></label>
                <select asp-for="Result" asp-items="Html.GetEnumSelectList<ERP.Domain.Enums.Manufacturing.QcResult>()" class="form-select"></select>
            </div>
            <div class="col-md-3"></div>

            <div class="col-md-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@T["common.save"]</button>
            <a asp-action="Qc" class="btn btn-outline-secondary">@T["common.back"]</a>
        </div>
    </div>
</div>

<script>
    (() => {
        const workOrderSelect = document.getElementById('WorkOrderId');
        const itemSelect = document.getElementById('ItemId');

        if (!workOrderSelect || !itemSelect) {
            return;
        }

        const allItems = @Html.Raw(itemOptionsJson);
        const workOrderMappings = @Html.Raw(workOrderItemMappingsJson);
        const itemById = new Map(allItems.map((item) => [item.id, item]));
        const itemByWorkOrderId = new Map(
            workOrderMappings
                .filter((item) => Number.isInteger(item.itemId) && item.itemId > 0)
                .map((item) => [item.id, item.itemId])
        );

        const parseId = (value) => {
            const parsed = Number.parseInt(String(value || ''), 10);
            return Number.isFinite(parsed) && parsed > 0 ? parsed : null;
        };

        const setItemOptions = (options, selectedId) => {
            itemSelect.innerHTML = '';

            const placeholder = document.createElement('option');
            placeholder.value = '';
            placeholder.textContent = '-- Select --';
            itemSelect.appendChild(placeholder);

            for (const option of options) {
                const node = document.createElement('option');
                node.value = String(option.id);
                node.textContent = option.label;
                itemSelect.appendChild(node);
            }

            const normalizedSelectedId = parseId(selectedId);
            if (normalizedSelectedId && options.some((option) => option.id === normalizedSelectedId)) {
                itemSelect.value = String(normalizedSelectedId);
            }
            else {
                itemSelect.value = '';
            }
        };

        const refreshItemOptions = () => {
            const selectedWorkOrderId = parseId(workOrderSelect.value);
            const currentItemId = parseId(itemSelect.value);
            const mappedItemId = selectedWorkOrderId ? itemByWorkOrderId.get(selectedWorkOrderId) : null;

            if (mappedItemId && itemById.has(mappedItemId)) {
                setItemOptions([itemById.get(mappedItemId)], mappedItemId);
                return;
            }

            setItemOptions(allItems, currentItemId);
        };

        workOrderSelect.addEventListener('change', refreshItemOptions);
        refreshItemOptions();
    })();
</script>
