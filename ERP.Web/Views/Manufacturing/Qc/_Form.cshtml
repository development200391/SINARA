@model ERP.Web.ViewModels.Manufacturing.ManufacturingQcInspectionEditViewModel
@using ERP.Domain.Enums.Manufacturing
@using ERP.Web.ViewModels.Shared
@using System.Globalization
@using System.Text.Json

@{
    var workOrderSelectId = Html.IdFor(x => x.WorkOrderId).ToString();
    var itemSelectId = Html.IdFor(x => x.ItemId).ToString();

    var workOrderItemMapJson = JsonSerializer.Serialize(Model.WorkOrderItemMappings
        .Where(x => x.ItemId.HasValue)
        .ToDictionary(x => x.Id.ToString(CultureInfo.InvariantCulture), x => x.ItemId!.Value));
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="WorkOrderId" class="form-label">@T["Work Order"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.WorkOrderId),
                    Id = workOrderSelectId,
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.WorkOrderId.HasValue
                        ? Model.WorkOrderId.Value.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.WorkOrderOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Label
                    }).ToList()
                })
                <span asp-validation-for="WorkOrderId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ItemId" class="form-label">@T["Item"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.ItemId),
                    Id = itemSelectId,
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.ItemId.HasValue
                        ? Model.ItemId.Value.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.ItemOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Label
                    }).ToList()
                })
                <span asp-validation-for="ItemId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="InspectorEmployeeId" class="form-label">@T["Inspector"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.InspectorEmployeeId),
                    Id = Html.IdFor(x => x.InspectorEmployeeId).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.InspectorEmployeeId.HasValue
                        ? Model.InspectorEmployeeId.Value.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.InspectorEmployeeOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Name
                    }).ToList()
                })
                <span asp-validation-for="InspectorEmployeeId" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="InspectedAt" class="form-label">@T["Inspected At"]</label>
                <input asp-for="InspectedAt" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" type="datetime-local" />
                <span asp-validation-for="InspectedAt" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="Status" class="form-label"></label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.Status),
                    Id = Html.IdFor(x => x.Status).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.Status.ToString(),
                    Options = Enum.GetValues<QcStatus>().Select(status => new SearchableSelectOptionViewModel
                    {
                        Value = status.ToString(),
                        Label = T[status.ToString()]
                    }).ToList()
                })
            </div>
            <div class="col-md-3">
                <label asp-for="Result" class="form-label"></label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.Result),
                    Id = Html.IdFor(x => x.Result).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.Result.ToString(),
                    Options = Enum.GetValues<QcResult>().Select(result => new SearchableSelectOptionViewModel
                    {
                        Value = result.ToString(),
                        Label = T[result.ToString()]
                    }).ToList()
                })
            </div>
            <div class="col-md-3"></div>

            <div class="col-md-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@T["common.save"]</button>
            <a asp-action="Qc" class="btn btn-outline-secondary">@T["common.back"]</a>
        </div>
    </div>
</div>

<script>
    (() => {
        const workOrderItemMap = @Html.Raw(workOrderItemMapJson);

        const workOrderHidden = document.getElementById('@workOrderSelectId');
        const itemHost = document.getElementById('@itemSelectId')?.closest('[data-searchable-select]');

        if (!workOrderHidden || !itemHost) {
            return;
        }

        const selectItemOption = (value) => {
            const hidden = itemHost.querySelector('[data-searchable-select-value]');
            const labelNode = itemHost.querySelector('[data-searchable-select-label]');
            const options = Array.from(itemHost.querySelectorAll('[data-searchable-select-option]'));
            const target = options.find((option) => (option.getAttribute('data-value') || '') === value);

            if (!target || !(hidden instanceof HTMLInputElement)) {
                return;
            }

            hidden.value = value;
            if (labelNode) {
                labelNode.textContent = target.getAttribute('data-label') || target.textContent.trim();
            }
            options.forEach((option) => option.classList.toggle('active', option === target));
        };

        workOrderHidden.addEventListener('change', () => {
            const mappedItemId = workOrderItemMap[workOrderHidden.value];
            if (mappedItemId) {
                selectItemOption(String(mappedItemId));
            }
        });
    })();
</script>
