@model ERP.Web.ViewModels.Manufacturing.ManufacturingQcInspectionsIndexViewModel
@using ERP.Application.DTOs.Manufacturing
@using ERP.Domain.Enums.Manufacturing
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Quality Control"]</h1>

        @{
            var selectedStatus = Model.StatusFilter.HasValue ? ((int)Model.StatusFilter.Value).ToString(CultureInfo.InvariantCulture) : null;
            var selectedResult = Model.ResultFilter.HasValue ? ((int)Model.ResultFilter.Value).ToString(CultureInfo.InvariantCulture) : null;

            var statusOptions = Enum.GetValues<QcStatus>()
                .Select(x => new PagedGridFilterOptionViewModel { Value = ((int)x).ToString(CultureInfo.InvariantCulture), Label = x.ToString() })
                .ToList();
            var resultOptions = Enum.GetValues<QcResult>()
                .Select(x => new PagedGridFilterOptionViewModel { Value = ((int)x).ToString(CultureInfo.InvariantCulture), Label = x.ToString() })
                .ToList();

            PagedGridRowActionViewModel? ResolveActions(ManufacturingQcInspectionDto item)
            {
                return item.Status switch
                {
                    QcStatus.Pending => new PagedGridRowActionViewModel
                    {
                        EditUrl = Url.Action("EditQcInspection", "Manufacturing", new { id = item.Id }),
                        ApproveUrl = Url.Action("StartQc", "Manufacturing", new { id = item.Id }),
                        RejectUrl = Url.Action("CancelQc", "Manufacturing", new { id = item.Id }),
                        DeleteUrl = Url.Action("DeleteQc", "Manufacturing", new { id = item.Id }),
                        ApproveConfirmMessage = T["Start this QC inspection?"],
                        RejectConfirmMessage = T["Cancel this QC inspection?"],
                        DeleteConfirmMessage = T["Delete this data?"]
                    },
                    QcStatus.InProgress => new PagedGridRowActionViewModel
                    {
                        EditUrl = Url.Action("EditQcInspection", "Manufacturing", new { id = item.Id }),
                        ApproveUrl = Url.Action("PassQc", "Manufacturing", new { id = item.Id }),
                        RejectUrl = Url.Action("FailQc", "Manufacturing", new { id = item.Id }),
                        ApproveConfirmMessage = T["Mark QC as pass?"],
                        RejectConfirmMessage = T["Mark QC as fail?"]
                    },
                    _ => null
                };
            }

            var rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
            {
                Cells =
                [
                    new PagedGridCellViewModel { Text = item.Code },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.WorkOrderCode) ? "-" : item.WorkOrderCode },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.ItemCode) ? "-" : item.ItemCode },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.InspectorEmployeeName) ? "-" : item.InspectorEmployeeName },
                    new PagedGridCellViewModel { Text = item.Status.ToString() },
                    new PagedGridCellViewModel { Text = item.Result.ToString() },
                    new PagedGridCellViewModel { Text = item.InspectedAt.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.Notes) ? "-" : item.Notes }
                ],
                Actions = ResolveActions(item)
            }).ToList();

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "code",
                        Title = T["Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "code",
                            Value = Model.CodeFilter,
                            Placeholder = T["Filter code"]
                        }
                    },
                    new PagedGridColumnViewModel { Key = "workordercode", Title = T["Work Order"], Sortable = true },
                    new PagedGridColumnViewModel { Key = "itemcode", Title = T["Item"], Sortable = true },
                    new PagedGridColumnViewModel { Key = "inspector", Title = T["Inspector"], Sortable = false },
                    new PagedGridColumnViewModel
                    {
                        Key = "status",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "status",
                            Value = selectedStatus,
                            EmptyOptionLabel = T["All"],
                            Options = statusOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "result",
                        Title = T["Result"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "result",
                            Value = selectedResult,
                            EmptyOptionLabel = T["All"],
                            Options = resultOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "inspectedat",
                        Title = T["Inspected At"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.DateRange,
                            QueryKey = "inspectedFrom",
                            QueryKeyTo = "inspectedTo",
                            Value = Model.InspectedFromFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
                            ValueTo = Model.InspectedToFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                        }
                    },
                    new PagedGridColumnViewModel { Key = "notes", Title = T["Notes"], Sortable = false }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Quality Control"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateQcInspection", "Manufacturing"),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    ApproveButtonText = T["Process"],
                    RejectButtonText = T["Reject"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
