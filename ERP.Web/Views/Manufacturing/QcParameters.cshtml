@model ERP.Web.ViewModels.Manufacturing.ManufacturingQcParametersIndexViewModel
@using ERP.Domain.Enums.Manufacturing
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["QC Parameters"]</h1>

        @{
            var selectedType = Model.ParameterTypeFilter.HasValue ? ((int)Model.ParameterTypeFilter.Value).ToString(CultureInfo.InvariantCulture) : null;
            var selectedCritical = Model.IsCriticalFilter.HasValue ? (Model.IsCriticalFilter.Value ? "true" : "false") : null;
            var selectedActive = Model.IsActiveFilter.HasValue ? (Model.IsActiveFilter.Value ? "true" : "false") : null;

            var typeOptions = Enum.GetValues<QcParameterType>()
                .Select(x => new PagedGridFilterOptionViewModel { Value = ((int)x).ToString(CultureInfo.InvariantCulture), Label = x.ToString() })
                .ToList();
            var boolOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Yes"] },
                new() { Value = "false", Label = T["No"] }
            };
            var activeOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Active"] },
                new() { Value = "false", Label = T["Inactive"] }
            };

            var rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
            {
                Cells =
                [
                    new PagedGridCellViewModel { Text = item.Code },
                    new PagedGridCellViewModel { Text = item.Name },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.ItemCode) ? "-" : item.ItemCode },
                    new PagedGridCellViewModel { Text = item.ParameterType.ToString() },
                    new PagedGridCellViewModel { Text = item.MinValue.HasValue ? item.MinValue.Value.ToString("N2", CultureInfo.InvariantCulture) : "-", CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.MaxValue.HasValue ? item.MaxValue.Value.ToString("N2", CultureInfo.InvariantCulture) : "-", CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.IsCritical ? T["Yes"] : T["No"] },
                    new PagedGridCellViewModel { Text = item.IsActive ? T["Active"] : T["Inactive"] }
                ],
                Actions = new PagedGridRowActionViewModel
                {
                    EditUrl = Url.Action("EditQcParameter", "Manufacturing", new { id = item.Id }),
                    DeleteUrl = Url.Action("DeleteQcParameter", "Manufacturing", new { id = item.Id }),
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            }).ToList();

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "code",
                        Title = T["Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "code",
                            Value = Model.CodeFilter,
                            Placeholder = T["Filter code"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "name",
                        Title = T["Name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "name",
                            Value = Model.NameFilter,
                            Placeholder = T["Filter name"]
                        }
                    },
                    new PagedGridColumnViewModel { Key = "item", Title = T["Item"], Sortable = false },
                    new PagedGridColumnViewModel
                    {
                        Key = "parametertype",
                        Title = T["Parameter Type"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "parameterType",
                            Value = selectedType,
                            EmptyOptionLabel = T["All"],
                            Options = typeOptions
                        }
                    },
                    new PagedGridColumnViewModel { Key = "minvalue", Title = T["Min Value"], Sortable = false, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "maxvalue", Title = T["Max Value"], Sortable = false, CellClass = "text-end" },
                    new PagedGridColumnViewModel
                    {
                        Key = "iscritical",
                        Title = T["Critical"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isCritical",
                            Value = selectedCritical,
                            EmptyOptionLabel = T["All"],
                            Options = boolOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isactive",
                        Title = T["Active"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isActive",
                            Value = selectedActive,
                            EmptyOptionLabel = T["All"],
                            Options = activeOptions
                        }
                    }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["QC Parameters"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateQcParameter", "Manufacturing"),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
