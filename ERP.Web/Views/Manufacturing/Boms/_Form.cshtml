@model ERP.Web.ViewModels.Manufacturing.ManufacturingBomEditViewModel
@using ERP.Domain.Enums.Manufacturing
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ItemId" class="form-label">@T["Item"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.ItemId),
                    Id = Html.IdFor(x => x.ItemId).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.ItemId > 0
                        ? Model.ItemId.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.ItemOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Label
                    }).ToList()
                })
                <span asp-validation-for="ItemId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="RoutingId" class="form-label">@T["Routing"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.RoutingId),
                    Id = Html.IdFor(x => x.RoutingId).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.RoutingId.HasValue
                        ? Model.RoutingId.Value.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.RoutingOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Label
                    }).ToList()
                })
                <span asp-validation-for="RoutingId" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="EffectiveDate" class="form-label"></label>
                <input asp-for="EffectiveDate" class="form-control" type="date" />
                <span asp-validation-for="EffectiveDate" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="Version" class="form-label"></label>
                <input asp-for="Version" class="form-control" type="number" min="1" />
                <span asp-validation-for="Version" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="Status" class="form-label"></label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.Status),
                    Id = Html.IdFor(x => x.Status).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.Status.ToString(),
                    Options = Enum.GetValues<BomStatus>().Select(status => new SearchableSelectOptionViewModel
                    {
                        Value = status.ToString(),
                        Label = T[status.ToString()]
                    }).ToList()
                })
            </div>
            <div class="col-md-3">
                <label asp-for="QtyProduced" class="form-label">@T["Qty Produced"]</label>
                <input asp-for="QtyProduced" class="form-control" type="number" min="0.0001" step="0.0001" />
                <span asp-validation-for="QtyProduced" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="StandardCost" class="form-label">@T["Standard Cost"]</label>
                <input asp-for="StandardCost" class="form-control" type="number" min="0" step="0.0001" />
                <span asp-validation-for="StandardCost" class="text-danger"></span>
            </div>
            <div class="col-md-2 d-flex align-items-center">
                <div class="mt-4">
                    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                    {
                        Name = nameof(Model.IsActive),
                        Id = Html.IdFor(x => x.IsActive).ToString(),
                        Label = T["Active"],
                        Checked = Model.IsActive
                    })
                </div>
            </div>
            <div class="col-md-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@T["common.save"]</button>
            <a asp-action="Boms" class="btn btn-outline-secondary">@T["common.back"]</a>
        </div>
    </div>
</div>
