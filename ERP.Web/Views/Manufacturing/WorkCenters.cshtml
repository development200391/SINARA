@model ERP.Web.ViewModels.Manufacturing.ManufacturingWorkCentersIndexViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Work Centers"]</h1>

        @{
            var selectedActive = Model.IsActiveFilter.HasValue ? (Model.IsActiveFilter.Value ? "true" : "false") : null;
            var activeOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Active"] },
                new() { Value = "false", Label = T["Inactive"] }
            };

            var rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
            {
                Cells =
                [
                    new PagedGridCellViewModel { Text = item.Code },
                    new PagedGridCellViewModel { Text = item.Name },
                    new PagedGridCellViewModel { Text = item.CapacityHoursPerDay.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.LaborCostPerHour.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.OverheadCostPerHour.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.WipAccountCode) ? "-" : item.WipAccountCode },
                    new PagedGridCellViewModel { Text = item.IsActive ? T["Active"] : T["Inactive"] }
                ],
                Actions = new PagedGridRowActionViewModel
                {
                    EditUrl = Url.Action("EditWorkCenter", "Manufacturing", new { id = item.Id }),
                    DeleteUrl = Url.Action("DeleteWorkCenter", "Manufacturing", new { id = item.Id }),
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            }).ToList();

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "code",
                        Title = T["Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "code",
                            Value = Model.CodeFilter,
                            Placeholder = T["Filter code"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "name",
                        Title = T["Name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "name",
                            Value = Model.NameFilter,
                            Placeholder = T["Filter name"]
                        }
                    },
                    new PagedGridColumnViewModel { Key = "capacityhoursperday", Title = T["Capacity Hours/Day"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "laborcostperhour", Title = T["Labor Cost/Hour"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "overheadcostperhour", Title = T["Overhead Cost/Hour"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "wipaccount", Title = T["WIP Account"], Sortable = false },
                    new PagedGridColumnViewModel
                    {
                        Key = "isactive",
                        Title = T["Active"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isActive",
                            Value = selectedActive,
                            EmptyOptionLabel = T["All"],
                            Options = activeOptions
                        }
                    }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Work Centers"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateWorkCenter", "Manufacturing"),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
