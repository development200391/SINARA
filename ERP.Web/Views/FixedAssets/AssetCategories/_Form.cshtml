@model ERP.Web.ViewModels.FixedAssets.FixedAssetCategoryEditViewModel
@using ERP.Domain.Enums.FixedAssets
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-3">
        <label asp-for="Code" class="form-label">@T["Code"]</label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="Name" class="form-label">@T["Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DepreciationMethod" class="form-label">@T["Depreciation Method"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.DepreciationMethod),
            Id = Html.IdFor(x => x.DepreciationMethod).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.DepreciationMethod.ToString(),
            Options = new List<SearchableSelectOptionViewModel>
            {
                new() { Value = DepreciationMethod.StraightLine.ToString(), Label = T["Straight Line"] },
                new() { Value = DepreciationMethod.DecliningBalance.ToString(), Label = T["Declining Balance"] }
            }
        })
        <span asp-validation-for="DepreciationMethod" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="UsefulLifeMonths" class="form-label">@T["Useful Life (Months)"]</label>
        <input asp-for="UsefulLifeMonths" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="numeric" data-text-number-decimals="0" autocomplete="off" />
        <span asp-validation-for="UsefulLifeMonths" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="DepreciationRate" class="form-label">@T["Depreciation Rate"] (%)</label>
        <input asp-for="DepreciationRate" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="decimal" data-text-number-decimals="4" autocomplete="off" />
        <span asp-validation-for="DepreciationRate" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="AssetAccountId" class="form-label">@T["Asset"] @T["Account"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.AssetAccountId),
            Id = Html.IdFor(x => x.AssetAccountId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["None"],
            SelectedValue = Model.AssetAccountId.HasValue
                ? Model.AssetAccountId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.AccountOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="AssetAccountId" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="AccumulatedDepreciationAccountId" class="form-label">@T["Accumulated Depreciation"] @T["Account"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.AccumulatedDepreciationAccountId),
            Id = Html.IdFor(x => x.AccumulatedDepreciationAccountId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["None"],
            SelectedValue = Model.AccumulatedDepreciationAccountId.HasValue
                ? Model.AccumulatedDepreciationAccountId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.AccountOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="AccumulatedDepreciationAccountId" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="DepreciationExpenseAccountId" class="form-label">@T["Depreciation Expense"] @T["Account"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.DepreciationExpenseAccountId),
            Id = Html.IdFor(x => x.DepreciationExpenseAccountId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["None"],
            SelectedValue = Model.DepreciationExpenseAccountId.HasValue
                ? Model.DepreciationExpenseAccountId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.AccountOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="DepreciationExpenseAccountId" class="text-danger small"></span>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsActive),
            Id = Html.IdFor(x => x.IsActive).ToString(),
            Label = T["Active"],
            Checked = Model.IsActive
        })
    </div>
</div>
