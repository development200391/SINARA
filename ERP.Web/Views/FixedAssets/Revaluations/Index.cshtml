@model ERP.Web.ViewModels.FixedAssets.FixedAssetRevaluationsIndexViewModel
@using ERP.Domain.Enums.FixedAssets
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Revaluations"]</h1>

        @{
            var selectedAsset = Model.AssetIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedStatus = Model.StatusFilter.HasValue
                ? ((int)Model.StatusFilter.Value).ToString(CultureInfo.InvariantCulture)
                : null;
            var revaluationDateFrom = Model.RevaluationDateFromFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            var revaluationDateTo = Model.RevaluationDateToFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

            string LocalizeStatus(RevaluationStatus status)
            {
                return status switch
                {
                    RevaluationStatus.Draft => T["Draft"],
                    RevaluationStatus.Approved => T["Approved"],
                    RevaluationStatus.Posted => T["Posted"],
                    _ => status.ToString()
                };
            }

            string BuildStatusBadge(RevaluationStatus status)
            {
                return status switch
                {
                    RevaluationStatus.Draft => $"<span class=\"badge text-bg-secondary\">{LocalizeStatus(status)}</span>",
                    RevaluationStatus.Approved => $"<span class=\"badge text-bg-info\">{LocalizeStatus(status)}</span>",
                    RevaluationStatus.Posted => $"<span class=\"badge text-bg-success\">{LocalizeStatus(status)}</span>",
                    _ => $"<span class=\"badge text-bg-secondary\">{status}</span>"
                };
            }

            var assetOptions = Model.AssetOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var statusOptions = Enum.GetValues<RevaluationStatus>()
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = ((int)x).ToString(CultureInfo.InvariantCulture),
                    Label = LocalizeStatus(x)
                })
                .ToList();

            var rows = new List<PagedGridRowViewModel>();
            foreach (var item in Model.Items.Items)
            {
                var oldBookValueHtml = await Component.InvokeAsync("TextNumber", new { value = item.OldBookValue, decimals = 2, cssClass = "sinara-text-number-theme" });
                var newBookValueHtml = await Component.InvokeAsync("TextNumber", new { value = item.NewBookValue, decimals = 2, cssClass = "sinara-text-number-theme" });
                var impairmentAmountHtml = await Component.InvokeAsync("TextNumber", new { value = item.ImpairmentAmount, decimals = 2, cssClass = "sinara-text-number-theme" });

                var canEdit = item.Status == RevaluationStatus.Draft;
                var canDelete = item.Status == RevaluationStatus.Draft;
                var canProcess = item.Status is RevaluationStatus.Draft or RevaluationStatus.Approved;

                rows.Add(new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = item.RevaluationNo },
                        new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.AssetCode) ? item.AssetName : $"{item.AssetCode} - {item.AssetName}" },
                        new PagedGridCellViewModel { Text = item.RevaluationDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) },
                        new PagedGridCellViewModel { Html = oldBookValueHtml, CellClass = "text-end" },
                        new PagedGridCellViewModel { Html = newBookValueHtml, CellClass = "text-end" },
                        new PagedGridCellViewModel { Html = impairmentAmountHtml, CellClass = "text-end" },
                        new PagedGridCellViewModel { Html = new HtmlString(BuildStatusBadge(item.Status)) }
                    ],
                    Actions = new PagedGridRowActionViewModel
                    {
                        EditUrl = canEdit ? Url.Action("EditRevaluation", "FixedAssets", new { id = item.Id }) : null,
                        ApproveUrl = canProcess ? Url.Action("ProcessRevaluation", "FixedAssets", new { id = item.Id }) : null,
                        DeleteUrl = canDelete ? Url.Action("DeleteRevaluation", "FixedAssets", new { id = item.Id }) : null,
                        ApproveConfirmMessage = T["Process this data?"],
                        DeleteConfirmMessage = T["Delete this data?"]
                    }
                });
            }

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel { Key = "revaluationno", Title = T["Revaluation No"], Sortable = true },
                    new PagedGridColumnViewModel
                    {
                        Key = "assetcode",
                        Title = T["Asset"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "assetId",
                            Value = selectedAsset,
                            EmptyOptionLabel = T["All"],
                            Options = assetOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "revaluationdate",
                        Title = T["Revaluation Date"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.DateRange,
                            QueryKey = "revaluationDateFrom",
                            QueryKeyTo = "revaluationDateTo",
                            Value = revaluationDateFrom,
                            ValueTo = revaluationDateTo,
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel { Key = "oldbookvalue", Title = T["Old Book Value"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "newbookvalue", Title = T["New Book Value"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "impairmentamount", Title = T["Impairment Amount"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel
                    {
                        Key = "status",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "status",
                            Value = selectedStatus,
                            EmptyOptionLabel = T["All Status"],
                            Options = statusOptions
                        }
                    }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Revaluations"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateRevaluation", "FixedAssets"),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    ApproveButtonText = T["Process"],
                    DeleteButtonText = T["common.delete"],
                    ApproveConfirmMessage = T["Process this data?"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
