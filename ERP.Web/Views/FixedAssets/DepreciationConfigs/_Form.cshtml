@model ERP.Web.ViewModels.FixedAssets.FixedAssetDepreciationConfigEditViewModel
@using ERP.Web.ViewModels.Shared

<div class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <label asp-for="Name" class="form-label">@T["Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="FiscalYear" class="form-label">@T["Fiscal Year"]</label>
        <input asp-for="FiscalYear" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="numeric" data-text-number-decimals="0" autocomplete="off" />
        <span asp-validation-for="FiscalYear" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="RunDay" class="form-label">@T["Run Day"]</label>
        <input asp-for="RunDay" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="numeric" data-text-number-decimals="0" autocomplete="off" />
        <span asp-validation-for="RunDay" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="StartDate" class="form-label">@T["Start Date"]</label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="EndDate" class="form-label">@T["End Date"]</label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger small"></span>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsAutoPostJournal),
            Id = Html.IdFor(x => x.IsAutoPostJournal).ToString(),
            Label = T["Auto Post Journal"],
            Checked = Model.IsAutoPostJournal
        })
    </div>
    <div class="col-md-3 d-flex align-items-end">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsActive),
            Id = Html.IdFor(x => x.IsActive).ToString(),
            Label = T["Active"],
            Checked = Model.IsActive
        })
    </div>
</div>
