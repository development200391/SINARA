@model ERP.Web.ViewModels.FixedAssets.FixedAssetLocationsIndexViewModel
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Asset Locations"]</h1>

        @{
            var selectedDepartment = Model.DepartmentIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedIsActive = Model.IsActiveFilter.HasValue ? (Model.IsActiveFilter.Value ? "true" : "false") : null;

            string BuildStatusBadge(bool isActive)
            {
                return isActive
                    ? $"<span class=\"badge text-bg-success\">{T["Active"]}</span>"
                    : $"<span class=\"badge text-bg-secondary\">{T["Inactive"]}</span>";
            }

            var departmentOptions = Model.DepartmentOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var statusOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Active"] },
                new() { Value = "false", Label = T["Inactive"] }
            };

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "code",
                        Title = T["Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "code",
                            Value = Model.CodeFilter,
                            Placeholder = T["Filter code"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "name",
                        Title = T["Name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "name",
                            Value = Model.NameFilter,
                            Placeholder = T["Filter name"]
                        }
                    },
                    new PagedGridColumnViewModel { Key = "address", Title = T["Address"], Sortable = false },
                    new PagedGridColumnViewModel
                    {
                        Key = "departmentname",
                        Title = T["Department"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "departmentId",
                            Value = selectedDepartment,
                            EmptyOptionLabel = T["All Department"],
                            Options = departmentOptions
                        }
                    },
                    new PagedGridColumnViewModel { Key = "managername", Title = T["Manager"], Sortable = true },
                    new PagedGridColumnViewModel
                    {
                        Key = "isactive",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isActive",
                            Value = selectedIsActive,
                            EmptyOptionLabel = T["All Status"],
                            Options = statusOptions
                        }
                    }
                ],
                Rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = item.Code },
                        new PagedGridCellViewModel { Text = item.Name },
                        new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.Address) ? "-" : item.Address },
                        new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.DepartmentName) ? "-" : item.DepartmentName },
                        new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.ManagerName) ? "-" : item.ManagerName },
                        new PagedGridCellViewModel { Html = new HtmlString(BuildStatusBadge(item.IsActive)) }
                    ],
                    Actions = new PagedGridRowActionViewModel
                    {
                        EditUrl = Url.Action("EditLocation", "FixedAssets", new { id = item.Id }),
                        DeleteUrl = Url.Action("DeleteLocation", "FixedAssets", new { id = item.Id }),
                        DeleteConfirmMessage = T["Delete this data?"]
                    }
                }).ToList(),
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Asset Locations"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateLocation", "FixedAssets"),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
