@model ERP.Web.ViewModels.FixedAssets.FixedAssetLocationEditViewModel

<div class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-3">
        <label asp-for="Code" class="form-label">@T["Code"]</label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="Name" class="form-label">@T["Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DepartmentId" class="form-label">@T["Department"]</label>
        <select asp-for="DepartmentId" class="form-select">
            <option value="">@T["All Department"]</option>
            @foreach (var option in Model.DepartmentOptions)
            {
                <option value="@option.Id">@option.Label</option>
            }
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Address" class="form-label">@T["Address"]</label>
        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Address" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ManagerId" class="form-label">@T["Manager"]</label>
        <select asp-for="ManagerId" class="form-select">
            <option value="">@T["All Manager"]</option>
            @foreach (var option in Model.ManagerOptions)
            {
                <option value="@option.Id">@option.Label</option>
            }
        </select>
        <span asp-validation-for="ManagerId" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <div class="form-check mt-2">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">@T["Active"]</label>
        </div>
    </div>
</div>
