@model ERP.Web.ViewModels.FixedAssets.FixedAssetLocationEditViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-3">
        <label asp-for="Code" class="form-label">@T["Code"]</label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="Name" class="form-label">@T["Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DepartmentId" class="form-label">@T["Department"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.DepartmentId),
            Id = Html.IdFor(x => x.DepartmentId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All Department"],
            SelectedValue = Model.DepartmentId.HasValue
                ? Model.DepartmentId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.DepartmentOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
    </div>

    <div class="col-md-8">
        <label asp-for="Address" class="form-label">@T["Address"]</label>
        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Address" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ManagerId" class="form-label">@T["Manager"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.ManagerId),
            Id = Html.IdFor(x => x.ManagerId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All Manager"],
            SelectedValue = Model.ManagerId.HasValue
                ? Model.ManagerId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.ManagerOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="ManagerId" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsActive),
            Id = Html.IdFor(x => x.IsActive).ToString(),
            Label = T["Active"],
            Checked = Model.IsActive
        })
    </div>
</div>
