@model ERP.Web.ViewModels.FixedAssets.FixedAssetEditViewModel
@using ERP.Domain.Enums.FixedAssets
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-3">
        <label asp-for="AssetCode" class="form-label">@T["Asset Code"]</label>
        <input asp-for="AssetCode" class="form-control" placeholder="@T["Auto generate if empty"]" />
        <span asp-validation-for="AssetCode" class="text-danger small"></span>
    </div>
    <div class="col-md-5">
        <label asp-for="Name" class="form-label">@T["Name"]</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Status" class="form-label">@T["Status"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.Status),
            Id = Html.IdFor(x => x.Status).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.Status.ToString(),
            Options = new List<SearchableSelectOptionViewModel>
            {
                new() { Value = AssetStatus.Draft.ToString(), Label = T["Draft"] },
                new() { Value = AssetStatus.Active.ToString(), Label = T["Active"] },
                new() { Value = AssetStatus.InMaintenance.ToString(), Label = T["In Maintenance"] },
                new() { Value = AssetStatus.FullyDepreciated.ToString(), Label = T["Fully Depreciated"] },
                new() { Value = AssetStatus.Disposed.ToString(), Label = T["Disposed"] }
            }
        })
        <span asp-validation-for="Status" class="text-danger small"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="CategoryId" class="form-label">@T["Category"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.CategoryId),
            Id = Html.IdFor(x => x.CategoryId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select Category"],
            SelectedValue = Model.CategoryId > 0
                ? Model.CategoryId.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.CategoryOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="CategoryId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="LocationId" class="form-label">@T["Location"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.LocationId),
            Id = Html.IdFor(x => x.LocationId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select Location"],
            SelectedValue = Model.LocationId > 0
                ? Model.LocationId.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.LocationOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="LocationId" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DepartmentId" class="form-label">@T["Department"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.DepartmentId),
            Id = Html.IdFor(x => x.DepartmentId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["All Department"],
            SelectedValue = Model.DepartmentId.HasValue
                ? Model.DepartmentId.Value.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.DepartmentOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="AcquisitionDate" class="form-label">@T["Acquisition Date"]</label>
        <input asp-for="AcquisitionDate" type="date" class="form-control" />
        <span asp-validation-for="AcquisitionDate" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="InServiceDate" class="form-label">@T["In Service Date"]</label>
        <input asp-for="InServiceDate" type="date" class="form-control" />
        <span asp-validation-for="InServiceDate" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="UsefulLifeMonths" class="form-label">@T["Useful Life (Months)"]</label>
        <input asp-for="UsefulLifeMonths" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="numeric" data-text-number-decimals="0" autocomplete="off" />
        <span asp-validation-for="UsefulLifeMonths" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="DepreciationMethod" class="form-label">@T["Depreciation Method"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.DepreciationMethod),
            Id = Html.IdFor(x => x.DepreciationMethod).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.DepreciationMethod.ToString(),
            Options = new List<SearchableSelectOptionViewModel>
            {
                new() { Value = DepreciationMethod.StraightLine.ToString(), Label = T["Straight Line"] },
                new() { Value = DepreciationMethod.DecliningBalance.ToString(), Label = T["Declining Balance"] }
            }
        })
        <span asp-validation-for="DepreciationMethod" class="text-danger small"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="AcquisitionCost" class="form-label">@T["Acquisition Cost"]</label>
        <input asp-for="AcquisitionCost" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="decimal" data-text-number-decimals="2" autocomplete="off" />
        <span asp-validation-for="AcquisitionCost" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="SalvageValue" class="form-label">@T["Salvage Value"]</label>
        <input asp-for="SalvageValue" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="decimal" data-text-number-decimals="2" autocomplete="off" />
        <span asp-validation-for="SalvageValue" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="DepreciationRate" class="form-label">@T["Depreciation Rate"] (%)</label>
        <input asp-for="DepreciationRate" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="decimal" data-text-number-decimals="4" autocomplete="off" />
        <span asp-validation-for="DepreciationRate" class="text-danger small"></span>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsActive),
            Id = Html.IdFor(x => x.IsActive).ToString(),
            Label = T["Active"],
            Checked = Model.IsActive
        })
    </div>

    <div class="col-md-4">
        <label asp-for="SerialNumber" class="form-label">@T["Serial Number"]</label>
        <input asp-for="SerialNumber" class="form-control" />
        <span asp-validation-for="SerialNumber" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="VendorName" class="form-label">@T["Vendor Name"]</label>
        <input asp-for="VendorName" class="form-control" />
        <span asp-validation-for="VendorName" class="text-danger small"></span>
    </div>
    <div class="col-md-12">
        <label asp-for="Description" class="form-label">@T["Description"]</label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>
