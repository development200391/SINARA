@model ERP.Web.ViewModels.FixedAssets.FixedAssetMaintenanceOrdersIndexViewModel
@using ERP.Domain.Enums.FixedAssets
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Maintenance Orders"]</h1>

        @{
            var selectedAsset = Model.AssetIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedType = Model.MaintenanceTypeFilter.HasValue
                ? ((int)Model.MaintenanceTypeFilter.Value).ToString(CultureInfo.InvariantCulture)
                : null;
            var selectedStatus = Model.StatusFilter.HasValue
                ? ((int)Model.StatusFilter.Value).ToString(CultureInfo.InvariantCulture)
                : null;
            var orderDateFrom = Model.OrderDateFromFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            var orderDateTo = Model.OrderDateToFilter?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

            string LocalizeType(MaintenanceType type)
            {
                return type switch
                {
                    MaintenanceType.Preventive => T["Preventive"],
                    MaintenanceType.Corrective => T["Corrective"],
                    _ => type.ToString()
                };
            }

            string LocalizeStatus(MaintenanceStatus status)
            {
                return status switch
                {
                    MaintenanceStatus.Open => T["Open"],
                    MaintenanceStatus.InProgress => T["In Progress"],
                    MaintenanceStatus.Completed => T["Completed"],
                    MaintenanceStatus.Cancelled => T["Cancelled"],
                    _ => status.ToString()
                };
            }

            string BuildStatusBadge(MaintenanceStatus status)
            {
                return status switch
                {
                    MaintenanceStatus.Open => $"<span class=\"badge text-bg-secondary\">{LocalizeStatus(status)}</span>",
                    MaintenanceStatus.InProgress => $"<span class=\"badge text-bg-warning text-dark\">{LocalizeStatus(status)}</span>",
                    MaintenanceStatus.Completed => $"<span class=\"badge text-bg-success\">{LocalizeStatus(status)}</span>",
                    MaintenanceStatus.Cancelled => $"<span class=\"badge text-bg-danger\">{LocalizeStatus(status)}</span>",
                    _ => $"<span class=\"badge text-bg-secondary\">{status}</span>"
                };
            }

            var assetOptions = Model.AssetOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var typeOptions = Enum.GetValues<MaintenanceType>()
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = ((int)x).ToString(CultureInfo.InvariantCulture),
                    Label = LocalizeType(x)
                })
                .ToList();

            var statusOptions = Enum.GetValues<MaintenanceStatus>()
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = ((int)x).ToString(CultureInfo.InvariantCulture),
                    Label = LocalizeStatus(x)
                })
                .ToList();

            var rows = new List<PagedGridRowViewModel>();
            foreach (var item in Model.Items.Items)
            {
                var isEditable = item.Status is not (MaintenanceStatus.Completed or MaintenanceStatus.Cancelled);
                var canDelete = item.Status == MaintenanceStatus.Open;
                var canProcess = item.Status is MaintenanceStatus.Open or MaintenanceStatus.InProgress;
                var canCancel = item.Status is MaintenanceStatus.Open or MaintenanceStatus.InProgress;

                var costHtml = await Component.InvokeAsync("TextNumber", new { value = item.Cost, decimals = 2, cssClass = "sinara-text-number-theme" });

                rows.Add(new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = item.WorkOrderNo },
                        new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.AssetCode) ? item.AssetName : $"{item.AssetCode} - {item.AssetName}" },
                        new PagedGridCellViewModel { Text = item.OrderDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) },
                        new PagedGridCellViewModel { Text = LocalizeType(item.MaintenanceType) },
                        new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.VendorName) ? "-" : item.VendorName },
                        new PagedGridCellViewModel { Html = costHtml, CellClass = "text-end" },
                        new PagedGridCellViewModel { Text = item.IsCapitalized ? T["Yes"] : T["No"] },
                        new PagedGridCellViewModel { Html = new HtmlString(BuildStatusBadge(item.Status)) }
                    ],
                    Actions = new PagedGridRowActionViewModel
                    {
                        EditUrl = isEditable ? Url.Action("EditMaintenanceOrder", "FixedAssets", new { id = item.Id }) : null,
                        ApproveUrl = canProcess ? Url.Action("ProcessMaintenanceOrder", "FixedAssets", new { id = item.Id }) : null,
                        RejectUrl = canCancel ? Url.Action("CancelMaintenanceOrder", "FixedAssets", new { id = item.Id }) : null,
                        DeleteUrl = canDelete ? Url.Action("DeleteMaintenanceOrder", "FixedAssets", new { id = item.Id }) : null,
                        ApproveConfirmMessage = T["Process this data?"],
                        RejectConfirmMessage = T["Cancel this data?"],
                        DeleteConfirmMessage = T["Delete this data?"]
                    }
                });
            }

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel { Key = "workorderno", Title = T["Work Order No"], Sortable = true },
                    new PagedGridColumnViewModel
                    {
                        Key = "assetcode",
                        Title = T["Asset"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "assetId",
                            Value = selectedAsset,
                            EmptyOptionLabel = T["All"],
                            Options = assetOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "orderdate",
                        Title = T["Order Date"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.DateRange,
                            QueryKey = "orderDateFrom",
                            QueryKeyTo = "orderDateTo",
                            Value = orderDateFrom,
                            ValueTo = orderDateTo,
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "maintenancetype",
                        Title = T["Maintenance Type"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "maintenanceType",
                            Value = selectedType,
                            EmptyOptionLabel = T["All Type"],
                            Options = typeOptions
                        }
                    },
                    new PagedGridColumnViewModel { Key = "vendor", Title = T["Vendor"], Sortable = false },
                    new PagedGridColumnViewModel { Key = "cost", Title = T["Cost"], Sortable = true, CellClass = "text-end" },
                    new PagedGridColumnViewModel { Key = "capitalized", Title = T["Capitalized"], Sortable = false },
                    new PagedGridColumnViewModel
                    {
                        Key = "status",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "status",
                            Value = selectedStatus,
                            EmptyOptionLabel = T["All Status"],
                            Options = statusOptions
                        }
                    }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Maintenance Orders"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateMaintenanceOrder", "FixedAssets"),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    ApproveButtonText = T["Process"],
                    RejectButtonText = T["Cancel"],
                    DeleteButtonText = T["common.delete"],
                    ApproveConfirmMessage = T["Process this data?"],
                    RejectConfirmMessage = T["Cancel this data?"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
