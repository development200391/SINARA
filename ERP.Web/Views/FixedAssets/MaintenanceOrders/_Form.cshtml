@model ERP.Web.ViewModels.FixedAssets.FixedAssetMaintenanceOrderEditViewModel
@using ERP.Domain.Enums.FixedAssets
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <label asp-for="AssetId" class="form-label">@T["Asset"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.AssetId),
            Id = Html.IdFor(x => x.AssetId).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select Asset"],
            SelectedValue = Model.AssetId > 0
                ? Model.AssetId.ToString(CultureInfo.InvariantCulture)
                : null,
            Options = Model.AssetOptions.Select(option => new SearchableSelectOptionViewModel
            {
                Value = option.Id.ToString(CultureInfo.InvariantCulture),
                Label = option.Label
            }).ToList()
        })
        <span asp-validation-for="AssetId" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="OrderDate" class="form-label">@T["Order Date"]</label>
        <input asp-for="OrderDate" type="date" class="form-control" />
        <span asp-validation-for="OrderDate" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="MaintenanceType" class="form-label">@T["Maintenance Type"]</label>
        @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
        {
            Name = nameof(Model.MaintenanceType),
            Id = Html.IdFor(x => x.MaintenanceType).ToString(),
            SearchPlaceholder = T["Search"],
            EmptyOptionLabel = T["Select"],
            SelectedValue = Model.MaintenanceType.ToString(),
            Options = new List<SearchableSelectOptionViewModel>
            {
                new() { Value = MaintenanceType.Preventive.ToString(), Label = T["Preventive"] },
                new() { Value = MaintenanceType.Corrective.ToString(), Label = T["Corrective"] }
            }
        })
        <span asp-validation-for="MaintenanceType" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="VendorName" class="form-label">@T["Vendor"]</label>
        <input asp-for="VendorName" class="form-control" />
        <span asp-validation-for="VendorName" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Cost" class="form-label">@T["Cost"]</label>
        <input asp-for="Cost" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="decimal" data-text-number-decimals="2" autocomplete="off" />
        <span asp-validation-for="Cost" class="text-danger small"></span>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
        {
            Name = nameof(Model.IsCapitalized),
            Id = Html.IdFor(x => x.IsCapitalized).ToString(),
            Label = T["Capitalized"],
            Checked = Model.IsCapitalized
        })
    </div>

    <div class="col-12">
        <label asp-for="Notes" class="form-label">@T["Notes"]</label>
        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Notes" class="text-danger small"></span>
    </div>
</div>
