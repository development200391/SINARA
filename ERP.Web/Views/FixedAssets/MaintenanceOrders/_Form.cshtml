@model ERP.Web.ViewModels.FixedAssets.FixedAssetMaintenanceOrderEditViewModel
@using ERP.Domain.Enums.FixedAssets

<div class="row g-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <label asp-for="AssetId" class="form-label">@T["Asset"]</label>
        <select asp-for="AssetId" class="form-select">
            <option value="">@T["Select Asset"]</option>
            @foreach (var option in Model.AssetOptions)
            {
                <option value="@option.Id">@option.Label</option>
            }
        </select>
        <span asp-validation-for="AssetId" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="OrderDate" class="form-label">@T["Order Date"]</label>
        <input asp-for="OrderDate" type="date" class="form-control" />
        <span asp-validation-for="OrderDate" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="MaintenanceType" class="form-label">@T["Maintenance Type"]</label>
        <select asp-for="MaintenanceType" class="form-select">
            <option value="@MaintenanceType.Preventive">@T["Preventive"]</option>
            <option value="@MaintenanceType.Corrective">@T["Corrective"]</option>
        </select>
        <span asp-validation-for="MaintenanceType" class="text-danger small"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="VendorName" class="form-label">@T["Vendor"]</label>
        <input asp-for="VendorName" class="form-control" />
        <span asp-validation-for="VendorName" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Cost" class="form-label">@T["Cost"]</label>
        <input asp-for="Cost" class="form-control text-end sinara-text-number sinara-text-number-theme sinara-text-number-input" type="text" inputmode="decimal" data-text-number-decimals="2" autocomplete="off" />
        <span asp-validation-for="Cost" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <div class="form-check mt-4 pt-2">
            <input asp-for="IsCapitalized" class="form-check-input" />
            <label asp-for="IsCapitalized" class="form-check-label">@T["Capitalized"]</label>
        </div>
    </div>

    <div class="col-12">
        <label asp-for="Notes" class="form-label">@T["Notes"]</label>
        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Notes" class="text-danger small"></span>
    </div>
</div>
