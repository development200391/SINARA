@model ERP.Web.ViewModels.Config.ConfigMenuEditViewModel

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Add Menu"]</h1>

        <form asp-action="Create" method="post" class="row g-3">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="col-md-4">
                <label asp-for="ModuleId" class="form-label">@T["Module"]</label>
                <select asp-for="ModuleId" class="form-select" id="moduleSelect">
                    @foreach (var module in Model.AvailableModules)
                    {
                        <option value="@module.Id">@module.Name (@module.Code)</option>
                    }
                </select>
                <div class="form-text">Ganti modul akan reload daftar parent menu.</div>
            </div>

            <div class="col-md-4">
                <label asp-for="ParentId" class="form-label">@T["Parent Menu"]</label>
                <select asp-for="ParentId" class="form-select">
                    <option value="">@T["(No parent)"]</option>
                    @foreach (var parent in Model.AvailableParents)
                    {
                        <option value="@parent.Id">@parent.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="SortOrder" class="form-label">@T["Sort Order"]</label>
                <input asp-for="SortOrder" class="form-control" type="number" min="1" />
                <span asp-validation-for="SortOrder" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Name" class="form-label">@T["Name"]</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Icon" class="form-label">@T["Icon (Bootstrap Icon)"]</label>
                <input asp-for="Icon" class="form-control" placeholder="bi-list-ul" />
                <span asp-validation-for="Icon" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Url" class="form-label">@T["URL"]</label>
                <input asp-for="Url" class="form-control" placeholder="/config/users" />
                <span asp-validation-for="Url" class="text-danger"></span>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">@T["Active"]</label>
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" asp-route-moduleId="@Model.ModuleId" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const moduleSelect = document.getElementById('moduleSelect');
            if (!moduleSelect) {
                return;
            }

            moduleSelect.addEventListener('change', function () {
                const moduleId = moduleSelect.value;
                window.location.href = '@Url.Action("Create", "ConfigMenus")?moduleId=' + encodeURIComponent(moduleId);
            });
        })();
    </script>
}
