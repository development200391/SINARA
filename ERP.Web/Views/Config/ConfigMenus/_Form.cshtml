@model ERP.Web.ViewModels.Config.ConfigMenuEditViewModel

@{
    var isEdit = Model.Id > 0;
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@(isEdit ? T["Edit Menu"] : T["Add Menu"])</h1>

        @if (isEdit)
        {
            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <partial name="_FormFields" />

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" asp-route-moduleId="@Model.ModuleId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        }
        else
        {
            <form asp-action="Create" method="post" class="row g-3">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <partial name="_FormFields" />

                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-action="Index" asp-route-moduleId="@Model.ModuleId" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        }
    </div>
</div>
