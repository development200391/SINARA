@model ERP.Web.ViewModels.Config.ConfigUsersIndexViewModel
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Users"]</h1>

        @{
            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "username",
                        Title = T["Username"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "username",
                            Value = Model.UsernameFilter,
                            Placeholder = T["Filter username"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "fullName",
                        Title = T["label.full_name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "fullName",
                            Value = Model.FullNameFilter,
                            Placeholder = T["Filter full name"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "email",
                        Title = T["Email"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "email",
                            Value = Model.EmailFilter,
                            Placeholder = T["Filter email"]
                        }
                    },
                    new PagedGridColumnViewModel { Key = "roles", Title = T["Roles"] },
                    new PagedGridColumnViewModel { Key = "isActive", Title = T["Status"], Sortable = true }
                ],
                Rows = Model.Users.Items.Select(user => new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = user.Username },
                        new PagedGridCellViewModel { Text = user.FullName },
                        new PagedGridCellViewModel { Text = user.Email },
                        new PagedGridCellViewModel { Text = string.Join(", ", user.Roles) },
                        new PagedGridCellViewModel
                        {
                            Html = new HtmlString(user.IsActive
                                ? "<span class=\"badge text-bg-success\">Active</span>"
                                : "<span class=\"badge text-bg-secondary\">Inactive</span>")
                        }
                    ],
                    Actions = new PagedGridRowActionViewModel
                    {
                        DetailUrl = Url.Action("Details", "ConfigUsers", new { id = user.Id }),
                        EditUrl = Url.Action("Edit", "ConfigUsers", new { id = user.Id }),
                        DeleteUrl = Url.Action("Delete", "ConfigUsers", new { id = user.Id }),
                        DeleteConfirmMessage = T["Delete this user?"]
                    }
                }).ToList(),
                EmptyMessage = T["msg.no_data"],
                Page = Model.Users.Page,
                TotalPages = Model.Users.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = $"{T["common.search"]} users",
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("Create", "ConfigUsers"),
                    AddButtonText = T["common.add_new"],
                    DetailButtonText = T["Detail"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this user?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
