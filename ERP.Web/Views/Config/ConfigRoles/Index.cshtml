@model ERP.Web.ViewModels.Config.ConfigRolesIndexViewModel
@using ERP.Web.ViewModels.Shared
@using Microsoft.AspNetCore.Html

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Roles & Permissions"]</h1>

        @{
            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel { Key = "name", Title = T["Name"] },
                    new PagedGridColumnViewModel { Key = "description", Title = T["Description"] },
                    new PagedGridColumnViewModel { Key = "isSystem", Title = T["System"] },
                    new PagedGridColumnViewModel { Key = "isActive", Title = T["Status"] }
                ],
                Rows = Model.Roles.Select(role => new PagedGridRowViewModel
                {
                    Cells =
                    [
                        new PagedGridCellViewModel { Text = role.Name },
                        new PagedGridCellViewModel { Text = role.Description },
                        new PagedGridCellViewModel
                        {
                            Html = new HtmlString(role.IsSystem
                                ? "<span class=\"badge text-bg-secondary\">Yes</span>"
                                : "<span class=\"badge text-bg-light\">No</span>")
                        },
                        new PagedGridCellViewModel
                        {
                            Html = new HtmlString(role.IsActive
                                ? "<span class=\"badge text-bg-success\">Active</span>"
                                : "<span class=\"badge text-bg-secondary\">Inactive</span>")
                        }
                    ],
                    Actions = new PagedGridRowActionViewModel
                    {
                        EditUrl = Url.Action("Permissions", "ConfigRoles", new { id = role.Id })
                    }
                }).ToList(),
                EmptyMessage = T["msg.no_data"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    EditButtonText = T["Permission Matrix"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
