@model ERP.Web.ViewModels.Config.ConfigRolePermissionsViewModel
@using ERP.Web.ViewModels.Shared

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-1">@T["Permission Matrix"]</h1>
        <p class="text-muted mb-3">Role: <strong>@Model.Role?.Name</strong></p>

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Matrix.RoleId" />

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>@T["Menu"]</th>
                            <th class="text-center">
                                <div class="d-flex flex-column align-items-center gap-1">
                                    <span>@T["View"]</span>
                                    <div class="d-flex justify-content-center">
                                        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                        {
                                            Name = "SelectAllView",
                                            Id = "select-all-view",
                                            Label = T["Check All"],
                                            EmitHiddenFallback = false,
                                            HtmlAttributes = new Dictionary<string, string> { ["data-select-all-col"] = "view" }
                                        })
                                    </div>
                                </div>
                            </th>
                            <th class="text-center">
                                <div class="d-flex flex-column align-items-center gap-1">
                                    <span>@T["Create"]</span>
                                    <div class="d-flex justify-content-center">
                                        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                        {
                                            Name = "SelectAllCreate",
                                            Id = "select-all-create",
                                            Label = T["Check All"],
                                            EmitHiddenFallback = false,
                                            HtmlAttributes = new Dictionary<string, string> { ["data-select-all-col"] = "create" }
                                        })
                                    </div>
                                </div>
                            </th>
                            <th class="text-center">
                                <div class="d-flex flex-column align-items-center gap-1">
                                    <span>@T["Edit"]</span>
                                    <div class="d-flex justify-content-center">
                                        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                        {
                                            Name = "SelectAllEdit",
                                            Id = "select-all-edit",
                                            Label = T["Check All"],
                                            EmitHiddenFallback = false,
                                            HtmlAttributes = new Dictionary<string, string> { ["data-select-all-col"] = "edit" }
                                        })
                                    </div>
                                </div>
                            </th>
                            <th class="text-center">
                                <div class="d-flex flex-column align-items-center gap-1">
                                    <span>@T["Delete"]</span>
                                    <div class="d-flex justify-content-center">
                                        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                        {
                                            Name = "SelectAllDelete",
                                            Id = "select-all-delete",
                                            Label = T["Check All"],
                                            EmitHiddenFallback = false,
                                            HtmlAttributes = new Dictionary<string, string> { ["data-select-all-col"] = "delete" }
                                        })
                                    </div>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.Matrix.Permissions.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model.Matrix.Permissions[i].MenuName
                                <input type="hidden" asp-for="Matrix.Permissions[i].MenuId" />
                                <input type="hidden" asp-for="Matrix.Permissions[i].MenuName" />
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center">
                                    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                    {
                                        Name = Html.NameFor(x => x.Matrix.Permissions[i].CanView).ToString(),
                                        Id = Html.IdFor(x => x.Matrix.Permissions[i].CanView).ToString(),
                                        Label = string.Empty,
                                        Checked = Model.Matrix.Permissions[i].CanView,
                                        HtmlAttributes = new Dictionary<string, string> { ["data-permission-col"] = "view" }
                                    })
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center">
                                    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                    {
                                        Name = Html.NameFor(x => x.Matrix.Permissions[i].CanCreate).ToString(),
                                        Id = Html.IdFor(x => x.Matrix.Permissions[i].CanCreate).ToString(),
                                        Label = string.Empty,
                                        Checked = Model.Matrix.Permissions[i].CanCreate,
                                        HtmlAttributes = new Dictionary<string, string> { ["data-permission-col"] = "create" }
                                    })
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center">
                                    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                    {
                                        Name = Html.NameFor(x => x.Matrix.Permissions[i].CanEdit).ToString(),
                                        Id = Html.IdFor(x => x.Matrix.Permissions[i].CanEdit).ToString(),
                                        Label = string.Empty,
                                        Checked = Model.Matrix.Permissions[i].CanEdit,
                                        HtmlAttributes = new Dictionary<string, string> { ["data-permission-col"] = "edit" }
                                    })
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center">
                                    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                    {
                                        Name = Html.NameFor(x => x.Matrix.Permissions[i].CanDelete).ToString(),
                                        Id = Html.IdFor(x => x.Matrix.Permissions[i].CanDelete).ToString(),
                                        Label = string.Empty,
                                        Checked = Model.Matrix.Permissions[i].CanDelete,
                                        HtmlAttributes = new Dictionary<string, string> { ["data-permission-col"] = "delete" }
                                    })
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a class="btn btn-outline-secondary" asp-action="Index">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            document.querySelectorAll('[data-select-all-col]').forEach(function (headerCheckbox) {
                var col = headerCheckbox.getAttribute('data-select-all-col');
                var rowCheckboxes = document.querySelectorAll('[data-permission-col="' + col + '"]');

                var syncHeaderState = function () {
                    headerCheckbox.checked = rowCheckboxes.length > 0 && Array.prototype.every.call(rowCheckboxes, function (cb) { return cb.checked; });
                };

                headerCheckbox.addEventListener('change', function () {
                    rowCheckboxes.forEach(function (cb) { cb.checked = headerCheckbox.checked; });
                });

                rowCheckboxes.forEach(function (cb) {
                    cb.addEventListener('change', syncHeaderState);
                });

                syncHeaderState();
            });
        })();
    </script>
}
