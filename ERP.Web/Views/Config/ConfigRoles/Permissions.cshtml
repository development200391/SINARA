@model ERP.Web.ViewModels.Config.ConfigRolePermissionsViewModel
@using ERP.Web.ViewModels.Shared

@{
    var moduleGroups = Model.Matrix.Permissions
        .Select((perm, idx) => (Perm: perm, Index: idx))
        .GroupBy(x =>
        {
            var name = x.Perm.MenuName ?? string.Empty;
            var sepIndex = name.IndexOf(" / ", StringComparison.Ordinal);
            return sepIndex > 0 ? name[..sepIndex] : name;
        })
        .ToList();
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-1">@T["Permission Matrix"]</h1>
        <p class="text-muted mb-3">Role: <strong>@Model.Role?.Name</strong></p>

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Matrix.RoleId" />

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>@T["Menu"]</th>
                            <th class="text-center">
                                <div class="d-flex flex-column align-items-center gap-1">
                                    <span>@T["View"]</span>
                                    <div class="d-flex justify-content-center">
                                        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                        {
                                            Name = "SelectAllView",
                                            Id = "select-all-view",
                                            Label = T["Check All"],
                                            EmitHiddenFallback = false,
                                            HtmlAttributes = new Dictionary<string, string> { ["data-select-all-col"] = "view" }
                                        })
                                    </div>
                                </div>
                            </th>
                            <th class="text-center">
                                <div class="d-flex flex-column align-items-center gap-1">
                                    <span>@T["Create"]</span>
                                    <div class="d-flex justify-content-center">
                                        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                        {
                                            Name = "SelectAllCreate",
                                            Id = "select-all-create",
                                            Label = T["Check All"],
                                            EmitHiddenFallback = false,
                                            HtmlAttributes = new Dictionary<string, string> { ["data-select-all-col"] = "create" }
                                        })
                                    </div>
                                </div>
                            </th>
                            <th class="text-center">
                                <div class="d-flex flex-column align-items-center gap-1">
                                    <span>@T["Edit"]</span>
                                    <div class="d-flex justify-content-center">
                                        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                        {
                                            Name = "SelectAllEdit",
                                            Id = "select-all-edit",
                                            Label = T["Check All"],
                                            EmitHiddenFallback = false,
                                            HtmlAttributes = new Dictionary<string, string> { ["data-select-all-col"] = "edit" }
                                        })
                                    </div>
                                </div>
                            </th>
                            <th class="text-center">
                                <div class="d-flex flex-column align-items-center gap-1">
                                    <span>@T["Delete"]</span>
                                    <div class="d-flex justify-content-center">
                                        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                        {
                                            Name = "SelectAllDelete",
                                            Id = "select-all-delete",
                                            Label = T["Check All"],
                                            EmitHiddenFallback = false,
                                            HtmlAttributes = new Dictionary<string, string> { ["data-select-all-col"] = "delete" }
                                        })
                                    </div>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var group in moduleGroups)
                    {
                        var moduleCode = group.Key;

                        <tr class="table-light">
                            <td colspan="5">
                                <div class="d-flex align-items-center gap-2">
                                    <strong>@moduleCode</strong>
                                    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                    {
                                        Name = $"SelectAllModule_{moduleCode}",
                                        Id = $"select-all-module-{moduleCode}",
                                        Label = T["Check All"],
                                        EmitHiddenFallback = false,
                                        HtmlAttributes = new Dictionary<string, string> { ["data-module-select-all"] = moduleCode }
                                    })
                                </div>
                            </td>
                        </tr>

                        foreach (var item in group)
                        {
                            var i = item.Index;
                            var menuName = item.Perm.MenuName ?? string.Empty;
                            var sepIndex = menuName.IndexOf(" / ", StringComparison.Ordinal);
                            var displayName = sepIndex > 0 ? menuName[(sepIndex + 3)..] : menuName;

                            <tr>
                                <td>
                                    @displayName
                                    <input type="hidden" asp-for="Matrix.Permissions[i].MenuId" />
                                    <input type="hidden" asp-for="Matrix.Permissions[i].MenuName" />
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center">
                                        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                        {
                                            Name = Html.NameFor(x => x.Matrix.Permissions[i].CanView).ToString(),
                                            Id = Html.IdFor(x => x.Matrix.Permissions[i].CanView).ToString(),
                                            Label = string.Empty,
                                            Checked = item.Perm.CanView,
                                            HtmlAttributes = new Dictionary<string, string> { ["data-permission-col"] = "view", ["data-module"] = moduleCode }
                                        })
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center">
                                        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                        {
                                            Name = Html.NameFor(x => x.Matrix.Permissions[i].CanCreate).ToString(),
                                            Id = Html.IdFor(x => x.Matrix.Permissions[i].CanCreate).ToString(),
                                            Label = string.Empty,
                                            Checked = item.Perm.CanCreate,
                                            HtmlAttributes = new Dictionary<string, string> { ["data-permission-col"] = "create", ["data-module"] = moduleCode }
                                        })
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center">
                                        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                        {
                                            Name = Html.NameFor(x => x.Matrix.Permissions[i].CanEdit).ToString(),
                                            Id = Html.IdFor(x => x.Matrix.Permissions[i].CanEdit).ToString(),
                                            Label = string.Empty,
                                            Checked = item.Perm.CanEdit,
                                            HtmlAttributes = new Dictionary<string, string> { ["data-permission-col"] = "edit", ["data-module"] = moduleCode }
                                        })
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center">
                                        @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                                        {
                                            Name = Html.NameFor(x => x.Matrix.Permissions[i].CanDelete).ToString(),
                                            Id = Html.IdFor(x => x.Matrix.Permissions[i].CanDelete).ToString(),
                                            Label = string.Empty,
                                            Checked = item.Perm.CanDelete,
                                            HtmlAttributes = new Dictionary<string, string> { ["data-permission-col"] = "delete", ["data-module"] = moduleCode }
                                        })
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a class="btn btn-outline-secondary" asp-action="Index">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function isAllChecked(selector) {
                var list = document.querySelectorAll(selector);
                return list.length > 0 && Array.prototype.every.call(list, function (cb) { return cb.checked; });
            }

            function toggleAll(selector, checked) {
                document.querySelectorAll(selector).forEach(function (cb) {
                    cb.checked = checked;
                });
            }

            function syncSelectAllStates() {
                document.querySelectorAll('[data-select-all-col]').forEach(function (headerCheckbox) {
                    var col = headerCheckbox.getAttribute('data-select-all-col');
                    headerCheckbox.checked = isAllChecked('[data-permission-col="' + col + '"]');
                });

                document.querySelectorAll('[data-module-select-all]').forEach(function (moduleCheckbox) {
                    var moduleCode = moduleCheckbox.getAttribute('data-module-select-all');
                    moduleCheckbox.checked = isAllChecked('[data-module="' + moduleCode + '"]');
                });
            }

            document.addEventListener('change', function (e) {
                var target = e.target;

                if (target.matches('[data-select-all-col]')) {
                    var col = target.getAttribute('data-select-all-col');
                    toggleAll('[data-permission-col="' + col + '"]', target.checked);
                    syncSelectAllStates();
                    return;
                }

                if (target.matches('[data-module-select-all]')) {
                    var moduleCode = target.getAttribute('data-module-select-all');
                    toggleAll('[data-module="' + moduleCode + '"]', target.checked);
                    syncSelectAllStates();
                    return;
                }

                if (target.matches('[data-permission-col]')) {
                    syncSelectAllStates();
                }
            });

            syncSelectAllStates();
        })();
    </script>
}
