@model ERP.Web.ViewModels.Config.ConfigRolePermissionsViewModel

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-1">@T["Permission Matrix"]</h1>
        <p class="text-muted mb-3">Role: <strong>@Model.Role?.Name</strong></p>

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Matrix.RoleId" />

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>@T["Menu"]</th>
                            <th class="text-center">@T["View"]</th>
                            <th class="text-center">@T["Create"]</th>
                            <th class="text-center">@T["Edit"]</th>
                            <th class="text-center">@T["Delete"]</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < Model.Matrix.Permissions.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model.Matrix.Permissions[i].MenuName
                                <input type="hidden" asp-for="Matrix.Permissions[i].MenuId" />
                                <input type="hidden" asp-for="Matrix.Permissions[i].MenuName" />
                            </td>
                            <td class="text-center"><input asp-for="Matrix.Permissions[i].CanView" class="form-check-input" /></td>
                            <td class="text-center"><input asp-for="Matrix.Permissions[i].CanCreate" class="form-check-input" /></td>
                            <td class="text-center"><input asp-for="Matrix.Permissions[i].CanEdit" class="form-check-input" /></td>
                            <td class="text-center"><input asp-for="Matrix.Permissions[i].CanDelete" class="form-check-input" /></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@T["common.save"]</button>
                <a class="btn btn-outline-secondary" asp-action="Index">@T["common.cancel"]</a>
            </div>
        </form>
    </div>
</div>
