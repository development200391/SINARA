@model IReadOnlyList<ERP.Application.DTOs.Config.LanguageDto>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Languages"]</h1>

        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>@T["Code"]</th>
                        <th>@T["Name"]</th>
                        <th>@T["Native Name"]</th>
                        <th>@T["Default"]</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">@T["msg.no_data"]</td></tr>
                }
                else
                {
                    foreach (var lang in Model)
                    {
                        <tr>
                            <td>@lang.Code</td>
                            <td>@lang.Name</td>
                            <td>@lang.NativeName</td>
                            <td>@(lang.IsDefault ? "Yes" : "No")</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
