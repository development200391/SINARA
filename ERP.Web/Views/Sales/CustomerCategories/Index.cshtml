@model ERP.Web.ViewModels.Sales.SalesCustomerCategoriesIndexViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Customer Categories"]</h1>

        @{
            var selectedPriceList = Model.DefaultPriceListIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedIsActive = Model.IsActiveFilter.HasValue ? (Model.IsActiveFilter.Value ? "true" : "false") : null;

            var priceListOptions = Model.PriceListOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Label
                })
                .ToList();

            var statusOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Active"] },
                new() { Value = "false", Label = T["Inactive"] }
            };

            var rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
            {
                Cells =
                [
                    new PagedGridCellViewModel { Text = item.Code },
                    new PagedGridCellViewModel { Text = item.Name },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.DefaultPriceListCode) ? "-" : $"{item.DefaultPriceListCode} - {item.DefaultPriceListName}" },
                    new PagedGridCellViewModel { Text = item.DefaultPaymentTerms.ToString(CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.DefaultCreditLimit.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.IsActive ? T["Active"] : T["Inactive"] }
                ],
                Actions = new PagedGridRowActionViewModel
                {
                    EditUrl = Url.Action("EditCustomerCategory", "Sales", new { id = item.Id }),
                    DeleteUrl = Url.Action("DeleteCustomerCategory", "Sales", new { id = item.Id }),
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            }).ToList();

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "code",
                        Title = T["Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "code",
                            Value = Model.CodeFilter,
                            Placeholder = T["Filter code"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "name",
                        Title = T["Name"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Text,
                            QueryKey = "name",
                            Value = Model.NameFilter,
                            Placeholder = T["Filter name"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "defaultpricelistname",
                        Title = T["Default Price List"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "defaultPriceListId",
                            Value = selectedPriceList,
                            EmptyOptionLabel = T["All"],
                            Options = priceListOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "defaultpaymentterms",
                        Title = T["Payment Terms"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "defaultPaymentTermsFrom",
                            QueryKeyTo = "defaultPaymentTermsTo",
                            Value = Model.DefaultPaymentTermsFromFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.DefaultPaymentTermsToFilter?.ToString(CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "defaultcreditlimit",
                        Title = T["Default Credit Limit"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "defaultCreditLimitFrom",
                            QueryKeyTo = "defaultCreditLimitTo",
                            Value = Model.DefaultCreditLimitFromFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.DefaultCreditLimitToFilter?.ToString(CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isactive",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isActive",
                            Value = selectedIsActive,
                            EmptyOptionLabel = T["All"],
                            Options = statusOptions
                        }
                    }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Customer Categories"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateCustomerCategory", "Sales"),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
