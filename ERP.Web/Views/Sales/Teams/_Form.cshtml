@model ERP.Web.ViewModels.Sales.SalesTeamEditViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="TeamLeaderId" class="form-label">@T["Team Leader"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.TeamLeaderId),
                    Id = Html.IdFor(x => x.TeamLeaderId).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select Employee"],
                    SelectedValue = Model.TeamLeaderId > 0
                        ? Model.TeamLeaderId.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.EmployeeOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Name
                    }).ToList()
                })
                <span asp-validation-for="TeamLeaderId" class="text-danger"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="MemberEmployeeIds" class="form-label">@T["Members"]</label>
                <select asp-for="MemberEmployeeIds" class="form-select" multiple size="10">
                    @foreach (var option in Model.EmployeeOptions)
                    {
                        <option value="@option.Id">@option.Name</option>
                    }
                </select>
                <div class="form-text">@T["Hold Ctrl or Cmd to select multiple employees"]</div>
            </div>
            <div class="col-md-4 d-flex align-items-center">
                <div class="mt-3">
                    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                    {
                        Name = nameof(Model.IsActive),
                        Id = Html.IdFor(x => x.IsActive).ToString(),
                        Label = T["Active"],
                        Checked = Model.IsActive
                    })
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@T["common.save"]</button>
            <a asp-action="Teams" class="btn btn-outline-secondary">@T["common.back"]</a>
        </div>
    </div>
</div>
