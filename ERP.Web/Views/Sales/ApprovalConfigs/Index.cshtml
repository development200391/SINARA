@model ERP.Web.ViewModels.Sales.SalesApprovalConfigsIndexViewModel
@using ERP.Web.ViewModels.Shared
@using ERP.Domain.Enums.Sales
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h5 mb-3">@T["Approval Configs"]</h1>

        @{
            string GetDocumentTypeLabel(SalesDocumentType type) => type switch
            {
                SalesDocumentType.SalesQuotation => T["Sales Quotation"],
                SalesDocumentType.SalesOrder => T["Sales Order"],
                _ => type.ToString()
            };

            var selectedDocumentType = Model.DocumentTypeFilter.HasValue ? ((int)Model.DocumentTypeFilter.Value).ToString(CultureInfo.InvariantCulture) : null;
            var selectedRole = Model.ApproverRoleIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedEmployee = Model.ApproverEmployeeIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedStatus = Model.IsActiveFilter.HasValue ? (Model.IsActiveFilter.Value ? "true" : "false") : null;

            var documentTypeOptions = Enum.GetValues<SalesDocumentType>()
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = ((int)x).ToString(CultureInfo.InvariantCulture),
                    Label = GetDocumentTypeLabel(x)
                })
                .ToList();

            var roleOptions = Model.RoleOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Name
                })
                .ToList();

            var employeeOptions = Model.EmployeeOptions
                .Select(x => new PagedGridFilterOptionViewModel
                {
                    Value = x.Id.ToString(CultureInfo.InvariantCulture),
                    Label = x.Name
                })
                .ToList();

            var statusOptions = new List<PagedGridFilterOptionViewModel>
            {
                new() { Value = "true", Label = T["Active"] },
                new() { Value = "false", Label = T["Inactive"] }
            };

            var rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
            {
                Cells =
                [
                    new PagedGridCellViewModel { Text = GetDocumentTypeLabel(item.DocumentType) },
                    new PagedGridCellViewModel { Text = item.Level.ToString(CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.MinAmount.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.MaxAmount.HasValue ? item.MaxAmount.Value.ToString("N2", CultureInfo.InvariantCulture) : "-", CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.MaxDiscountPct.HasValue ? item.MaxDiscountPct.Value.ToString("N2", CultureInfo.InvariantCulture) : "-", CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.ApproverRoleName) ? "-" : item.ApproverRoleName },
                    new PagedGridCellViewModel { Text = string.IsNullOrWhiteSpace(item.ApproverEmployeeName) ? "-" : item.ApproverEmployeeName },
                    new PagedGridCellViewModel { Text = item.IsActive ? T["Active"] : T["Inactive"] }
                ],
                Actions = new PagedGridRowActionViewModel
                {
                    EditUrl = Url.Action("EditApprovalConfig", "Sales", new { id = item.Id }),
                    DeleteUrl = Url.Action("DeleteApprovalConfig", "Sales", new { id = item.Id }),
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            }).ToList();

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "documenttype",
                        Title = T["Document Type"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "documentType",
                            Value = selectedDocumentType,
                            EmptyOptionLabel = T["All"],
                            Options = documentTypeOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "level",
                        Title = T["Level"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "level",
                            Value = Model.LevelFilter?.ToString(CultureInfo.InvariantCulture),
                            Placeholder = T["Level"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "minamount",
                        Title = T["Min Amount"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "minAmountFrom",
                            QueryKeyTo = "minAmountTo",
                            Value = Model.MinAmountFromFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.MinAmountToFilter?.ToString(CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "maxamount",
                        Title = T["Max Amount"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "maxAmountFrom",
                            QueryKeyTo = "maxAmountTo",
                            Value = Model.MaxAmountFromFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.MaxAmountToFilter?.ToString(CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "maxdiscountpct",
                        Title = T["Max Discount %"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "maxDiscountPctFrom",
                            QueryKeyTo = "maxDiscountPctTo",
                            Value = Model.MaxDiscountPctFromFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.MaxDiscountPctToFilter?.ToString(CultureInfo.InvariantCulture),
                            Placeholder = T["From"],
                            PlaceholderTo = T["To"]
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "approverrolename",
                        Title = T["Approver Role"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "approverRoleId",
                            Value = selectedRole,
                            EmptyOptionLabel = T["All"],
                            Options = roleOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "approveremployeename",
                        Title = T["Approver Employee"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "approverEmployeeId",
                            Value = selectedEmployee,
                            EmptyOptionLabel = T["All"],
                            Options = employeeOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "isactive",
                        Title = T["Status"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "isActive",
                            Value = selectedStatus,
                            EmptyOptionLabel = T["All"],
                            Options = statusOptions
                        }
                    }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.PageSize,
                SortBy = Model.SortBy,
                SortDirection = Model.SortDirection,
                EnableSearch = true,
                SearchValue = Model.Search,
                SearchPlaceholder = T["Search"] + " " + T["Approval Configs"],
                SearchButtonText = T["common.search"],
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreateApprovalConfig", "Sales"),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>

