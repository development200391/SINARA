@model ERP.Web.ViewModels.Sales.SalesApprovalConfigEditViewModel
@using ERP.Domain.Enums.Sales
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="DocumentType" class="form-label">@T["Document Type"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.DocumentType),
                    Id = Html.IdFor(x => x.DocumentType).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.DocumentType.ToString(),
                    Options = Enum.GetValues<SalesDocumentType>().Select(type => new SearchableSelectOptionViewModel
                    {
                        Value = type.ToString(),
                        Label = T[type.ToString()]
                    }).ToList()
                })
                <span asp-validation-for="DocumentType" class="text-danger"></span>
            </div>
            <div class="col-md-2">
                <label asp-for="Level" class="form-label">@T["Level"]</label>
                <input asp-for="Level" class="form-control" type="number" min="1" />
                <span asp-validation-for="Level" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="MinAmount" class="form-label">@T["Min Amount"]</label>
                <input asp-for="MinAmount" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="MinAmount" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="MaxAmount" class="form-label">@T["Max Amount"]</label>
                <input asp-for="MaxAmount" class="form-control" type="number" step="0.01" min="0" />
                <span asp-validation-for="MaxAmount" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="MaxDiscountPct" class="form-label">@T["Max Discount %"]</label>
                <input asp-for="MaxDiscountPct" class="form-control" type="number" step="0.01" min="0" max="100" />
                <span asp-validation-for="MaxDiscountPct" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ApproverRoleId" class="form-label">@T["Approver Role"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.ApproverRoleId),
                    Id = Html.IdFor(x => x.ApproverRoleId).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select Role"],
                    SelectedValue = Model.ApproverRoleId.HasValue
                        ? Model.ApproverRoleId.Value.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.RoleOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Name
                    }).ToList()
                })
            </div>
            <div class="col-md-5">
                <label asp-for="ApproverEmployeeId" class="form-label">@T["Approver Employee"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.ApproverEmployeeId),
                    Id = Html.IdFor(x => x.ApproverEmployeeId).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select Employee"],
                    SelectedValue = Model.ApproverEmployeeId.HasValue
                        ? Model.ApproverEmployeeId.Value.ToString(CultureInfo.InvariantCulture)
                        : null,
                    Options = Model.EmployeeOptions.Select(option => new SearchableSelectOptionViewModel
                    {
                        Value = option.Id.ToString(CultureInfo.InvariantCulture),
                        Label = option.Name
                    }).ToList()
                })
            </div>
            <div class="col-md-3">
                <label asp-for="TimeoutHours" class="form-label">@T["Timeout Hours"]</label>
                <input asp-for="TimeoutHours" class="form-control" type="number" min="1" />
                <span asp-validation-for="TimeoutHours" class="text-danger"></span>
            </div>
            <div class="col-md-4 d-flex align-items-center">
                <div class="mt-3">
                    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                    {
                        Name = nameof(Model.AutoApproveIfTimeout),
                        Id = Html.IdFor(x => x.AutoApproveIfTimeout).ToString(),
                        Label = T["Auto Approve if Timeout"],
                        Checked = Model.AutoApproveIfTimeout
                    })
                </div>
            </div>
            <div class="col-md-4 d-flex align-items-center">
                <div class="mt-3">
                    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                    {
                        Name = nameof(Model.IsActive),
                        Id = Html.IdFor(x => x.IsActive).ToString(),
                        Label = T["Active"],
                        Checked = Model.IsActive
                    })
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@T["common.save"]</button>
            <a asp-action="ApprovalConfigs" class="btn btn-outline-secondary">@T["common.back"]</a>
        </div>
    </div>
</div>
