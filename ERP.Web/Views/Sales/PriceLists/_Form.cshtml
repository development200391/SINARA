@model ERP.Web.ViewModels.Sales.SalesPriceListEditViewModel
@using ERP.Domain.Enums.Sales
@using ERP.Web.ViewModels.Shared

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label asp-for="Code" class="form-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="col-md-5">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Type" class="form-label"></label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.Type),
                    Id = Html.IdFor(x => x.Type).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.Type.ToString(),
                    Options = Enum.GetValues<PriceListType>().Select(type => new SearchableSelectOptionViewModel
                    {
                        Value = type.ToString(),
                        Label = T[type.ToString()]
                    }).ToList()
                })
            </div>
            <div class="col-md-3">
                <label asp-for="CurrencyCode" class="form-label">@T["Currency"]</label>
                @await Component.InvokeAsync("SearchableSelect", new SearchableSelectViewModel
                {
                    Name = nameof(Model.CurrencyCode),
                    Id = Html.IdFor(x => x.CurrencyCode).ToString(),
                    SearchPlaceholder = T["Search"],
                    EmptyOptionLabel = T["Select"],
                    SelectedValue = Model.CurrencyCode,
                    Options = Model.CurrencyOptions.Select(currency => new SearchableSelectOptionViewModel
                    {
                        Value = currency,
                        Label = currency
                    }).ToList()
                })
            </div>
            <div class="col-md-3">
                <label asp-for="ValidFrom" class="form-label"></label>
                <input asp-for="ValidFrom" class="form-control" type="date" />
                <span asp-validation-for="ValidFrom" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ValidTo" class="form-label"></label>
                <input asp-for="ValidTo" class="form-control" type="date" />
                <span asp-validation-for="ValidTo" class="text-danger"></span>
            </div>
            <div class="col-md-9">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-md-3 d-flex align-items-center">
                <div class="mt-4">
                    @await Component.InvokeAsync("FormCheckbox", new FormCheckboxViewModel
                    {
                        Name = nameof(Model.IsActive),
                        Id = Html.IdFor(x => x.IsActive).ToString(),
                        Label = T["Active"],
                        Checked = Model.IsActive
                    })
                </div>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">@T["common.save"]</button>
            <a asp-action="PriceLists" class="btn btn-outline-secondary">@T["common.back"]</a>
        </div>
    </div>
</div>
