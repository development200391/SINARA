@model ERP.Web.ViewModels.Sales.SalesPriceListDetailViewModel
@using ERP.Web.ViewModels.Shared
@using System.Globalization

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
            <div>
                <h1 class="h5 mb-1">@Model.PriceList.Code - @Model.PriceList.Name</h1>
                <div class="text-muted small">
                    @T["Type"]: @Model.PriceList.Type | @T["Currency"]: @Model.PriceList.CurrencyCode | @T["Valid"]: @Model.PriceList.ValidFrom.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) - @(Model.PriceList.ValidTo?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "-")
                </div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-sm btn-outline-secondary" asp-action="PriceLists">@T["common.back"]</a>
                <a class="btn btn-sm btn-primary" asp-action="EditPriceList" asp-route-id="@Model.PriceList.Id">@T["common.edit"]</a>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h2 class="h6 mb-3">@T["Price List Items"]</h2>

        @{
            var selectedItem = Model.ItemIdFilter?.ToString(CultureInfo.InvariantCulture);
            var selectedUom = Model.UomIdFilter?.ToString(CultureInfo.InvariantCulture);

            var itemOptions = Model.ItemOptions
                .Select(x => new PagedGridFilterOptionViewModel { Value = x.Id.ToString(CultureInfo.InvariantCulture), Label = x.Label })
                .ToList();

            var uomOptions = Model.UomOptions
                .Select(x => new PagedGridFilterOptionViewModel { Value = x.Id.ToString(CultureInfo.InvariantCulture), Label = x.Label })
                .ToList();

            var rows = Model.Items.Items.Select(item => new PagedGridRowViewModel
            {
                Cells =
                [
                    new PagedGridCellViewModel { Text = item.ItemCode },
                    new PagedGridCellViewModel { Text = item.ItemName },
                    new PagedGridCellViewModel { Text = item.UomCode },
                    new PagedGridCellViewModel { Text = item.MinQty.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.UnitPrice.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" },
                    new PagedGridCellViewModel { Text = item.DiscountPct.ToString("N2", CultureInfo.InvariantCulture), CellClass = "text-end" }
                ],
                Actions = new PagedGridRowActionViewModel
                {
                    EditUrl = Url.Action("EditPriceListItem", "Sales", new { priceListId = Model.PriceList.Id, id = item.Id }),
                    DeleteUrl = Url.Action("DeletePriceListItem", "Sales", new { priceListId = Model.PriceList.Id, id = item.Id }),
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            }).ToList();

            var routeValues = new Dictionary<string, string?>
            {
                ["id"] = Model.PriceList.Id.ToString(CultureInfo.InvariantCulture)
            };

            var gridModel = new PagedGridViewModel
            {
                Columns =
                [
                    new PagedGridColumnViewModel
                    {
                        Key = "itemcode",
                        Title = T["Item Code"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "itemId",
                            Value = selectedItem,
                            EmptyOptionLabel = T["All"],
                            Options = itemOptions
                        }
                    },
                    new PagedGridColumnViewModel { Key = "itemname", Title = T["Item Name"], Sortable = true },
                    new PagedGridColumnViewModel
                    {
                        Key = "uomcode",
                        Title = T["UoM"],
                        Sortable = true,
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.Select,
                            QueryKey = "uomId",
                            Value = selectedUom,
                            EmptyOptionLabel = T["All"],
                            Options = uomOptions
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "minqty",
                        Title = T["Min Qty"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "minQtyFrom",
                            QueryKeyTo = "minQtyTo",
                            Value = Model.MinQtyFromFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.MinQtyToFilter?.ToString(CultureInfo.InvariantCulture)
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "unitprice",
                        Title = T["Unit Price"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "unitPriceFrom",
                            QueryKeyTo = "unitPriceTo",
                            Value = Model.UnitPriceFromFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.UnitPriceToFilter?.ToString(CultureInfo.InvariantCulture)
                        }
                    },
                    new PagedGridColumnViewModel
                    {
                        Key = "discountpct",
                        Title = T["Discount %"],
                        Sortable = true,
                        CellClass = "text-end",
                        Filter = new PagedGridFilterViewModel
                        {
                            Type = PagedGridFilterType.NumberRange,
                            QueryKey = "discountPctFrom",
                            QueryKeyTo = "discountPctTo",
                            Value = Model.DiscountPctFromFilter?.ToString(CultureInfo.InvariantCulture),
                            ValueTo = Model.DiscountPctToFilter?.ToString(CultureInfo.InvariantCulture)
                        }
                    }
                ],
                Rows = rows,
                EmptyMessage = T["msg.no_data"],
                Page = Model.Items.Page,
                TotalPages = Model.Items.TotalPages,
                PageSize = Model.ItemPageSize,
                SortBy = Model.ItemSortBy,
                SortDirection = Model.ItemSortDirection,
                EnableSearch = true,
                SearchValue = Model.ItemSearch,
                SearchPlaceholder = T["Search"] + " " + T["Price List Items"],
                SearchButtonText = T["common.search"],
                RouteValues = routeValues,
                Actions = new PagedGridActionConfigViewModel
                {
                    ActionColumnTitle = T["Action"],
                    AddUrl = Url.Action("CreatePriceListItem", "Sales", new { priceListId = Model.PriceList.Id }),
                    AddButtonText = T["common.add_new"],
                    EditButtonText = T["common.edit"],
                    DeleteButtonText = T["common.delete"],
                    DeleteConfirmMessage = T["Delete this data?"]
                }
            };
        }

        @await Component.InvokeAsync("PagedGrid", gridModel)
    </div>
</div>
